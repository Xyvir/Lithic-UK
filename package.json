{
  "name": "lithic",
  "version": "1.0.0",
  "description": "Lithic: A TiddlyWiki-powered PKMS built on Tauri",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "mirror": "node scripts/mirror.js",
    "update-external": "node scripts/mirror.js",
    "vendor": "node scripts/vendor-libraries.mjs",
    "vendor:check": "node scripts/vendor-libraries.mjs --check",
    "test": "node --test scripts/test-pdf-import.mjs && node --test scripts/test-vendored-libraries.mjs && npm --prefix launcher-ui ci && npm --prefix launcher-ui test",
    "build:launcher": "npm --prefix launcher-ui ci && node scripts/build-launcher.mjs",
    "build:library": "node scripts/build-library.mjs",
    "test:launcher": "node scripts/launcher-smoke.mjs",
    "build:light": "node scripts/build-light.mjs",
    "test:puppeteer": "node scripts/test-puppeteer-launcher.mjs",
    "test:puppeteer:headed": "HEADED=1 node scripts/test-puppeteer-launcher.mjs",
    "test:firefox": "node scripts/test-firefox-launcher.mjs",
    "monkey:launcher": "node scripts/monkey-launcher.mjs",
    "probe:webview": "node scripts/probe-webview-globals.mjs",
    "monkey:launcher:headed": "HEADED=1 node scripts/monkey-launcher.mjs",
    "gallery": "node scripts/ui-gallery.mjs",
    "check:pdf-plugin": "node scripts/check-pdf-plugin-unminified.mjs",
    "test:pdf-artifact": "node scripts/test-pdf-import-artifact.mjs",
    "check:android-face": "node scripts/check-android-face.mjs",
    "check:offline": "node scripts/check-launcher-offline.mjs --browser",
    "check:copy": "node scripts/check-launcher-copy.mjs",
    "palette": "node scripts/write-launcher-palette.mjs",
    "contract": "node scripts/sync-contract.mjs",
    "patch:android": "node scripts/patch-android.mjs",
    "check:locale": "node scripts/check-self-host-locale.mjs",
    "check:push": "node scripts/sync-contract.mjs --check && node scripts/check-launcher-copy.mjs && node scripts/check-self-host-locale.mjs && node scripts/check-launcher-artifact.mjs && node scripts/check-launcher-offline.mjs --browser && node scripts/pre-push-check.mjs"
  },
  "author": "Tyler Mills",
  "license": "ISC",
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tiddlywiki": "^5.3.3",
    "puppeteer": "^24.0.0"
  }
}