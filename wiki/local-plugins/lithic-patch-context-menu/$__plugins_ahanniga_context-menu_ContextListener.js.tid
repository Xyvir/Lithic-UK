type: application/javascript
module-type: widget

/*\
title: $:/plugins/ahanniga/context-menu/ContextListener.js
type: application/javascript
module-type: widget

This widgets implements context menus to tiddlers
\*/

(function () {

    var sanitize = function (string) {
        if (!string) return "";
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#x27;',
            "/": '&#x2F;',
        };
        const reg = /[&<>"'/]/ig;
        return string.replace(reg, (match) => (map[match]));
    };

    var htmlToElement = function (html) {
        var template = document.createElement('template');
        template.innerHTML = html.trim();
        return template.content.firstChild;
    }

    var parseParameters = function (src) {
        let paramMatcher = /\\parameters\s*\((.*?)\)/;
        let paramMatch = src.match(paramMatcher);
        let parameters = {};
        if (paramMatch && paramMatch.length > 1) {
            paramMatch[1].split(",").forEach(pair => {
                let [key, value] = pair.split(":");
                if (key && value) {
                    parameters[key.trim()] = value.replace(/["']/g, "").trim();
                }
            });

            // Remove the \parameters block from the src
            src = src.replace(paramMatcher, '').trim();
        }

        Object.keys(parameters).forEach(param => {
            let re = new RegExp("<<" + param + ">>", "g");
            src = src.replace(re, parameters[param]);
        });

        return src;
    }

    var Widget = require("$:/core/modules/widgets/widget.js").widget;
    var template = `<div id="contextMenu" class="context-menu" style="display: none; z-index: 10000;"></div>`;

    var ContextListener = function (parseTreeNode, options) {
        this.initialise(parseTreeNode, options);
    };

    ContextListener.prototype = new Widget();

    ContextListener.prototype.render = function (parent, nextSibling) {
        this.parentDomNode = parent;
        var self = this;
        if (!ContextListener._listenerAttached) {
            ContextListener._contextMenuHandler = function (event) { self.contextmenu.call(self, event); };
            ContextListener._clickHandler = function () { self.hideMenu.call(self); };
            document.addEventListener("contextmenu", ContextListener._contextMenuHandler);
            document.addEventListener("click", ContextListener._clickHandler);
            ContextListener._listenerAttached = true;
        }
    };

    ContextListener.prototype.contextmenu = function (event) {
        var self = this;
        var menu = document.getElementById("contextMenu");
        
        console.log("[ContextListener] Raw Event clientX/Y:", event.clientX, event.clientY, "target:", event.target);

        if (getSelection().toString().trim().length > 0) {
            return true;
        }

        var isStreamNode = false;
        if (event.target.closest(".stream-node-handle")) {
            isStreamNode = true;
        }
        
        console.log("[ContextListener] isStreamNode:", isStreamNode);

        if (event.target && event.target.closest && event.target.closest(".tw-whiteboard-layout-container")) {
            return true;
        }

        if (event.target && event.target.closest && event.target.closest(".unieditor__textarea")) {
            return true;
        }

        if (menu == null) {
            this.document.body.appendChild(htmlToElement(template));
            menu = document.getElementById("contextMenu");
            menu.addEventListener("click", function (event) { self.menuClicked.call(self, event) });
        }
        menu.innerHTML = "";

        var menuHtml = ["<ul>"];
        var titles = isStreamNode ? $tw.wiki.getTiddlersWithTag("$:/tags/streams/contextmenu") : $tw.wiki.getTiddlersWithTag("$:/tags/tiddlercontextmenu");
        
        console.log("[ContextListener] Tag found length:", titles ? titles.length : 0);
        
        var label, action, icon, targ, text, separator, paramFilter, customParam;
        var closestTiddler = event.target.closest("[data-tiddler-title], [data-node-title]");

        var link = event.target.closest(".tc-tiddlylink");
        if (link) {
            var title = link.getAttribute("data-tiddler-title");
            if (!title && link.hasAttribute("href")) {
                var href = link.getAttribute("href");
                if (href.startsWith("#")) {
                    title = decodeURIComponent(href.substring(1));
                }
            }
            if (title) {
                targ = title;
            }
        }

        if (!targ) {
            if (closestTiddler) {
                targ = closestTiddler.getAttribute("data-node-title") || closestTiddler.getAttribute("data-tiddler-title");
            }
        }
        
        console.log("[ContextListener] Resolved targ:", targ);

        if (!targ) {
            console.log("[ContextListener] No target found, falling back to browser context menu");
            // HIDE the menu here to prevent ghost menus from previous clicks
            this.hideMenu();
            return true;
        }

        if (isStreamNode) {
            menuHtml.push(`<li><a action="streams-action-string" data-action-string="&lt;$action-navigate/&gt;" targ="${targ}" href="#!">Open</a></li>`);
            menuHtml.push(`<li><a action="streams-action-string" data-action-string="&lt;&lt;rename-node-actions&gt;&gt;" targ="${targ}" href="#!">Rename <span style="opacity:0.5; font-size:0.8em; margin-left:8px;">((streams-rename))</span></a></li>`);
            menuHtml.push(`<li class="menu-separator"></li>`);
        }

        var getFieldString = function(title, fieldName, defaultVal) {
            var val = $tw.wiki.filterTiddlers("[[" + title + "]get[" + fieldName + "]]")[0];
            if (val === undefined || val === null) {
                if (fieldName === "title") return title;
                if (fieldName === "text") {
                    var textVal = $tw.wiki.getTiddlerText(title);
                    if (textVal !== undefined && textVal !== null) return textVal;
                }
                var hasField = $tw.wiki.filterTiddlers("[[" + title + "]has[" + fieldName + "]]")[0];
                if (hasField) return "";
                return defaultVal;
            }
            return val;
        };

        var hasField = function(title, fieldName) {
            return $tw.wiki.filterTiddlers("[[" + title + "]has[" + fieldName + "]]").length > 0;
        };

        for (var a = 0; a < titles.length; a++) {
            var currentTitle = titles[a];
            text = sanitize(getFieldString(currentTitle, "text", "hide")).trim();

            if (!isStreamNode && text !== "show") {
                continue;
            }

            if (isStreamNode) {
                label = sanitize(getFieldString(currentTitle, "sq-contextmenu-name", currentTitle));
                action = "streams-action-string";
                var actionString = sanitize(getFieldString(currentTitle, "text", ""));
                var subtitle = sanitize(getFieldString(currentTitle, "sq-contextmenu-subtitle", ""));
                icon = "";
                separator = hasField(currentTitle, "separate-after") ? "menu-separator" : "";
                
                menuHtml.push(`<li class="${separator}"><a action="${action}" data-action-string="${actionString}" targ="${targ}" href="#!">${label} <span style="opacity:0.5; font-size:0.8em; margin-left:8px;">${subtitle}</span></a></li>`);
            } else {
                label = sanitize(getFieldString(currentTitle, "caption", "Unlabelled Option"));
                action = sanitize(getFieldString(currentTitle, "tm-message", "tm-dummy"));
                icon = $tw.wiki.getTiddlerText(getFieldString(currentTitle, "icon", "$:/core/images/blank"));
                if (icon) {
                    icon = parseParameters(icon);
                } else {
                    icon = "";
                }
                separator = hasField(currentTitle, "separate-after") ? "menu-separator" : "";

                paramFilter = getFieldString(currentTitle, "param-filter", "");
                customParam = "";
                if (paramFilter) {
                    var resolvedFilter = paramFilter.replace(/<currentTiddler>/g, "[" + targ + "]");
                    var iterator = function (callback) {
                        callback($tw.wiki.getTiddler(targ), targ);
                    };
                    var results = $tw.wiki.filterTiddlers(resolvedFilter, null, iterator);
                    if (results.length > 0) {
                        customParam = sanitize(results.join('\n'));
                    }
                }

                menuHtml.push(`<li class="${separator}"><a action="${action}" targ="${targ}" data-custom-param="${customParam}" href="#!">${icon} ${label}</a></li>`);
            }
        }

        menuHtml.push("</ul>");
        var finalHtml = menuHtml.join("");
        
        console.log("[ContextListener] finalHtml before fallback: ", finalHtml);
        
        if (finalHtml.indexOf("<li>") === -1) {
            finalHtml = "<ul><li><a href='#!' style='color:white; padding: 8px;'>No Options Found</a></li></ul>";
        }

        menu.innerHTML = finalHtml;

        var links = menu.querySelectorAll("a");
        for (var i = 0; i < links.length; i++) {
            links[i].style.color = "#c8ced8";
            links[i].style.display = "flex";
            links[i].style.justifyContent = "space-between";
            links[i].style.flexDirection = "row-reverse";
            links[i].style.alignItems = "center";
            links[i].style.textDecoration = "none";
        }

        // Clean up old highlights
        document.querySelectorAll(".lithic-context-menu-active, .lithic-context-menu-active-children").forEach(function (el) {
            el.classList.remove("lithic-context-menu-active", "lithic-context-menu-active-children");
        });

        if (link) {
            link.classList.add("lithic-context-menu-active");
        } else if (closestTiddler) {
            var droppable = closestTiddler.closest(".stream-droppable");
            if (droppable) {
                droppable.classList.add("lithic-context-menu-active");
                if (droppable.nextElementSibling && droppable.nextElementSibling.classList.contains("stream-row-children")) {
                    droppable.nextElementSibling.classList.add("lithic-context-menu-active-children");
                }
            } else {
                closestTiddler.classList.add("lithic-context-menu-active");
            }
        }

        // ALWAYS show and move the menu to the new location, even if it was already open!
        menu.style.display = 'block';
        
        var posX = (event.clientX !== undefined && event.clientX > 0) ? event.clientX : 100;
        var posY = (event.clientY !== undefined && event.clientY > 0) ? event.clientY : 100;
        
        console.log("[ContextListener] Final calculated coordinates:", posX, posY);
        
        menu.style.left = posX + "px";
        menu.style.top = posY + "px";

        event.preventDefault();
        return false;
    };

    ContextListener.prototype.menuClicked = function (event) {
        var targetStart = event.target;
        var targetAction = targetStart.closest("[action]");

        if (!targetAction) {
            return false;
        }

        var action = targetAction.getAttribute("action");
        var targ = targetAction.getAttribute("targ");
        var customParam = targetAction.getAttribute("data-custom-param");

        var stid, state, text, ptid;
        this.hideMenu();

        switch (action) {
            case "streams-action-string":
                var actionString = targetAction.getAttribute("data-action-string");
                if (actionString) {
                    var unescapeHtml = function(unsafe) {
                        return unsafe
                            .replace(/&amp;/g, "&")
                            .replace(/&lt;/g, "<")
                            .replace(/&gt;/g, ">")
                            .replace(/&quot;/g, '"')
                            .replace(/&#x27;/g, "'")
                            .replace(/&#x2F;/g, "/");
                    };
                    actionString = unescapeHtml(actionString);
                    this.invokeActionString(actionString, this, event, { currentTiddler: targ });
                }
                break;
            case "tm-fold-tiddler":
                stid = `$:/state/folded/${targ}`;
                state = $tw.wiki.getTiddlerText(stid, "show") === "show" ? "hide" : "show";
                $tw.wiki.setText(stid, "text", null, state);
                break;
            case "tm-copy-to-clipboard":
                if (customParam && customParam !== "") {
                    text = customParam;
                } else {
                    text = $tw.wiki.getTiddlerText(targ);
                }
                this.dispatchEvent({ type: action, param: text });
                break;
            case "tm-print":
                this.dispatchEvent({ type: action, event: event });
                break;
            case "lithic-copy-share-url":
                var exportData = [];
                var filter = "[[" + targ + "]] [[" + targ + "]get-stream-nodes[]]";
                var tiddlerTitles = $tw.wiki.filterTiddlers(filter);
                for (var t = 0; t < tiddlerTitles.length; t++) {
                    var tidObj = $tw.wiki.getTiddler(tiddlerTitles[t]);
                    if (tidObj) {
                        var isParent = (t === 0);
                        var newTags = (tidObj.fields.tags || []).slice();

                        if (isParent && newTags.indexOf("$:/tags/PayloadURL") < 0) {
                            newTags.push("$:/tags/PayloadURL");
                        }

                        var flattenedText = tidObj.fields.text || "";
                        if (flattenedText.indexOf("{{") !== -1) {
                            flattenedText = $tw.wiki.renderText("text/plain", "text/vnd.tiddlywiki", flattenedText, {
                                parseAsInline: false,
                                variables: { currentTiddler: tidObj.fields.title }
                            });
                        }

                        tidObj = new $tw.Tiddler(tidObj, {
                            tags: newTags,
                            text: flattenedText
                        });

                        var fields = {};
                        for (var field in tidObj.fields) {
                            fields[field] = tidObj.getFieldString(field);
                        }
                        exportData.push(fields);
                    }
                }
                var jsonPayload = JSON.stringify(exportData);
                var encodedPayload = btoa(unescape(encodeURIComponent(jsonPayload)));
                var shareUrl = "https://lithic.uk/?json=" + encodedPayload;

                var linkText = targ + " on Lithic.uk";
                var htmlContent = '<a href="' + shareUrl + '">' + linkText + '</a>';
                var plainContent = shareUrl;

                if (navigator.clipboard && window.ClipboardItem) {
                    var htmlBlob = new Blob([htmlContent], { type: "text/html" });
                    var plainBlob = new Blob([plainContent], { type: "text/plain" });
                    var item = new ClipboardItem({
                        "text/html": htmlBlob,
                        "text/plain": plainBlob
                    });

                    var widgetNode = this;
                    navigator.clipboard.write([item]).then(function () {
                        if (shareUrl.length > 2000) {
                            var alertTitle = "$:/temp/alerts/ShareUrlTooLong";
                            var warningText = "Warning: Share URL is " + shareUrl.length + " chars. ";
                            if (shareUrl.length > 8192) {
                                warningText += "It exceeds 8KB and WILL be rejected by most web servers (414 URI Too Long).";
                            } else {
                                warningText += "It exceeds 2KB and may be truncated by chat apps like Discord.";
                            }

                            $tw.wiki.addTiddler({
                                title: alertTitle,
                                text: warningText,
                                component: "Lithic Share"
                            });
                            widgetNode.dispatchEvent({ type: "tm-notify", param: alertTitle });
                        } else {
                            widgetNode.dispatchEvent({ type: "tm-notify", param: "$:/core/ui/Notifications/CopiedToClipboard" });
                        }
                    }).catch(function (err) {
                        widgetNode.dispatchEvent({ type: "tm-copy-to-clipboard", param: plainContent });
                    });
                } else {
                    this.dispatchEvent({ type: "tm-copy-to-clipboard", param: plainContent });
                }
                break;
            case "tm-unfold-all-tiddlers":
                this.dispatchEvent({ type: action, param: targ, foldedStatePrefix: "$:/state/folded/" });
                break;
            case "sp-print-river":
                var curEntries = [];
                ptid = $tw.wiki.getTiddler("$:/PrintList");
                if (ptid !== undefined) {
                    var list = ptid.getFieldList("list");
                    if (Array.isArray(list) && list.indexOf(targ) < 0) {
                        for (var a = 0; a < list.length; a++) {
                            curEntries.push(list[a]);
                        }
                    }
                }
                curEntries.push(targ);
                $tw.wiki.setText("$:/PrintList", "list", 0, curEntries);
                $tw.rootWidget.dispatchEvent({ type: 'tm-open-window', param: '$:/plugins/BTC/PrintRiver/ui/Templates/PrintRiver' });
                break;
            case "tm-new-here":
                this.dispatchEvent({ type: "tm-new-tiddler", paramObject: { tags: targ } });
                break;
            default:
                this.dispatchEvent({ type: action, param: targ });
        }

        event.preventDefault();
        return false;
    };

    ContextListener.prototype.refresh = function (changedTiddlers) {
        return false;
    };

    ContextListener.prototype.hideMenu = function () {
        var menu = document.getElementById("contextMenu");
        if (menu != null) {
            menu.style.display = "none";
        }
        document.querySelectorAll(".lithic-context-menu-active, .lithic-context-menu-active-children").forEach(function (el) {
            el.classList.remove("lithic-context-menu-active", "lithic-context-menu-active-children");
        });
    };

    exports.contextMenu = ContextListener;

})();