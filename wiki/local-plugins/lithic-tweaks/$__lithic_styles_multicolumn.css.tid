title: $:/lithic/styles/multicolumn.css
tags: $:/tags/Stylesheet
type: text/css

/* Original Developer: Brian Radspinner */

.br-txt-col > *:first-child { margin: 0; }

.br-txt-col.all-break p { break-inside: auto; }

.br-txt-col:not(.all-break) p { break-inside: avoid; }

/* Double hr acts as forced column break */
.br-txt-col hr:has(+ hr) {
    display: none;
}

.br-txt-col hr + hr {
    break-before: column;
    border: none;
    margin: 0;
    height: 0;
}

/* Force single-column on mobile screens */
@media screen and (max-width: 768px) {
    .br-txt-col {
        column-count: 1 !important;
        column-rule: none !important;
    }
}
