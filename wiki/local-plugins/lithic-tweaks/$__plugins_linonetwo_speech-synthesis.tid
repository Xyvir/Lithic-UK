{"tiddlers": {"$:/plugins/linonetwo/speech-synthesis/widget.js": {"title": "$:/plugins/linonetwo/speech-synthesis/widget.js", "text": "\"use strict\";\n\nvar import_widget = require(\"$:/core/modules/widgets/widget.js\");\n\nvar SpeechSynthesisWidget = class extends import_widget.widget {\n  refresh(e) {\n    return $tw.utils.count(this.computeAttributes()) > 0 ? (this.refreshSelf(), !0) : this.refreshChildren(e);\n  }\n  \n  render(e, t) {\n    this.parentDomNode = e;\n    this.computeAttributes();\n    this.execute();\n    this.renderChildren(e, t);\n  }\n  \n  setState(state) {\n    $tw.wiki.addTiddler(new $tw.Tiddler({ title: \"$:/state/speech-synthesis\", text: state }));\n  }\n  \n  invokeAction(e, t) {\n    const action = this.getAttribute(\"action\", \"speak\");\n    if (action === \"pause\") {\n      window.speechSynthesis.pause();\n      this.setState(\"paused\");\n    } else if (action === \"resume\") {\n      window.speechSynthesis.resume();\n      this.setState(\"playing\");\n    } else if (action === \"stop\") {\n      window.speechSynthesis.cancel();\n      this.setState(\"stopped\");\n    } else if (action === \"toggle\") {\n      if (window.speechSynthesis.speaking) {\n        if (window.speechSynthesis.paused) {\n          window.speechSynthesis.resume();\n          this.setState(\"playing\");\n        } else {\n          window.speechSynthesis.pause();\n          this.setState(\"paused\");\n        }\n      } else {\n        const s = this.getAttribute(\"text\");\n        s && this.speak(s);\n      }\n    } else {\n      window.speechSynthesis.cancel();\n      const s = this.getAttribute(\"text\");\n      s && this.speak(s);\n    }\n  }\n  \n  speak(e) {\n    // Media session hook\n    this.setupMediaSession();\n    \n    // Fallback: If utterance text is very long, some browsers break. We just pass 'e' for now.\n    const t = new SpeechSynthesisUtterance(e);\n    \n    // Only set voice if it's available, otherwise fallback to default\n    const voices = window.speechSynthesis.getVoices();\n    if (voices && voices.length > 0) {\n      // Find a reasonable default voice or just let it use the system default if we don't set it.\n      // Often setting it to voices[0] can pick a weird voice or a silent/offline one.\n      // Actually, it's safer to NOT set t.voice and let the browser pick its default, \n      // unless we explicitly want to configure a specific voice.\n      // t.voice = voices[0];\n    }\n    \n    t.onstart = () => {\n      this.setState(\"playing\");\n      if (navigator.mediaSession) navigator.mediaSession.playbackState = \"playing\";\n    };\n    t.onpause = () => {\n      this.setState(\"paused\");\n      if (navigator.mediaSession) navigator.mediaSession.playbackState = \"paused\";\n    };\n    t.onresume = () => {\n      this.setState(\"playing\");\n      if (navigator.mediaSession) navigator.mediaSession.playbackState = \"playing\";\n    };\n    t.onend = () => {\n      this.setState(\"stopped\");\n      if (navigator.mediaSession) navigator.mediaSession.playbackState = \"none\";\n      this.cleanupMediaSession();\n    };\n    t.onerror = (evt) => {\n      console.error(\"SpeechSynthesis error\", evt);\n      this.setState(\"stopped\");\n      if (navigator.mediaSession) navigator.mediaSession.playbackState = \"none\";\n      this.cleanupMediaSession();\n    };\n    window.speechSynthesis.speak(t);\n  }\n\n  setupMediaSession() {\n    if ('mediaSession' in navigator) {\n      // We need a dummy audio file to trigger media session on mobile\n      if (!this.dummyAudio) {\n        // A short silent audio clip (base64)\n        this.dummyAudio = new Audio(\"data:audio/wav;base64,UklGRigAAABXQVZFZm10IBIAAAABAAEARKwAAIhYAQACABAAAABkYXRhAgAAAAEA\");\n        this.dummyAudio.loop = true;\n      }\n      this.dummyAudio.play().catch(e => console.log(\"Dummy audio play failed\", e));\n      \n      navigator.mediaSession.setActionHandler('play', () => {\n        window.speechSynthesis.resume();\n        this.setState(\"playing\");\n        navigator.mediaSession.playbackState = \"playing\";\n      });\n      \n      navigator.mediaSession.setActionHandler('pause', () => {\n        window.speechSynthesis.pause();\n        this.setState(\"paused\");\n        navigator.mediaSession.playbackState = \"paused\";\n      });\n      \n      navigator.mediaSession.setActionHandler('stop', () => {\n        window.speechSynthesis.cancel();\n        this.setState(\"stopped\");\n        navigator.mediaSession.playbackState = \"none\";\n        this.cleanupMediaSession();\n      });\n    }\n  }\n  \n  cleanupMediaSession() {\n    if (this.dummyAudio) {\n      this.dummyAudio.pause();\n      this.dummyAudio.currentTime = 0;\n    }\n  }\n};\nexports[\"speech-synthesis\"] = SpeechSynthesisWidget;", "creator": "LinOnetwo", "type": "application/javascript", "module-type": "widget", "hide-body": "yes"}, "$:/plugins/linonetwo/speech-synthesis/readme": {"title": "$:/plugins/linonetwo/speech-synthesis/readme", "creator": "LinOnetwo", "type": "text/vnd.tiddlywiki", "text": "\\define text-to-speak() Hello World\n\n<$button>\n  Speak Hello World\n  <$speech-synthesis text=<<text-to-speak>> />\n</$button>\n\nIt works completely offline.\n\n!! Usage\n\n```tw5\n\\define text-to-speak() Hello World\n\n<$button>\n  Speak Hello World\n  <$speech-synthesis text=<<text-to-speak>> />\n</$button>\n\nOr\n\n<$button>\n  Speak Hello World\n  <$speech-synthesis text=\"Hello World\" />\n</$button>\n```\n\n!!! With ChatGPT plugin\n\nInstall [[ChatGPT plugin (talk forum)|https://talk.tiddlywiki.org/t/chatgpt-for-tiddlywiki/6411]], and use output in `<<output-text>>` variable.\n\n```tw5\n<$chat-gpt system_message=\"You are a counselor who likes to quote scripture, using various quotes from famous people to encourage me to go to bed early and not stay up late, encouraging me to leave the electronic device immediately and try to sleep in various ways\">\n\t<$speech-synthesis text=<<output-text>> />\n</$chat-gpt>\n```\n\n!! Browser support\n\nChrome 33+ / Firefox 44+\n\n[[https://developer.mozilla.org/en-US/docs/Web/API/Web_Speech_API/Using_the_Web_Speech_API#browser_support_2]]"}}}
