creator: wilk
modifier: wilk
tags: $:/tags/Stylesheet
title: $:/wilk/css/CopyCodeButton

div.wilk-copy-code-button {
	position: relative;
}
div.wilk-copy-code-button > button.tc-btn-invisible {
	position: absolute;
	right: 0;
	padding: 0.1em 0.2em;
	fill: <<colour tiddler-controls-foreground>>;
}
div.wilk-copy-code-button > button.tc-btn-invisible:hover {
	fill: <<colour tiddler-controls-foreground-hover>>;
}

div.wilk-copy-code-button > button.run-jspython-btn {
	position: absolute;
	right: 1.8em;
	padding: 0.1em 0.2em;
	fill: <<colour tiddler-controls-foreground>>;
	color: <<colour tiddler-controls-foreground>>;
	font-weight: bold;
}

div.wilk-copy-code-button > button.run-jspython-btn:hover {
	fill: <<colour tiddler-controls-foreground-hover>>;
	color: <<colour tiddler-controls-foreground-hover>>;
}