"use strict";

var import_widget = require("$:/core/modules/widgets/widget.js");

var SpeechSynthesisWidget = class extends import_widget.widget {
  refresh(e) {
    return $tw.utils.count(this.computeAttributes()) > 0 ? (this.refreshSelf(), !0) : this.refreshChildren(e);
  }
  
  render(e, t) {
    this.parentDomNode = e;
    this.computeAttributes();
    this.execute();
    this.renderChildren(e, t);
  }
  
  setState(state) {
    $tw.wiki.addTiddler(new $tw.Tiddler({ title: "$:/state/speech-synthesis", text: state }));
  }
  
  invokeAction(e, t) {
    const action = this.getAttribute("action", "speak");
    if (action === "pause") {
      window.speechSynthesis.pause();
      this.setState("paused");
    } else if (action === "resume") {
      window.speechSynthesis.resume();
      this.setState("playing");
    } else if (action === "stop") {
      window.speechSynthesis.cancel();
      this.setState("stopped");
    } else if (action === "toggle") {
      if (window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
        this.setState("stopped");
      } else {
        const s = this.getAttribute("text");
        s && this.speak(s);
      }
    } else {
      window.speechSynthesis.cancel();
      const s = this.getAttribute("text");
      s && this.speak(s);
    }
  }
  
  speak(e) {
    window.speechSynthesis.cancel();
    
    const maxChunkLength = 200;
    const chunks = [];
    
    // Split text by common punctuation/newlines, keeping the punctuation attached to the clause
    const clauses = e.match(/[^,.\?!;\n]+[,.\?!;\n]*/g) || [e];
    
    let currentChunk = "";
    
    for (let i = 0; i < clauses.length; i++) {
      let clause = clauses[i].trim();
      if (!clause) continue;
      
      // If adding the next clause exceeds the safe limit, push current to queue and start fresh
      if ((currentChunk + " " + clause).length > maxChunkLength) {
        if (currentChunk) {
          chunks.push(currentChunk.trim());
          currentChunk = "";
        }
        
        // Fallback: If a single clause without punctuation is STILL too huge, split it by words
        if (clause.length > maxChunkLength) {
          const words = clause.split(' ');
          for (let j = 0; j < words.length; j++) {
            if ((currentChunk + " " + words[j]).length > maxChunkLength && currentChunk) {
              chunks.push(currentChunk.trim());
              currentChunk = words[j];
            } else {
              currentChunk += (currentChunk ? " " : "") + words[j];
            }
          }
        } else {
          currentChunk = clause;
        }
      } else {
        currentChunk += (currentChunk ? " " : "") + clause;
      }
    }
    
    if (currentChunk.trim().length > 0) {
      chunks.push(currentChunk.trim());
    }

    let chunksPlayed = 0;

    chunks.forEach((chunk, index) => {
      const t = new SpeechSynthesisUtterance(chunk);
      
      if (index === 0) {
        t.onstart = () => this.setState("playing");
      }
      
      t.onpause = () => this.setState("paused");
      t.onresume = () => this.setState("playing");
      
      t.onerror = (evt) => {
        console.error("SpeechSynthesis error on chunk", evt);
        this.setState("stopped");
      };
      
      t.onend = () => {
        chunksPlayed++;
        if (chunksPlayed === chunks.length) {
          this.setState("stopped");
        }
      };
      
      window.speechSynthesis.speak(t);
    });
  }
};
exports["speech-synthesis"] = SpeechSynthesisWidget;
