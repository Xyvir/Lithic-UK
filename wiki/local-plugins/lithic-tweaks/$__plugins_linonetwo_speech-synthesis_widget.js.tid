"use strict";

var import_widget = require("$:/core/modules/widgets/widget.js");

var SpeechSynthesisWidget = class extends import_widget.widget {
  refresh(e) {
    return $tw.utils.count(this.computeAttributes()) > 0 ? (this.refreshSelf(), !0) : this.refreshChildren(e);
  }
  
  render(e, t) {
    this.parentDomNode = e;
    this.computeAttributes();
    this.execute();
    this.renderChildren(e, t);
  }
  
  setState(state) {
    $tw.wiki.addTiddler(new $tw.Tiddler({ title: "$:/state/speech-synthesis", text: state }));
  }
  
  invokeAction(e, t) {
    const action = this.getAttribute("action", "speak");
    if (action === "pause") {
      window.speechSynthesis.pause();
      this.setState("paused");
    } else if (action === "resume") {
      window.speechSynthesis.resume();
      this.setState("playing");
    } else if (action === "stop") {
      window.speechSynthesis.cancel();
      this.setState("stopped");
    } else if (action === "toggle") {
      if (window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
        this.setState("stopped");
      } else {
        const s = this.getAttribute("text");
        s && this.speak(s);
      }
    } else {
      window.speechSynthesis.cancel();
      const s = this.getAttribute("text");
      s && this.speak(s);
    }
  }
  
  speak(e) {
    
    // Fallback: If utterance text is very long, some browsers break. We just pass 'e' for now.
    const t = new SpeechSynthesisUtterance(e);
    
    // Only set voice if it's available, otherwise fallback to default
    const voices = window.speechSynthesis.getVoices();
    if (voices && voices.length > 0) {
      // Find a reasonable default voice or just let it use the system default if we don't set it.
      // Often setting it to voices[0] can pick a weird voice or a silent/offline one.
      // Actually, it's safer to NOT set t.voice and let the browser pick its default, 
      // unless we explicitly want to configure a specific voice.
      // t.voice = voices[0];
    }
    
    t.onstart = () => {
      this.setState("playing");
    };
    t.onpause = () => {
      this.setState("paused");
    };
    t.onresume = () => {
      this.setState("playing");
    };
    t.onend = () => {
      this.setState("stopped");
    };
    t.onerror = (evt) => {
      console.error("SpeechSynthesis error", evt);
      this.setState("stopped");
    };
    window.speechSynthesis.speak(t);
  }
};
exports["speech-synthesis"] = SpeechSynthesisWidget;
