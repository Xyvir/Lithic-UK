caption: Anchor Toggle
description: Toggle anchors on top-level nodes
icon: $:/lithic/images/anchor
tags: $:/tags/ViewToolbar
title: $:/lithic/ui/buttons/anchor-toggle
type: 

\whitespace trim
<$list filter="[<currentTiddler>!tag[Journal]get[stream-list]enlist-input[]has[text]first[]]" variable="representativeNode">
    <$vars anchor-string="{{||$:/anchor}}" lb={{{ [charcode[10]] }}} hr="---">
    <$vars anchor-prefix={{{ [<anchor-string>addsuffix<lb>] }}} hardbreak={{{ [<hr>addsuffix<lb>addsuffix<hr>] }}}>
    <$vars rep-first={{{ [<representativeNode>get[text]split<hardbreak>first[]] }}}>
    <$vars rep-replaced={{{ [<rep-first>search-replace:g<anchor-string>,[]] }}}>
        <$list filter="[<rep-first>!match<rep-replaced>]" variable="isAnchored" emptyMessage="""<$button tooltip="Drop Anchors" aria-label="Drop Anchors" class=<<tv-config-toolbar-class>> style="border: none; padding: 0; background: none;"><$list filter="[enlist{!!stream-list}has[text]]" variable="node"><$vars node-first={{{ [<node>get[text]split<hardbreak>first[]] }}} node-replaced={{{ [<node>get[text]split<hardbreak>first[]search-replace:g<anchor-string>,[]] }}}><$list filter="[<node-first>match<node-replaced>]" variable="ignore"><$action-setfield $tiddler=<<node>> text={{{ [<node>get[text]addprefix<anchor-prefix>] }}} /></$list></$vars></$list>{{$:/lithic/images/anchor}}</$button>""">     
            <$button tooltip="Hoist Anchors" aria-label="Hoist Anchors" class=<<tv-config-toolbar-class>>>                
                <$list filter="[enlist{!!stream-list}has[text]]" variable="node">
                    <$vars node-first={{{ [<node>get[text]split<hardbreak>first[]] }}} node-replaced={{{ [<node>get[text]split<hardbreak>first[]search-replace:g<anchor-string>,[]] }}}>
                        <$list filter="[<node-first>!match<node-replaced>]" variable="ignore">
                            <$action-setfield $tiddler=<<node>> text={{{ [<node>get[text]split<hardbreak>first[]search-replace:g<anchor-prefix>,[]search-replace:g<anchor-string>,[]] ~[[__EMPTY__]] [<node>get[text]split<hardbreak>rest[]] +[join<hardbreak>] +[search-replace:g[__EMPTY__],[]] }}} />
                        </$list>
                    </$vars>
                </$list>               
                {{$:/lithic/images/anchor}}               
            </$button>          
        </$list>
    </$vars>
    </$vars>
    </$vars>
    </$vars>
</$list>