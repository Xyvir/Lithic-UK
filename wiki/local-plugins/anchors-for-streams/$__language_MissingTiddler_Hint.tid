title: $:/language/MissingTiddler/Hint

//This is a placeholder due to a hanging link. Press //"+"// below to add content.//

<$vars anchor-templates="[!is[system]!is[shadow]has[stream-list]!has[cloned-from]] :filter[get[stream-list]enlist-input[]search:text[{{||$:/anchor}}]first[]]">
<$list filter=<<anchor-templates>> limit[1] variable="__anchorTemplate" emptyMessage="">
<div style="margin-top: 1.5em; padding: 0.75em; border: 1px dashed <<colour table-border>>; border-radius: 6px; display: inline-block; background: <<colour page-background>>;">
    <div style="font-size: 0.8em; color: <<colour muted-foreground>>; margin-bottom: 0.5em;">Or Initialize from Anchor Template:</div>
    <$vars selectState=<<qualify "$:/state/clone-template">>>
        <$select tiddler=<<selectState>> default="" class="lithic-anchor-tpl-select">
            <option value="">-- Select a template --</option>
            <$list filter=<<anchor-templates>>>
                <option value=<<currentTiddler>>><$text text=<<currentTiddler>>/></option>
            </$list>
        </$select>
        <$list filter="[<selectState>get[text]!is[blank]]" variable="selectedTemplate">
            <$button style="margin-left: 6px; padding: 2px 10px; cursor: pointer;">
                ✓ Clone
                <$action-setfield $tiddler=<<currentTiddler>> text={{{ [<selectedTemplate>get[text]] }}} stream-list={{{ [<selectedTemplate>get[stream-list]] }}} stream-type={{{ [<selectedTemplate>get[stream-type]] }}} cloned-from=<<selectedTemplate>> />
                <$action-deletetiddler $tiddler=<<selectState>> />
            </$button>
        </$list>
    </$vars>
</div>
</$list>
</$vars>
