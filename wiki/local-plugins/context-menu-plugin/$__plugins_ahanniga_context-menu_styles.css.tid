title: $:/plugins/ahanniga/context-menu/styles.css
type: text/css
tags: $:/tags/Stylesheet

/* Menu colours from the lithic contrast core (--lithic-c-menu-*): items,
   icons and hover pairs are WCAG-checked against the live palette, so the
   menu is readable on light and dark palettes alike. */

.context-menu {
	position: fixed;
	min-width: 180px;
	max-width: 240px;
	z-index: 10000;
	display: flex;
	flex-direction: column;
	background-color: var(--lithic-c-menu-bg);
	border-radius: 6px;
	box-shadow: rgba(0, 0, 0, 0.40) 0px 2px 20px;
	padding: 12px 0;
	border: 1px solid var(--lithic-c-menu-border);
	font-family: "Segoe UI", Roboto, Helvetica, Arial;
	font-size: 13px;
	margin-top: 4px;
}

.context-menu > ul {
	list-style: none;
	padding: 0;
	margin: 0;
}

.context-menu > ul > li > a {
	font: inherit;
	border: 0;
	padding: 4px 18px;
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: space-between;
	flex-direction: row-reverse;
	position: relative;
	text-decoration: unset;
	color: var(--lithic-c-menu-fg) !important;
	fill: var(--lithic-c-menu-fg) !important;
	line-height: 24px;
	font-weight: normal;
	transition: none;
	cursor: default;
}

.context-menu > ul > li > a:hover {
	background: var(--lithic-c-menu-hover-bg);
	color: var(--lithic-c-menu-hover-fg);
	fill: var(--lithic-c-menu-hover-fg);
}

.context-menu > ul > li > a:hover > svg {
	color: var(--lithic-c-menu-hover-fg);
	fill: var(--lithic-c-menu-hover-fg);
}

.context-menu > ul > li > a > i {
	padding-left: 10px;
}

.context-menu > ul > li > a > svg {
	color: var(--lithic-c-menu-muted) !important;
	fill: var(--lithic-c-menu-muted) !important;
	width: 13px;
	margin-left: 16px;
	margin-right: 0;
	height: 13px;
}

ul .menu-separator {
	border-bottom: 1px solid var(--lithic-c-menu-border);
	margin-bottom: 6px;
	margin-top: 6px;
	padding-bottom: 0;
}

/* The menu is promoted into the browser's top layer (popover="manual" on #contextMenu, set
   in ContextListener.js), so nothing on the page can be drawn over it, whatever z-index it
   uses. Only the parts of a popover's UA box that the rule above does not already override
   are reset here; the menu's own chrome comes from .context-menu. */
#contextMenu[popover] {
	inset: auto;
	margin: 0;
	overflow: visible;
}

/* The menu pops in the way every other drop-down in Lithic does. The Notebook theme
   animates .tc-drop-down on its own, which is why the streams node menu already fades
   in, but this menu is its own element (#contextMenu, classed .context-menu) and never
   matches that selector, so the same frames are declared here. The keyframes name is
   local so the menu does not depend on the theme in use, and it uses the theme's exact
   stopping points (0.8, a 1.03 overshoot, settle at 1) so the two menus feel the same.
   Forwards is deliberately omitted: a lingering transform would leave a stacking
   context on an element the popover already lifts above the page, and the settled
   scale(1) is what the menu looks like without any transform at all. The animation
   replays on every open because closeMenu sets display: none, which restarts it. */
@keyframes lithic-context-menu-pop {
	0% {
		transform: scale(0.8);
		opacity: 0;
	}

	80% {
		transform: scale(1.03);
		opacity: 1;
	}

	100% {
		transform: scale(1);
		opacity: 1;
	}
}

#contextMenu {
	animation: lithic-context-menu-pop 0.15s ease-in;
}

/* Context Menu Highlight Patch - applies when right-clicking a stream node or link.
   Palette-aware and live: the notify-bg/-fg contrast roles are derived from the SAME
   palette fields as the streams patch's own highlight band
   ($:/lithic/streams/styles/ctx-preview), so the two can never drift -- on the
   notebook dark palette that is the green band. Static fallbacks live in
   lithic-core/lithic-contrast.css. Do NOT hardcode these, and do NOT swap in the
   contrast hover pair (that drift is what turned the band purple). */
.lithic-context-menu-active,
.lithic-context-menu-active-children {
	background: var(--lithic-c-notify-bg) !important;
	color: var(--lithic-c-notify-fg) !important;
	border-radius: 4px;
}