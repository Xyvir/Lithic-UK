title: $:/plugins/lithic/lithic-import-handler/pdf-open-request.js
type: application/javascript
module-type: startup

/*\
title: $:/plugins/lithic/lithic-import-handler/pdf-open-request.js
type: application/javascript
module-type: startup

Opens the file the desktop app was handed when it is not a document this wiki edits: a PDF's
pages, or an image, each as a new Lith when none sits beside the file, and as the board of the
Lith that does.

The launcher cannot render a PDF, because the renderer lives in this wiki, so it reads the
file's bytes, hands them over on the window, and mounts the new Lith. This module takes that
payload and calls the same converter a dropped PDF goes through, then shows the whiteboard
full screen. A drop and a double-click therefore produce the same tiddlers from the same code.

Nothing is saved here. Opening a PDF to read it is a view, and a Lith that appeared beside
every file that was looked at is the clutter this avoids: the save the person presses is what
creates the sibling, at the name the launcher already named it (see `importIntoNewLith`).

The other shape is a PDF that has already become a Lith, which the launcher opens as it
stands: importing again would replace everything written in that copy since it was made.
There are no bytes to hand over in that case, only the container the import named after the
file, because the gesture is still `open the PDF` and what a double-click on a PDF means is
the board laid over its pages rather than whatever layout that Lith happened to be saved in.
A Lith opened on its own carries no request and keeps what it says.

An image is the same gesture with a different converter. The launcher reads the picture's
bytes and hands them over on the window; this module draws them on a board and opens it, so a
double-click on a photograph is the same outcome as a double-click on a PDF: a canvas to write
on, laid over the thing you opened rather than beside it in the river.

A book is that gesture with the chapters as the answer. The launcher hands over the EPUB's
bytes, this module splits it into a chapter per spine document and opens the first one, and the
chapters are Favorites in reading order so the sidebar is how a person reads on. The river holds
one chapter rather than a whole book, which is the same reason a PDF opens as a board.

A Word document is the same handoff with the words as the answer: the bytes travel because the
launcher cannot unpack a `.docx`, the converter turns them into a container holding the words
and the pictures, and the river holds the words. The board is one step away rather than in
front, because a document is what a person opened.

A gesture dropped on the launcher arrives as a list on one property rather than one file on one
of them, because the panel holds the files until the person chooses a document to import them
into. The list says which of the two the mount is: a Lith started from the gesture opens the
board it just drew, the way a double-click does, and a Lith the person was already reading keeps
its view while the engine's own import list names what arrived. Every kind here travels the same
way, so a book or a Word document queued beside the pages is still the document it is.
\*/
(function(){

/*jslint node: true, browser: true */
/*global $tw: false */
"use strict";

exports.name = "import-handler-open-request";
exports.platforms = ["browser"];
// The converter itself is published by `pdf-drop-handler.js`, and this names it so the two
// are read in a known order rather than whichever the boot happened to reach first.
exports.after = ["import-handler"];
exports.synchronous = true;

// The launcher's half of the handoff. A window property rather than a tiddler, because the
// payload is a whole PDF and the store is not a place to carry one; it survives the
// document.open/write boot for the same reason the file handle does.
var REQUEST_GLOBAL = "__LITHIC_PDF_IMPORT__";

// The same window, when the PDF already became a Lith. One gesture is one of these two and
// never both, so this is read only when there are no bytes to convert, and it names the
// container the import wrote rather than any board, because the wiki is what knows how a
// container and its board are related.
var BOARD_REQUEST = "__LITHIC_OPEN_BOARD__";

// Where the full screen board lives, and the state that says which board it shows. These are
// the four tiddlers `$:/lithic/buttons/FullscreenWhiteboard` sets, so a PDF opened by the
// desktop app lands where the button lands rather than inventing a second way in.
var WHITEBOARD_LAYOUT = "$:/plugins/linonetwo/tw-whiteboard/tiddlywiki-ui/PageLayout/WhiteBoard";
var BOARD_STATE = "$:/state/Whiteboard/PageLayout/tiddler";
// The document type a board is, which is also how the layout finds the boards to offer.
var BOARD_TYPE = "application/tldr";

// The launcher's half of the second handoff: an image rather than a PDF. One gesture is one of
// the two and never both, so each is read only when the other is absent.
var IMAGE_REQUEST = "__LITHIC_IMAGE_IMPORT__";

// The third handoff, and the same shape: an EPUB rather than a PDF. It is a book rather than a
// page, so what opens is its first chapter, and the whole book is the chapter list rather than
// one river.
var EPUB_REQUEST = "__LITHIC_EPUB_IMPORT__";

// The fourth handoff, for the last file this app converts rather than edits: a Word document.
// The launcher cannot unpack a `.docx` (a zip of XML, and the reader for it lives in this wiki),
// so it reads the bytes and hands them over, and what opens is the document's own words.
var DOCX_REQUEST = "__LITHIC_DOCX_IMPORT__";

// The handoff for a gesture that carried several of them at once: files dropped on the launcher
// together. Entries keep the order they arrived in, which is the order of the pages, and each
// carries its own name so the kind is read from the file rather than from a property beside it
// that could come to disagree with it.
var FILES_REQUEST = "__LITHIC_IMPORT_FILES__";

// What each registered extension is, as the type a data URL has to declare for the browser's own
// decoder to read the bytes. `jpg` and `jpeg` are one format under the two spellings it has.
var IMAGE_MIME = {
    png: "image/png",
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    bmp: "image/bmp",
    webp: "image/webp"
};

/**
 * An image's bytes as something an `<img>` will read.
 *
 * A data URL rather than an object URL: this is read once, during a boot, and the page replaces
 * itself by the end of it, so an address there is nothing to revoke afterwards.
 */
function dataUrlOf(filename, base64) {
    var match = /\.([^.]+)$/.exec(String(filename));
    var mime = match ? IMAGE_MIME[match[1].toLowerCase()] : "";
    return "data:" + (mime || "application/octet-stream") + ";base64," + base64;
}

// The one alert both converters use. The page is otherwise blank between the mount and the
// board, and a large image or a long PDF takes long enough that saying so is the difference
// between working and looking broken.
var PROGRESS_TITLE = "$:/temp/alerts/lithic-import-progress";
function setProgress(message) {
    $tw.wiki.addTiddler(new $tw.Tiddler({
        title: PROGRESS_TITLE,
        text: message,
        component: "import-handler",
        tags: "$:/tags/Alert",
        modified: new Date()
    }));
}
function clearProgress() {
    $tw.wiki.deleteTiddler(PROGRESS_TITLE);
}

/**
 * Show one board full screen: the two sidebars out of the way, the white board page layout
 * in place of the page template, and the board named as the one it draws.
 *
 * The board is left unnamed when nothing could be found to name, which is the layout's own
 * fallback rather than a gap: an empty state tiddler is what it already reads as "draw the
 * newest board this wiki holds".
 */
function openFullscreenBoard(title) {
    var fields = [
        ["$:/state/sidebar", "no"],
        ["$:/state/notebook-sidebar", "no"],
        ["$:/layout", WHITEBOARD_LAYOUT]
    ];
    if (title) {
        fields.push([BOARD_STATE, title]);
    }
    fields.forEach(function(pair){
        $tw.wiki.addTiddler(new $tw.Tiddler({title: pair[0], text: pair[1]}));
    });
}

/**
 * Open one board: it full screen, and the story list left holding it.
 *
 * The story list is set beside the layout because leaving the full screen board hands the
 * river back, and this is what it hands it to: the board, not the empty page the PDF came
 * from.
 */
function openBoard(title) {
    if (!title) {
        return;
    }
    $tw.wiki.addTiddler(new $tw.Tiddler({
        title: "$:/StoryList",
        list: $tw.utils.stringifyList([title])
    }));
    openFullscreenBoard(title);
}

/**
 * Which board a request means.
 *
 * The import names a PDF's tiddlers after the file, so `thesis.pdf` becomes a container
 * called `thesis` whose `stream-list` holds `thesis-text` and `thesis-whiteboard`, and that
 * container is what the launcher passes along. A Lith rearranged since still gets an answer
 * rather than none, because the newest board it holds is the fallback.
 *
 * Only the file's own tiddlers count as boards, which is the line between this and the
 * layout's own fallback: every wiki carries the whiteboard plugin's blank template as a
 * shadow, and answering with that would draw an empty canvas over a Lith that holds no board
 * at all, such as an import interrupted between the file being made and the pages landing.
 */
function boardOf(container) {
    var isBoard = function(title) {
        var tiddler = $tw.wiki.getTiddler(title);
        return !!tiddler && tiddler.fields.type === BOARD_TYPE;
    };
    var holder = container ? $tw.wiki.getTiddler(container) : null;
    var children = holder ? $tw.utils.parseStringArray(holder.fields["stream-list"] || "") : [];
    for (var i = 0; i < children.length; i++) {
        if (isBoard(children[i])) {
            return children[i];
        }
    }
    var newest = $tw.wiki.filterTiddlers("[all[tiddlers]field:type[" + BOARD_TYPE + "]!prefix[$:/temp]!sort[modified]first[]]");
    return newest.length ? newest[0] : "";
}

function base64ToArrayBuffer(base64) {
    var binary = atob(base64);
    var bytes = new Uint8Array(binary.length);
    for (var i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
    }
    return bytes.buffer;
}

/**
 * Add a converted document to the store and say what a page could show of it.
 *
 * Converting and opening are two decisions, not one, and this is the line between them. A PDF
 * the app was handed opens its board, because that is what a double-click on a PDF is for. The
 * same pages arriving in a Lith the person was already reading must not take the screen over, so
 * the titles come back rather than being acted on here, and the containers are named separately:
 * a child with a parent is part of a document, and a child without one is the document.
 */
function addDocument(tiddlers) {
    var opened = { board: "", words: "", entry: "", entries: [] };
    (tiddlers || []).forEach(function(fields){
        $tw.wiki.addTiddler(new $tw.Tiddler(
            $tw.wiki.getCreationFields(),
            $tw.wiki.getModificationFields(),
            fields
        ));
        if (!fields.parent) {
            opened.entries.push(fields.title);
        }
        if (fields.type === BOARD_TYPE) {
            opened.board = fields.title;
        } else if (fields.type === "text/x-markdown") {
            opened.words = fields.title;
        }
    });
    return opened;
}

/** What two converted documents amount to when one gesture carried both. */
function mergeOpened(into, from) {
    if (!from) {
        return into;
    }
    into.board = from.board || into.board;
    into.words = from.words || into.words;
    into.entry = from.entry || into.entry;
    into.entries = into.entries.concat(from.entries || []);
    return into;
}

/** Hand the story river one tiddler, which is how a book and a document are opened. */
function showInRiver(titles) {
    if (!titles || !titles.length) {
        return;
    }
    $tw.wiki.addTiddler(new $tw.Tiddler({
        title: "$:/StoryList",
        list: $tw.utils.stringifyList(titles)
    }));
}

/**
 * Which converter an entry in the queued gesture wants, read from its own name.
 *
 * The launcher's `importKindOf` is the same four kinds, and the name is the only thing either
 * side needs to agree on: the entry carries the file it came from, so a property beside it
 * cannot come to disagree with the bytes.
 */
function kindOfFile(name) {
    if (/\.pdf$/i.test(name)) {
        return "pdf";
    }
    if (/\.epub$/i.test(name)) {
        return "epub";
    }
    if (/\.docx$/i.test(name)) {
        return "docx";
    }
    return "image";
}

/**
 * The PDF itself, converted.
 *
 * The tiddlers live in the mounted document and nowhere else, which is the point: the gesture
 * is opening a PDF, and a file left on disk for every look is clutter. The first save writes
 * them to the sibling the launcher named, and never back to the PDF.
 */
function importPdf(request) {
    var base64 = request.base64;
    var filename = request.filename || "document.pdf";
    var convert = $tw.lithic && $tw.lithic.convertPdfToTiddlers;
    if (typeof base64 !== "string" || base64 === "" || typeof convert !== "function") {
        return Promise.resolve(null);
    }
    return Promise.resolve(convert(base64ToArrayBuffer(base64), filename, setProgress)).then(function(tiddlers){
        clearProgress();
        return addDocument(tiddlers);
    });
}

/** A PDF the app was handed: convert it, and open the board it produced. */
function openRequestedPdf(request) {
    importPdf(request).then(function(opened){
        if (opened && opened.board) {
            // The board is the point of the gesture, so it is what opens. The container and
            // its extracted text stay in the wiki beside it, and a PDF is opened to be
            // written on, so a double-click lands in the full screen layout rather than on a
            // tiddler in the river, the way the Fullscreen Whiteboard page control and a
            // stream node's handle land there.
            openBoard(opened.board);
        }
    }).catch(function(error){
        clearProgress();
        setProgress("Could not open the PDF: " + (error && error.message ? error.message : error));
    });
}

/**
 * The Lith beside the PDF, opened as the board its pages are under.
 *
 * Nothing is saved: this mount is the file's own text, unchanged, so a save would write the
 * file over itself for nothing. The layout is set rather than respected, which is the whole
 * point of the ask -- a Lith saved from the story river opens in the river -- and only the
 * Lith that arrived this way is forced, because every other mount carries no request. A Lith
 * with no board in it is left as it stands: there is nothing to open, and an empty board
 * layout would be a worse answer than the file's own.
 */
function openRequestedBoard(board) {
    openBoard(boardOf(board.container));
}

/**
 * The image itself: draw it on a board, and open that board.
 *
 * The picture is never opened as a note of its own, because a board is what a double-click on
 * an image means in this app: a canvas the picture sits on, that a person can write beside. It
 * is left unsaved for the same reason the PDF's pages are: looking at a picture is not a
 * reason to write a file, and the save is.
 */
function importImage(request) {
    var base64 = request.base64;
    var filename = request.filename || "image.png";
    var convert = $tw.lithic && $tw.lithic.convertImageToTiddlers;
    if (typeof base64 !== "string" || base64 === "" || typeof convert !== "function") {
        return Promise.resolve(null);
    }
    setProgress("Drawing " + filename + " on a whiteboard...");
    return Promise.resolve(convert({
        name: filename,
        dataUri: dataUrlOf(filename, base64)
    })).then(function(tiddlers){
        clearProgress();
        return addDocument(tiddlers);
    });
}

function openRequestedImage(request) {
    importImage(request).then(function(opened){
        if (opened && opened.board) {
            openBoard(opened.board);
        }
    }).catch(function(error){
        clearProgress();
        setProgress("Could not draw the image: " + (error && error.message ? error.message : error));
    });
}

/**
 * The book itself: convert it, and open the chapter it is entered at.
 *
 * A book is entered at its first chapter, so that is what the story river holds. The chapters are
 * also Favorites in reading order, so the sidebar is how a person moves through the book; putting
 * all of it in the river at once would load a whole book into one page.
 *
 * Nothing is saved here, for the same reason a PDF's pages are not: opening a book to read it is
 * a view of that file, and the save the person presses is what writes the Lith beside it.
 */
function importBook(request) {
    var base64 = request.base64;
    var filename = request.filename || "book.epub";
    var convert = $tw.lithic && $tw.lithic.convertEpubToTiddlers;
    if (typeof base64 !== "string" || base64 === "" || typeof convert !== "function") {
        return Promise.resolve(null);
    }
    setProgress("Importing " + filename + " as a book...");
    return Promise.resolve(convert(base64ToArrayBuffer(base64), filename, setProgress)).then(function(book){
        var opened = addDocument(book.tiddlers);
        clearProgress();
        opened.entry = book.entry || "";
        // A chapter has no parent, so every chapter of the book counts as a container above.
        // What a merge reports is the chapter it was entered at, which is the one title a person
        // needs to find the book again.
        opened.entries = opened.entry ? [opened.entry] : [];
        return opened;
    });
}

function openRequestedBook(request) {
    importBook(request).then(function(opened){
        if (opened && opened.entry) {
            showInRiver([opened.entry]);
        }
    }).catch(function(error){
        clearProgress();
        setProgress("Could not open the book: " + (error && error.message ? error.message : error));
    });
}

/**
 * The Word document itself: convert it, then open its words.
 *
 * The words are what a person opened, so the text node is what the river holds. The pictures are
 * one step away in the container the import wrote, on the board beside them, which is the same
 * shape a PDF arrives in: a container, a text node, and a board.
 *
 * A document that is all pictures has no words to open, so the board opens instead of an empty
 * page. Nothing is saved here, for the reason no import saves: opening a file to read it is a
 * view, and the save is what writes the Lith beside it.
 */
function importDocument(request) {
    var base64 = request.base64;
    var filename = request.filename || "document.docx";
    var convert = $tw.lithic && $tw.lithic.convertDocxToTiddlers;
    if (typeof base64 !== "string" || base64 === "" || typeof convert !== "function") {
        return Promise.resolve(null);
    }
    setProgress("Importing " + filename + " as a document...");
    return Promise.resolve(convert(base64ToArrayBuffer(base64), filename, setProgress)).then(function(tiddlers){
        clearProgress();
        return addDocument(tiddlers);
    });
}

/**
 * A Word document the app was handed: convert it, then open its words.
 *
 * The words are what a person opened, so the text node is what the river holds. A document that
 * is all pictures has no words to open, so the board opens instead of an empty page.
 */
function openRequestedDocument(request) {
    importDocument(request).then(function(opened){
        if (!opened) {
            return;
        }
        if (opened.words) {
            showInRiver([opened.words]);
        } else if (opened.board) {
            openBoard(opened.board);
        }
    }).catch(function(error){
        clearProgress();
        setProgress("Could not open the document: " + (error && error.message ? error.message : error));
    });
}

// A file's name without its extension, which is the container the importer titles it with.
function containerNameOf(filename) {
    return String(filename).replace(/\.[^/.]+$/, "");
}

/**
 * The queued gesture as `{ files, openBoard }`, whichever shape the launcher left.
 *
 * A bare list is what this property used to carry, and it still means what it always did: the
 * mount exists for those files, so the board they draw is what opens.
 */
function normalizeGesture(value) {
    if (Array.isArray(value)) {
        return { files: value, openBoard: true };
    }
    return {
        files: Array.isArray(value && value.files) ? value.files : [],
        openBoard: !(value && value.openBoard === false)
    };
}

/**
 * A gesture the launcher queued, as the one document it was meant to be.
 *
 * Pictures and PDFs share one board, every page in the order the gesture carried them, and the
 * words of the PDFs become one text extract under the container the importer names. A book and a
 * Word document are documents of their own, because a chapter is not a page: the same selection
 * dropped into an open wiki becomes the same three shapes, through the same readers.
 *
 * One file on this list is answered by the one-file importer, so a drop of a single PDF and a
 * double-click on that PDF cannot produce different documents.
 *
 * `openBoard` is the launcher's answer to what the mount is for. A document started from the
 * gesture opens the board it just drew, the way a dropped PDF always has; a Lith the person
 * chose to import into keeps the view they were already reading, so the engine's own import
 * list is what says the pages arrived.
 */
function openRequestedFiles(queued) {
    var files = Array.isArray(queued.files) ? queued.files.filter(function(file) {
        return file && typeof file.base64 === "string";
    }) : [];
    if (!files.length) {
        return;
    }
    var open = queued.openBoard;
    var readers = $tw.lithic || {};
    var merge = readers.mergeDocumentTiddlers;
    if (typeof readers.readPdfPages !== "function" || typeof readers.readPicturePage !== "function" || typeof merge !== "function") {
        return;
    }

    var entries = files.map(function(file) {
        var name = file.filename || "file";
        return { file: file, name: name, kind: kindOfFile(name) };
    });
    var graphics = entries.filter(function(entry) {
        return entry.kind === "pdf" || entry.kind === "image";
    });

    setProgress("Importing " + files.length + (files.length === 1 ? " file..." : " files..."));
    (async function() {
        var opened = { board: "", words: "", entry: "", entries: [] };
        if (graphics.length === 1) {
            // The one-file route, so a single file on this list is the document a double-click
            // on it makes rather than a merged board of one page.
            var only = graphics[0];
            opened = mergeOpened(opened, only.kind === "pdf" ? await importPdf(only.file) : await importImage(only.file));
        } else if (graphics.length > 1) {
            var documents = [];
            for (var i = 0; i < graphics.length; i++) {
                var entry = graphics[i];
                if (entry.kind === "pdf") {
                    var read = await readers.readPdfPages(base64ToArrayBuffer(entry.file.base64), entry.name, setProgress);
                    documents.push({ title: containerNameOf(entry.name), fileName: entry.name, pages: read.pages, texts: read.texts });
                } else {
                    // A picture this browser cannot draw is left out rather than failing the
                    // gesture: the pages that did arrive are still worth having.
                    var page = await readers.readPicturePage({ name: entry.name, dataUri: dataUrlOf(entry.name, entry.file.base64) });
                    if (page) {
                        documents.push({ title: containerNameOf(entry.name), fileName: entry.name, pages: [page], texts: [] });
                    }
                }
            }
            setProgress("Building one whiteboard from " + documents.length + " files...");
            var tiddlers = merge(documents);
            if (tiddlers.length === 0) {
                throw new Error("nothing could be read");
            }
            opened = mergeOpened(opened, addDocument(tiddlers));
        }

        for (var b = 0; b < entries.length; b++) {
            if (entries[b].kind === "epub") {
                opened = mergeOpened(opened, await importBook(entries[b].file));
            }
        }
        for (var d = 0; d < entries.length; d++) {
            if (entries[d].kind === "docx") {
                opened = mergeOpened(opened, await importDocument(entries[d].file));
            }
        }

        clearProgress();
        if (!open) {
            if (typeof readers.reportImportedTitles === "function") {
                readers.reportImportedTitles(opened.entries);
            }
            return;
        }
        if (opened.board) {
            // The board is the point of the gesture, so it is what opens, the way a dropped
            // PDF's pages do.
            openBoard(opened.board);
        } else if (opened.words) {
            showInRiver([opened.words]);
        } else if (opened.entry) {
            showInRiver([opened.entry]);
        }
    })().catch(function(error) {
        clearProgress();
        setProgress("Could not import the files: " + (error && error.message ? error.message : error));
    });
}

exports.startup = function() {
    if (typeof window === "undefined") {
        return;
    }
    var request = window[REQUEST_GLOBAL];
    if (request) {
        // Taken off the window immediately: nothing else in this document has any business
        // reading a whole PDF, and a later mount in this window must not find it again.
        window[REQUEST_GLOBAL] = null;
        openRequestedPdf(request);
        return;
    }
    var image = window[IMAGE_REQUEST];
    if (image) {
        // The same rule as the PDF above: taken off the window before anything else can read it,
        // so a later mount in this window never finds a picture it did not ask for.
        window[IMAGE_REQUEST] = null;
        openRequestedImage(image);
        return;
    }
    var book = window[EPUB_REQUEST];
    if (book) {
        // Taken off the window for the same reason the two above are: a whole book is not
        // something a later mount in this window should find and import again.
        window[EPUB_REQUEST] = null;
        openRequestedBook(book);
        return;
    }
    var word = window[DOCX_REQUEST];
    if (word) {
        // And the same rule again: a document taken off the window before anything else reads it.
        window[DOCX_REQUEST] = null;
        openRequestedDocument(word);
        return;
    }
    var files = window[FILES_REQUEST];
    if (files) {
        // And the same rule again: the whole gesture comes off the window before anything else
        // can read it, so a later mount in this window never imports one it did not make.
        window[FILES_REQUEST] = null;
        openRequestedFiles(normalizeGesture(files));
        return;
    }
    var board = window[BOARD_REQUEST];
    if (!board) {
        return;
    }
    window[BOARD_REQUEST] = null;
    openRequestedBoard(board);
};

})();