title: $:/plugins/lithic/lithic-import-handler/pdf-drop-handler.js
type: application/javascript
module-type: startup

/* Intercepts PDF file drops and converts them into TLDraw Whiteboard tiddlers. */
(function(){

/*jslint node: true, browser: true */
/*global $tw: false */
"use strict";

exports.name = "import-handler";
exports.platforms = ["browser"];
exports.after = ["startup"];
exports.synchronous = true;

// A book is unpacked by its own module: the archive reader and the package
// document are a different job from rendering a page, and keeping them apart is
// what lets one be changed without the other. Its archive reader is what a Word
// document is unpacked with too, because both are a zip holding XML.
var bookFormat = require("$:/plugins/lithic/lithic-import-handler/epub.js");
var convertEpubToTiddlers = bookFormat.convertEpubToTiddlers;
var readEntries = bookFormat.readEntries;
var readText = bookFormat.readText;
var findEntry = bookFormat.findEntry;
var entryBytes = bookFormat.entryBytes;
var parseXml = bookFormat.parseXml;
var resolveHref = bookFormat.resolveHref;

function generateUUID() {
    if (typeof crypto !== "undefined" && crypto.randomUUID) {
        return crypto.randomUUID();
    }
    // Fallback UUID v4 generator
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
    });
}

function generateWhiteboardData(images) {
    const documentId = "doc";
    const pages = {};
    const assets = {};
    const pageStates = {};

    images.forEach((img, index) => {
        const i = index + 1;
        
        const uuidAsset = generateUUID();
        const uuidShape = generateUUID();
        // TLDraw v1 expects the first page ID to typically be "page"
        const uuidPage = i === 1 ? "page" : generateUUID();

        // Add page
        pages[uuidPage] = {
            id: uuidPage,
            name: img.name || `Page ${i}`,
            childIndex: i,
            shapes: {},
            bindings: {}
        };

        // Add asset
        assets[uuidAsset] = {
            id: uuidAsset,
            type: "image",
            fileName: img.filename,
            src: img.dataUri,
            size: [img.width, img.height]
        };

        // Add shape to page
        pages[uuidPage].shapes[uuidShape] = {
            id: uuidShape,
            type: "image",
            name: "Image",
            parentId: uuidPage,
            childIndex: 1,
            point: [0, 0],
            size: [img.width, img.height],
            rotation: 0,
            style: {
                color: "black",
                size: "small",
                isFilled: false,
                dash: "draw",
                scale: 1
            },
            assetId: uuidAsset,
            isLocked: true
        };

        // Initialize page state
        // Zoom to fit: camera.point in TLDraw v1 is a screen-space offset.
        // Positive values push content right/down, creating visible margins.
        const sidebarMargin = 0; 
        const topMargin = 50;

        // Use adaptive stream row height so portrait PDFs get a full page and slides fit two-per-page (540px)
        const viewerWidth = 1200;
        const isPortrait = img.height > img.width;

        let zoom, viewerHeight;
        if (isPortrait) {
            // Per user request, scale to exactly 75% for portrait PDFs
            zoom = 0.75;
            // Hardcoded to exactly 1056px to strictly avoid the 'blank first page' print phenomenon
            viewerHeight = 1056; 
        } else {
            viewerHeight = 540;
            zoom = Math.min(
                (viewerWidth - sidebarMargin) / img.width,
                (viewerHeight - topMargin) / img.height,
                1
            );
        }

        pageStates[uuidPage] = {
            id: uuidPage,
            selectedIds: [],
            camera: {
                // camera.point is in canvas space, so divide desired screen-pixel
                // margin by zoom to get the correct canvas-unit offset.
                point: [sidebarMargin / zoom, topMargin / zoom],
                zoom: zoom
            }
        };
    });

    return {
        document: {
            id: documentId,
            name: "PDF Canvas",
            version: 15.5,
            pages: pages,
            pageStates: pageStates,
            assets: assets
        }
    };
}

// The largest edge an imported image is kept at.
//
// A board is read at screen scale and its asset lives inside the Lith, so an eight-thousand
// pixel photograph or an uncompressed BMP would put megabytes into a file a person then syncs
// and keeps. The drop path takes whatever size it is handed; this states the ceiling that path
// implies, because an image opened by association has no drop to argue with and a canvas larger
// than the browser allows is the one way this gesture can fail outright.
var MAX_IMAGE_EDGE = 3000;

/**
 * One picture as the page a board keeps: decoded once to learn its size, drawn no larger than an
 * imported image is, and re-encoded as WebP for the reason a PDF page is, the asset living
 * inside the Lith.
 *
 * A promise because decoding and re-encoding take the browser's own time. It resolves to null for
 * bytes this browser cannot draw, because a page missing from a document is worth more than a
 * gesture that failed.
 */
function readPicturePage(image) {
    return new Promise(function(resolve){
        var element = new Image();
        element.onload = function(){
            var width = element.naturalWidth || element.width;
            var height = element.naturalHeight || element.height;
            if (!width || !height) {
                // A picture with no size is one nothing can place on a page.
                resolve(null);
                return;
            }
            var scale = Math.min(1, MAX_IMAGE_EDGE / Math.max(width, height));
            var canvas = document.createElement("canvas");
            canvas.width = Math.max(1, Math.round(width * scale));
            canvas.height = Math.max(1, Math.round(height * scale));
            var context = canvas.getContext("2d");
            context.drawImage(element, 0, 0, canvas.width, canvas.height);
            // WebP for the same reason the drop path re-encodes: the asset is carried inside the
            // Lith, and the payload measurement there was 858 KB as WebP against 3.4 MB as PNG.
            resolve({
                filename: pictureBaseName(image.name) + ".webp",
                dataUri: canvas.toDataURL("image/webp", 0.75),
                width: canvas.width,
                height: canvas.height
            });
        };
        element.onerror = function(){
            resolve(null);
        };
        element.src = image.dataUri;
    });
}

// A picture's name as its node and its asset are titled: the file name without the extension,
// which is the name the drop path gives the board too, and the one a re-opened image is found
// under.
function pictureBaseName(name) {
    return String(name || "image").replace(/\.[^/.]+$/, "") || "image";
}

/**
 * One image, as the tiddlers a board is made of.
 *
 * The board is the one a dropped image produces, camera included, because it is built by the
 * same generator: opening a picture and dropping it are two ways to the same canvas, and a
 * second layout rule for the same input is how the two would drift. What is added is the
 * container the desktop app names, so a re-opened image finds its own board again, exactly as a
 * re-opened PDF finds the pages it was made from (see `boardOf` in `pdf-open-request.js`).
 */
function convertImageDataToTiddlers(image) {
    return readPicturePage(image).then(function(page){
        if (!page) {
            throw new Error("The image could not be read");
        }
        var containerTitle = $tw.wiki.generateNewTitle(pictureBaseName(image.name));
        var boardTitle = $tw.wiki.generateNewTitle(containerTitle + "-whiteboard");
        var payload = generateWhiteboardData([page]);
        return [
            {
                title: containerTitle,
                "stream-list": $tw.utils.stringifyList([boardTitle]),
                "stream-type": "default",
                text: ""
            },
            {
                title: boardTitle,
                parent: containerTitle,
                text: JSON.stringify(payload),
                type: "application/tldr",
                "stream-type": "default",
                "whiteboard-height": page.height > page.width ? "1056px" : "540px"
            }
        ];
    });
}

// --- Which way the document is written ---------------------------------------
//
// A document printed sideways arrives as a page to turn your head for: a slide deck saved from a
// landscape view, or anything that reached PDF through a print driver pointed the wrong way.
// Nothing in the page geometry says so, because the page is simply portrait with landscape
// content drawn on it, but the text does: every text item carries the direction its own baseline
// runs in.
//
// So the text is read before anything is rendered, and the pages are then drawn at the angle
// that puts that text back on the line. The judgement is the document's, never the page's. A
// direction is applied only when the whole document agrees on it, because a document straightened
// page by page can come out as a deck whose pages face different ways, and a reader can no longer
// tell which way any of it opens.

// The most pages carrying text that are read before the direction is settled. A ceiling rather
// than a threshold: a document shorter than this is read whole, so a one-page slide is judged on
// its own single page. The cap is what stops a hundred-page deck being read twice, and eight is
// enough that a cover page or two cannot swing the answer.
var READING_SAMPLE = 8;

// How many characters the document needs, counted across everything sampled, before its direction
// is worth believing. Below this the text is a stamp, a form field, or nothing at all, and a
// scanned page has no text to read. Four or five words on one page clear it.
var READING_FLOOR = 40;

// How far one page may lean from the document's own answer, in degrees, before the file is called
// jumbled and left exactly as it is.
var READING_AGREEMENT = 30;

/**
 * The reading direction of one page's text, as a vector weighted by characters: `x` is how much
 * of it runs left to right and `y` how much runs bottom to top. The page's own `/Rotate` is added
 * because that turn is already applied by the time a reader sees the page.
 */
function pageReading(content, rotation) {
    var reading = { x: 0, y: 0, weight: 0 };
    var turn = (rotation || 0) * Math.PI / 180;
    for (var i = 0; i < content.items.length; i++) {
        var item = content.items[i];
        if (!item.str || !item.str.trim() || !item.transform) {
            continue;
        }
        var angle = Math.atan2(item.transform[1], item.transform[0]) + turn;
        var weight = item.str.length;
        reading.x += Math.cos(angle) * weight;
        reading.y += Math.sin(angle) * weight;
        reading.weight += weight;
    }
    return reading;
}

/**
 * The turn, in degrees clockwise, that puts a document's text back on the line, or 0 to leave the
 * document as it stands. Only quarter turns are ever answered: that is what a page printed
 * sideways needs, and it is all a word's own matrix can be trusted to say.
 */
function uprightTurn(readings) {
    var x = 0, y = 0, weight = 0;
    for (var i = 0; i < readings.length; i++) {
        x += readings[i].x;
        y += readings[i].y;
        weight += readings[i].weight;
    }
    if (weight < READING_FLOOR) {
        return 0;
    }
    var mean = Math.atan2(y, x);
    var turn = Math.round(mean / (Math.PI / 2)) * 90;
    turn = ((turn % 360) + 360) % 360;
    if (turn === 0) {
        return 0;
    }
    // One page leaning the other way is enough to call the document jumbled.
    for (var j = 0; j < readings.length; j++) {
        if (!readings[j].weight) {
            continue;
        }
        var lean = Math.atan2(readings[j].y, readings[j].x) - mean;
        var apart = Math.abs(Math.atan2(Math.sin(lean), Math.cos(lean))) * 180 / Math.PI;
        if (apart > READING_AGREEMENT) {
            return 0;
        }
    }
    return turn;
}

/**
 * A PDF as the pieces a document is built from: every page drawn once at the angle the
 * document is written at, and the words each page carries.
 *
 * The reading is separate from the tiddlers because a PDF dropped beside others is these same
 * pages and these same words: only the shape of the Lith around them differs, so one reader
 * serves both and the two cannot drift.
 */
async function readPdfPages(arrayBuffer, fileName, setProgress) {
    const pdfjsLib = require("$:/plugins/lithic/lithic-import-handler/pdf.js");
    
    // --- Worker Configuration ---
    if (!globalThis.pdfjsWorker) {
        var workerText = $tw.wiki.getTiddlerText("$:/plugins/lithic/lithic-import-handler/pdf.worker.js");
        if (workerText) {
            (new Function(workerText))();
        }
    }
    if (pdfjsLib.GlobalWorkerOptions && !pdfjsLib.GlobalWorkerOptions.workerSrc) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = "data:application/javascript,";
    }

    setProgress("Converting " + fileName + " — loading PDF...");
    
    const loadingTask = pdfjsLib.getDocument({ 
        data: arrayBuffer,
        isEvalSupported: false,
        disableStream: true,
        disableAutoFetch: true
    });
    
    const pdf = await loadingTask.promise;
    const images = [];
    var texts = [];

    // Which way the document is written, read before a single page is drawn so that every page is
    // rendered once, at the angle this answers.
    setProgress("Converting " + fileName + " — reading the page direction...");
    var readings = [];
    for (var sampled = 1; sampled <= pdf.numPages && readings.length < READING_SAMPLE; sampled++) {
        var sampledPage = await pdf.getPage(sampled);
        var reading = pageReading(await sampledPage.getTextContent(), sampledPage.rotate);
        if (reading.weight) {
            readings.push(reading);
        }
    }
    var turn = uprightTurn(readings);

    for (let i = 1; i <= pdf.numPages; i++) {
        setProgress("Converting " + fileName + " — rendering page " + i + "/" + pdf.numPages + "...");

        const page = await pdf.getPage(i);
        const scale = 2.0; 
        const viewport = page.getViewport({ scale: scale, rotation: ((page.rotate || 0) + turn) % 360 });

        const canvas = document.createElement("canvas");
        const context = canvas.getContext("2d");
        canvas.width = viewport.width;
        canvas.height = viewport.height;

        await page.render({ canvasContext: context, viewport: viewport }).promise;

        // WebP at 0.75 keeps a slide deck's pages to about a quarter of the PNG
        // payload (3.4 MB of page images as PNG against 858 KB as WebP, measured
        // on a 15-page deck). The whiteboard draws any format the browser decodes:
        // its assets are plain image sources, and IMAGE_EXTENSIONS only filters
        // what can be dropped onto a board, never what a document may reference.
        const dataUri = canvas.toDataURL("image/webp", 0.75);
        images.push({
            filename: "page_" + i + ".webp",
            dataUri: dataUri,
            width: viewport.width,
            height: viewport.height
        });

        var textContent = await page.getTextContent();
        var pageText = textContent.items
            .map(function(item) { return item.str; })
            .join(" ")
            .replace(/\s+/g, " ")
            .trim();
        if (pageText) {
            texts.push({ page: i, text: pageText });
        }
    }

    return { pages: images, texts: texts };
}

/**
 * The tiddlers one PDF becomes on its own: a container, the words extracted under it, and the
 * board its pages were drawn on.
 */
async function convertPdfDataToTiddlers(arrayBuffer, fileName, setProgress) {
    var read = await readPdfPages(arrayBuffer, fileName, setProgress);
    var images = read.pages;
    var pageTexts = read.texts.map(function(entry) {
        return "#### Page " + entry.page + "\n\n" + entry.text;
    });

    const baseName = fileName.replace(/\.pdf$/i, "");
    const containerTitle = $tw.wiki.generateNewTitle(baseName);
    const txtTitle = $tw.wiki.generateNewTitle(containerTitle + "-text");
    const wbTitle = $tw.wiki.generateNewTitle(containerTitle + "-whiteboard");

    const tiddlers = [];
    
    // Container tiddler
    tiddlers.push({
        title: containerTitle,
        "stream-list": $tw.utils.stringifyList([txtTitle, wbTitle]),
        "stream-type": "default",
        text: ""
    });

    // Plaintext markdown tiddler
    var markdownBody = "## " + baseName + "\n\n" + pageTexts.join("\n\n");
    tiddlers.push({
        title: txtTitle,
        parent: containerTitle,
        text: markdownBody,
        type: "text/x-markdown",
        "stream-type": "default"
    });

    // Whiteboard tiddler
    const payload = generateWhiteboardData(images);
    const isPortrait = images[0] && (images[0].height > images[0].width);
    let wbHeight = "540px";
    if (isPortrait) {
        // Force the macro to exactly 1056px to strictly avoid the blank first page phenomenon
        wbHeight = "1056px"; 
    }

    tiddlers.push({
        title: wbTitle,
        parent: containerTitle,
        text: JSON.stringify(payload),
        type: "application/tldr",
        "stream-type": "default",
        "whiteboard-height": wbHeight
    });

    return tiddlers;
}

// --- Word documents ----------------------------------------------------------
//
// A `.docx` is a zip holding the document as XML, which is the same container a book is
// unpacked from, so the archive reader `epub.js` already has is what reads it: one reader
// for one container, rather than a second one that would fail on the same entries.
//
// What is read is best effort and deliberately shallow. A paragraph becomes a line, its
// words as written; a heading keeps its level and a list item keeps its bullet, because
// those are structure rather than formatting and a document without them reads as one long
// paragraph. Runs, column widths, comments, footnotes, tracked changes and equations are
// not read: a Lith is a place to keep what a document said, and reproducing its layout is a
// job for the program that made it. Pictures are read, and they are drawn on a board the
// way a PDF's pages are, because a board is where this wiki puts a picture a person can
// write beside.

var DOCX_MIME = "application/vnd.openxmlformats-officedocument.wordprocessingml.document";

// The pictures a browser can decode, keyed by the extension an archive gives them. A Word
// archive also holds `.emf` and `.wmf` drawings, which no browser can draw, so those are
// left out rather than imported as a node nothing renders.
var DOCX_IMAGE_TYPES = {
    png: "image/png",
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    gif: "image/gif",
    bmp: "image/bmp",
    webp: "image/webp"
};

// An element's name without its namespace prefix. An XML parse keeps `w:p` in `tagName`
// and puts `p` in `localName`, while the forgiving HTML parse used on a file that will not
// parse as XML names every element with its prefix; reading the name without one is what
// makes both parses the same code.
function docxName(node) {
    return String((node && (node.localName || node.tagName)) || "").replace(/^[^:]*:/, "");
}

function docxChild(node, name) {
    for (var child = node && node.firstElementChild; child; child = child.nextElementSibling) {
        if (docxName(child) === name) {
            return child;
        }
    }
    return null;
}

// `w:val` is the attribute every OOXML property carries, and its prefix is dropped for the
// same reason it is above.
function docxValue(node) {
    if (!node || !node.getAttribute) {
        return "";
    }
    return node.getAttribute("w:val") || node.getAttribute("val") || "";
}

// The words of one paragraph, on one line. A tab and a hard break read as the space they
// are; a field's code and text somebody deleted are not the document's words, which is what
// reading the two tags that hold words gives for free.
function docxParagraphText(paragraph) {
    var text = "";
    (function read(node){
        for (var child = node.firstElementChild; child; child = child.nextElementSibling) {
            var name = docxName(child);
            if (name === "Fallback") {
                // A text box is written twice, once as the shape and once for a reader that
                // does not know it. Reading both would say it twice.
                continue;
            }
            if (name === "t") {
                text += String(child.textContent || "");
            } else if (name === "tab" || name === "br" || name === "cr") {
                text += " ";
            } else if (name === "noBreakHyphen") {
                text += "-";
            } else {
                read(child);
            }
        }
    })(paragraph);
    return text.replace(/\s+/g, " ").trim();
}

// How deep a heading is: the outline level Word stores, or, where a document carries none,
// the level its style's own name says. 0 is an ordinary paragraph.
function docxHeading(properties) {
    if (!properties) {
        return 0;
    }
    var outline = parseInt(docxValue(docxChild(properties, "outlineLvl")), 10);
    if (!isNaN(outline) && outline >= 0 && outline <= 5) {
        return outline + 1;
    }
    var style = docxValue(docxChild(properties, "pStyle")).toLowerCase();
    var match = /^heading\s*([1-6])$/.exec(style);
    return match ? parseInt(match[1], 10) : 0;
}

// Every paragraph in the document, in the order a reader meets it. A table's cells are
// paragraphs like any other, which is why this walks the tree rather than the body's own
// children.
function docxBlocks(node, blocks) {
    for (var child = node && node.firstElementChild; child; child = child.nextElementSibling) {
        var name = docxName(child);
        if (name === "Fallback") {
            continue;
        }
        if (name !== "p") {
            docxBlocks(child, blocks);
            continue;
        }
        var text = docxParagraphText(child);
        if (!text) {
            continue;
        }
        var properties = docxChild(child, "pPr");
        var heading = docxHeading(properties);
        if (heading) {
            blocks.push(new Array(heading + 1).join("#") + " " + text);
        } else if (docxChild(properties, "numPr")) {
            blocks.push("- " + text);
        } else {
            blocks.push(text);
        }
    }
}

// Which entry each picture is: `word/_rels/document.xml.rels` maps the id a drawing names
// to the file holding its bytes, and that file is addressed from `word/`, which is why the
// target is resolved against the document rather than from the archive's root.
function docxRelationships(bytes, entries) {
    return readText(bytes, entries, "word/_rels/document.xml.rels").then(function(markup){
        var found = {};
        if (!markup) {
            return found;
        }
        var doc = parseXml(markup);
        var all = doc.getElementsByTagName("*");
        for (var i = 0; i < all.length; i++) {
            var element = all[i];
            if (docxName(element) !== "Relationship") {
                continue;
            }
            var id = element.getAttribute("Id");
            var target = element.getAttribute("Target");
            if (!id || !target || !/\/image$/.test(element.getAttribute("Type") || "")) {
                continue;
            }
            // A linked picture is a file beside the document rather than inside it, so
            // there are no bytes to read and nothing to draw.
            if (element.getAttribute("TargetMode") === "External") {
                continue;
            }
            found[id] = resolveHref("word/document.xml", target);
        }
        return found;
    });
}

// The pictures the document draws, in the order it draws them, once each: a page is a place
// the document has a picture, not a shape to repeat.
function docxImageIds(doc) {
    var ids = [];
    var seen = {};
    var all = doc.getElementsByTagName("*");
    for (var i = 0; i < all.length; i++) {
        var element = all[i];
        var id = element.getAttribute ? (element.getAttribute("r:embed") || "") : "";
        if (!id && docxName(element) === "imagedata") {
            // The older picture element names its file with `r:id` instead.
            id = element.getAttribute("r:id") || "";
        }
        if (id && !seen[id]) {
            seen[id] = true;
            ids.push(id);
        }
    }
    return ids;
}

// The archive's bytes as the address a picture is drawn from. A data URL rather than an
// object URL because the picture becomes an asset inside the Lith, so the address has to be
// the bytes rather than a place in this page.
function bytesToDataUrl(mime, bytes) {
    var binary = "";
    var chunk = 0x8000;
    for (var i = 0; i < bytes.length; i += chunk) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
    }
    return "data:" + mime + ";base64," + btoa(binary);
}

/**
 * One picture from the archive, at the size a board keeps it: decoded once to learn its
 * size, drawn no larger than an imported image is, and written out as WebP for the reason a
 * dropped picture is, the asset living inside the Lith.
 *
 * Resolves to null for a picture this browser cannot decode, because the words of a document
 * are worth more than none of it.
 */
function docxPicture(image) {
    return new Promise(function(resolve){
        var element = new Image();
        element.onload = function(){
            var width = element.naturalWidth || element.width;
            var height = element.naturalHeight || element.height;
            if (!width || !height) {
                resolve(null);
                return;
            }
            var scale = Math.min(1, MAX_IMAGE_EDGE / Math.max(width, height));
            var canvas = document.createElement("canvas");
            canvas.width = Math.max(1, Math.round(width * scale));
            canvas.height = Math.max(1, Math.round(height * scale));
            canvas.getContext("2d").drawImage(element, 0, 0, canvas.width, canvas.height);
            resolve({
                filename: image.filename.replace(/\.[^/.]+$/, "") + ".webp",
                dataUri: canvas.toDataURL("image/webp", 0.75),
                width: canvas.width,
                height: canvas.height
            });
        };
        element.onerror = function(){
            resolve(null);
        };
        element.src = image.dataUri;
    });
}

/**
 * A Word document as the nodestream a document becomes: one container holding the words and
 * the pictures, so a save writes one Lith rather than a note with a board somewhere else.
 *
 * The shape is the PDF import's, down to the titles: the container is named after the file,
 * `-text` holds the words and `-whiteboard` holds the pictures, which is what lets a Lith
 * made from either be read, and re-opened, the same way (see `boardOf` in
 * `pdf-open-request.js`).
 */
async function convertDocxToTiddlers(arrayBuffer, fileName, setProgress) {
    var note = typeof setProgress === "function" ? setProgress : function() {};
    var bytes = new Uint8Array(arrayBuffer);
    var entries = readEntries(bytes);
    var markup = entries ? await readText(bytes, entries, "word/document.xml") : null;
    if (!markup) {
        throw new Error("Not a Word document");
    }

    note("Reading " + fileName + "...");
    var doc = parseXml(markup);
    var blocks = [];
    docxBlocks(doc.documentElement, blocks);

    var relationships = await docxRelationships(bytes, entries);
    var ids = docxImageIds(doc);
    var pictures = [];
    for (var i = 0; i < ids.length; i++) {
        var target = relationships[ids[i]];
        var entry = target ? findEntry(entries, target) : null;
        var match = target ? /\.([^./]+)$/.exec(target) : null;
        var mime = match ? DOCX_IMAGE_TYPES[match[1].toLowerCase()] : "";
        if (!entry || !mime) {
            continue;
        }
        note("Reading " + fileName + ": picture " + (i + 1) + "/" + ids.length + "...");
        var picture = await docxPicture({
            filename: target.replace(/^.*\//, ""),
            dataUri: bytesToDataUrl(mime, await entryBytes(bytes, entry))
        });
        if (picture) {
            pictures.push(picture);
        }
    }

    if (blocks.length === 0 && pictures.length === 0) {
        throw new Error("The Word document has nothing to read");
    }

    var baseName = fileName.replace(/\.docx$/i, "");
    var containerTitle = $tw.wiki.generateNewTitle(baseName);
    var children = [];
    var tiddlers = [];

    if (blocks.length > 0) {
        var textTitle = $tw.wiki.generateNewTitle(containerTitle + "-text");
        tiddlers.push({
            title: textTitle,
            parent: containerTitle,
            // The document's own words, without a heading built from the filename: a Word
            // document usually opens with its title already, and saying it twice is
            // furniture the person then deletes.
            text: blocks.join("\n\n"),
            type: "text/x-markdown",
            "stream-type": "default"
        });
        children.push(textTitle);
    }

    if (pictures.length > 0) {
        var boardTitle = $tw.wiki.generateNewTitle(containerTitle + "-whiteboard");
        tiddlers.push({
            title: boardTitle,
            parent: containerTitle,
            text: JSON.stringify(generateWhiteboardData(pictures)),
            type: "application/tldr",
            "stream-type": "default",
            "whiteboard-height": pictures[0].height > pictures[0].width ? "1056px" : "540px"
        });
        children.push(boardTitle);
    }

    tiddlers.unshift({
        title: containerTitle,
        "stream-list": $tw.utils.stringifyList(children),
        "stream-type": "default",
        text: ""
    });
    return tiddlers;
}

// --- One gesture, one document ------------------------------------------------
//
// A selection of pictures, a folder of scans, a deck delivered as one PDF per slide: each
// file used to become its own Lith, so reading them in order meant opening each one. A gesture
// carrying more than one of them is evidently one document, so it becomes one: a single
// container, one board whose pages are every page in the order they were picked, and one text
// tiddler holding the words those pages carry.
//
// The title is the first file's, because that is the only name the gesture arrived with, and a
// person who wants another renames the one node.

/**
 * The markdown one text tiddler holds: the container's heading, then each document that had
 * words, its file name, and its pages numbered as they are in the file they came from.
 *
 * A document with no words is skipped rather than named, because a picture has none to show
 * and an empty heading would only be a row to delete. Nothing is returned when no document had
 * any, which is how a selection of pictures ends up with a board and no text at all.
 */
function mergedTextBody(containerTitle, documents) {
    var sections = [];
    documents.forEach(function(doc) {
        if (!doc.texts.length) {
            return;
        }
        var section = "";
        // The file name is what tells two documents' page ones apart; one document needs no
        // introduction.
        if (documents.length > 1) {
            section += "### " + doc.fileName + "\n\n";
        }
        section += doc.texts.map(function(entry) {
            return "#### Page " + entry.page + "\n\n" + entry.text;
        }).join("\n\n");
        sections.push(section);
    });
    if (!sections.length) {
        return null;
    }
    return "## " + containerTitle + "\n\n" + sections.join("\n\n");
}

/**
 * Several files imported at once, as the one Lith they were meant to be.
 *
 * Every page of every document goes on one board in the order the gesture carried them, and
 * each page is named for the file it came from: a deck reads as `deck 1`, `deck 2`, and a
 * picture beside it reads as `photo`, which is what makes the page menu a table of contents
 * rather than a row of identical page numbers.
 *
 * The board height is portrait if any page is. A page too tall for the viewer is worse than
 * margins around one that fits, and the taller height is what a full portrait page needs.
 */
function mergedDocumentTiddlers(documents) {
    var pages = [];
    documents.forEach(function(doc) {
        doc.pages.forEach(function(page, index) {
            pages.push({
                filename: page.filename,
                dataUri: page.dataUri,
                width: page.width,
                height: page.height,
                name: doc.pages.length > 1 ? doc.title + " " + (index + 1) : doc.title
            });
        });
    });
    if (!pages.length) {
        return [];
    }

    var containerTitle = $tw.wiki.generateNewTitle(documents[0].title);
    var tiddlers = [];
    var children = [];

    var body = mergedTextBody(containerTitle, documents);
    if (body) {
        var textTitle = $tw.wiki.generateNewTitle(containerTitle + "-text");
        tiddlers.push({
            title: textTitle,
            parent: containerTitle,
            text: body,
            type: "text/x-markdown",
            "stream-type": "default"
        });
        children.push(textTitle);
    }

    var boardTitle = $tw.wiki.generateNewTitle(containerTitle + "-whiteboard");
    var portrait = pages.some(function(page) { return page.height > page.width; });
    tiddlers.push({
        title: boardTitle,
        parent: containerTitle,
        text: JSON.stringify(generateWhiteboardData(pages)),
        type: "application/tldr",
        "stream-type": "default",
        "whiteboard-height": portrait ? "1056px" : "540px"
    });
    children.push(boardTitle);

    tiddlers.unshift({
        title: containerTitle,
        "stream-list": $tw.utils.stringifyList(children),
        "stream-type": "default",
        text: ""
    });
    return tiddlers;
}

/**
 * Say what an import brought, and put that list at the top of the story river.
 *
 * This is the engine's own import confirmation, because a drop is an import and the containers
 * it made are worth naming. Published for the launcher's queued gesture as well: that one can
 * land in a Lith the person is already reading, where opening a board over it would take a view
 * they did not ask to lose, so the list is the whole of what says the pages arrived.
 */
function reportImportedTitles(titles) {
    if (!titles || !titles.length) {
        return;
    }
    var importList = titles.map(function(t) { return "# [[" + t + "]]"; }).join("\n");
    $tw.wiki.addTiddler(new $tw.Tiddler(
        $tw.wiki.getCreationFields(),
        $tw.wiki.getModificationFields(),
        {
            title: "$:/Import",
            text: "The following tiddlers were imported:\n\n" + importList,
            status: "complete"
        }
    ));
    var storyTiddler = $tw.wiki.getTiddler("$:/StoryList");
    var storyList = storyTiddler ? ($tw.utils.parseStringArray(storyTiddler.fields.list) || []) : [];
    storyList = storyList.filter(function(t) { return t !== "$:/Import"; });
    storyList.unshift("$:/Import");
    $tw.wiki.addTiddler(new $tw.Tiddler({
        title: "$:/StoryList",
        list: $tw.utils.stringifyList(storyList)
    }));
}

// The render path, published for the one other caller: a PDF the desktop app was asked to
// open by file association. The launcher cannot render a PDF (the renderer lives in this
// wiki), so it mounts a blank Lith with a request tiddler naming the file and a reader for
// its bytes; `pdf-open-request.js` takes that and calls this, so a double-click and a drop
// produce the same tiddlers from the same code.
$tw.lithic = $tw.lithic || {};
$tw.lithic.convertPdfToTiddlers = convertPdfDataToTiddlers;
// The same handoff for an image, which the desktop app also opens by association.
$tw.lithic.convertImageToTiddlers = convertImageDataToTiddlers;
// And for a book, which it opens the same way: the launcher cannot unzip an EPUB either, so the
// bytes travel and the converter above does the work in this wiki.
$tw.lithic.convertEpubToTiddlers = convertEpubToTiddlers;
// And for a Word document, which is the same shape of handoff for the same reason: unpacking one
// is this reader's job, and the launcher has no reader at all.
$tw.lithic.convertDocxToTiddlers = convertDocxToTiddlers;
// The pieces a gesture carrying several files is built from, published for the handoff in
// `pdf-open-request.js`: the same readers the one-file paths use, so a selection dropped on the
// launcher and a double-click cannot produce two different documents.
$tw.lithic.readPdfPages = readPdfPages;
$tw.lithic.readPicturePage = readPicturePage;
$tw.lithic.mergeDocumentTiddlers = mergedDocumentTiddlers;
// And the confirmation both routes show, so a queued import into a Lith that is already open
// says what arrived in the same words a drop does.
$tw.lithic.reportImportedTitles = reportImportedTitles;

exports.startup = function() {
    var alertTitle = "$:/temp/alerts/lithic-import-progress";
    function setProgress(msg) {
        $tw.wiki.addTiddler(new $tw.Tiddler({
            title: alertTitle,
            text: msg,
            component: "import-handler",
            tags: "$:/tags/Alert",
            modified: new Date()
        }));
    }
    function clearProgress() {
        $tw.wiki.deleteTiddler(alertTitle);
    }

    function loadImage(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUri = e.target.result;
                const img = new Image();
                img.onload = function() {
                    resolve({
                        filename: file.name,
                        dataUri: dataUri,
                        imgElement: img,
                        width: img.width,
                        height: img.height
                    });
                };
                img.onerror = function(err) {
                    reject(new Error("Failed to load image structure"));
                };
                img.src = dataUri;
            };
            reader.onerror = function(err) {
                reject(new Error("Failed to read file"));
            };
            reader.readAsDataURL(file);
        });
    }

    /**
     * One dropped picture as a page: decoded once to learn its size, and re-encoded as WebP for
     * the reason a PDF's page is, the asset living inside the Lith. An SVG is passed through
     * untouched, since a canvas would rasterise it.
     */
    function readImagePage(file) {
        return loadImage(file).then(function(img) {
            if (file.type !== "image/svg+xml" && !file.name.toLowerCase().endsWith(".svg")) {
                const canvas = document.createElement("canvas");
                const context = canvas.getContext("2d");
                canvas.width = img.width;
                canvas.height = img.height;
                context.drawImage(img.imgElement, 0, 0);

                img.dataUri = canvas.toDataURL("image/webp", 0.75);
                img.filename = img.filename.replace(/\.[^/.]+$/, "") + ".webp";
            }
            return {
                filename: img.filename,
                dataUri: img.dataUri,
                width: img.width,
                height: img.height
            };
        });
    }

    // One-way Jupyter notebook import: cells become a nodestream under a
    // container tiddler (code cells fenced so the ephemeral coderunner can
    // run them; stream/error outputs become marked child tiddlers). Shape
    // mirrors the launcher scratch-editor's .ipynb representation.
    function notebookCellSource(source) {
        if (Array.isArray(source)) return source.join("");
        return typeof source === "string" ? source : "";
    }

    function convertNotebookToTiddlers(file) {
        return file.text().then(function(text) {
            const nb = JSON.parse(text);
            if (!nb || !Array.isArray(nb.cells)) throw new Error("Not a Jupyter notebook");
            const languageInfo = nb.metadata && nb.metadata.language_info;
            const language = (languageInfo && typeof languageInfo.name === "string" && languageInfo.name.trim()) ? languageInfo.name.trim() : "python";
            const baseTitle = file.name.replace(/\.ipynb$/i, "");
            const containerTitle = $tw.wiki.generateNewTitle(baseTitle);
            const tiddlers = [];
            const cellTitles = [];
            let cellIndex = 0;
            nb.cells.forEach(function(cell) {
                const cellType = cell.cell_type || "raw";
                const source = notebookCellSource(cell.source);
                const cellTitle = $tw.wiki.generateNewTitle(containerTitle + " " + (++cellIndex));
                const fields = {
                    title: cellTitle,
                    parent: containerTitle,
                    type: "text/markdown",
                    "stream-type": "default",
                    text: cellType === "code" ? "```" + language + "\n" + source.replace(/\n$/, "") + "\n```" : source
                };
                if (cellType === "raw") fields["lithic-ipynb-raw"] = "yes";
                const childTitles = [];
                (cellType === "code" ? (cell.outputs || []) : []).forEach(function(out) {
                    let outText = null;
                    let isTrace = false;
                    if (out.output_type === "stream") {
                        outText = notebookCellSource(out.text);
                    } else if (out.output_type === "error") {
                        outText = Array.isArray(out.traceback) ? out.traceback.join("\n") : String(out.evalue || "");
                        isTrace = true;
                    } else if (out.output_type === "execute_result" || out.output_type === "display_data") {
                        const plain = (out.data || {})["text/plain"];
                        outText = Array.isArray(plain) ? plain.join("") : (typeof plain === "string" ? plain : null);
                    }
                    if (outText && outText.trim() !== "") {
                        const outTitle = $tw.wiki.generateNewTitle(containerTitle + " " + (++cellIndex));
                        tiddlers.push({
                            title: outTitle,
                            parent: cellTitle,
                            type: "text/markdown",
                            "stream-type": "default",
                            text: isTrace ? "```\n" + outText + "\n```" : outText,
                            "lithic-ipynb-output": "yes"
                        });
                        childTitles.push(outTitle);
                    }
                });
                if (childTitles.length > 0) fields["stream-list"] = $tw.utils.stringifyList(childTitles);
                tiddlers.push(fields);
                cellTitles.push(cellTitle);
            });
            tiddlers.push({
                title: containerTitle,
                "stream-list": $tw.utils.stringifyList(cellTitles),
                "stream-type": "default",
                text: "",
                "lithic-ipynb": "yes",
                "lithic-ipynb-meta": JSON.stringify({ metadata: nb.metadata || {}, nbformat: nb.nbformat || 4, nbformat_minor: nb.nbformat_minor || 5 })
            });
            return tiddlers;
        });
    }

    async function handleFiles(files, event) {
        const pdfFiles = Array.from(files).filter(f => f.type === "application/pdf" || f.name.toLowerCase().endsWith(".pdf"));
        const imageFiles = Array.from(files).filter(f => f.type.startsWith("image/"));
        const notebookFiles = Array.from(files).filter(f => f.type === "application/x-ipynb+json" || f.name.toLowerCase().endsWith(".ipynb"));
        const epubFiles = Array.from(files).filter(f => f.type === "application/epub+zip" || f.name.toLowerCase().endsWith(".epub"));
        const docxFiles = Array.from(files).filter(f => f.type === DOCX_MIME || f.name.toLowerCase().endsWith(".docx"));
        if (pdfFiles.length > 0 || imageFiles.length > 0 || notebookFiles.length > 0 || epubFiles.length > 0 || docxFiles.length > 0) {
            // We found a file this handler converts, so intercept this event completely
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();

            // If it was a drop, dismiss the TW dropzone UI by manually clearing the dragover classes
            if (event.type === "drop") {
                var dropzones = document.querySelectorAll(".tc-dragover");
                for (var i = 0; i < dropzones.length; i++) {
                    dropzones[i].classList.remove("tc-dragover");
                }
            }

            try {
                var createdTitles = [];
                // One gesture, one Lith. A selection holding more than one picture or PDF is
                // one board made of every page and one text extract of every word, in the order
                // the files arrived, rather than a Lith per file opened one by one.
                var together = Array.from(files).filter(function(file) {
                    return pdfFiles.includes(file) || imageFiles.includes(file);
                });
                var asOne = together.length > 1;
                if (asOne) {
                    var documents = [];
                    for (const file of together) {
                        if (pdfFiles.includes(file)) {
                            var pdfRead = await readPdfPages(await file.arrayBuffer(), file.name, setProgress);
                            documents.push({
                                title: file.name.replace(/\.pdf$/i, ""),
                                fileName: file.name,
                                pages: pdfRead.pages,
                                texts: pdfRead.texts
                            });
                        } else {
                            setProgress("Converting " + file.name + " to whiteboard...");
                            documents.push({
                                title: file.name.replace(/\.[^/.]+$/, ""),
                                fileName: file.name,
                                pages: [await readImagePage(file)],
                                texts: []
                            });
                        }
                    }
                    setProgress("Building one whiteboard from " + documents.length + " documents...");
                    for (const fields of mergedDocumentTiddlers(documents)) {
                        $tw.wiki.addTiddler(new $tw.Tiddler(
                            $tw.wiki.getCreationFields(),
                            $tw.wiki.getModificationFields(),
                            fields
                        ));
                        if (!fields.parent) { // It's the container
                            createdTitles.push(fields.title);
                        }
                    }
                }

                for (const file of (asOne ? [] : pdfFiles)) {
                    const arrayBuffer = await file.arrayBuffer();
                    const tiddlers = await convertPdfDataToTiddlers(arrayBuffer, file.name, setProgress);
                    
                    // Add tiddlers to the wiki
                    for (const fields of tiddlers) {
                        $tw.wiki.addTiddler(new $tw.Tiddler(fields));
                        if (!fields.parent) { // It's the container
                            createdTitles.push(fields.title);
                        }
                    }
                }

                for (const file of docxFiles) {
                    setProgress("Importing " + file.name + " as a document...");
                    const arrayBuffer = await file.arrayBuffer();
                    const tiddlers = await convertDocxToTiddlers(arrayBuffer, file.name, setProgress);
                    for (const fields of tiddlers) {
                        $tw.wiki.addTiddler(new $tw.Tiddler(
                            $tw.wiki.getCreationFields(),
                            $tw.wiki.getModificationFields(),
                            fields
                        ));
                        if (!fields.parent) { // It's the container
                            createdTitles.push(fields.title);
                        }
                    }
                }

                for (const file of notebookFiles) {
                    setProgress("Importing " + file.name + " as a nodestream...");
                    const tiddlers = await convertNotebookToTiddlers(file);
                    for (const fields of tiddlers) {
                        $tw.wiki.addTiddler(new $tw.Tiddler(
                            $tw.wiki.getCreationFields(),
                            $tw.wiki.getModificationFields(),
                            fields
                        ));
                        if (!fields.parent) { // It's the container
                            createdTitles.push(fields.title);
                        }
                    }
                }

                for (const file of epubFiles) {
                    setProgress("Importing " + file.name + " as a book...");
                    const arrayBuffer = await file.arrayBuffer();
                    const book = await convertEpubToTiddlers(arrayBuffer, file.name, setProgress);
                    for (const fields of book.tiddlers) {
                        $tw.wiki.addTiddler(new $tw.Tiddler(
                            $tw.wiki.getCreationFields(),
                            $tw.wiki.getModificationFields(),
                            fields
                        ));
                    }
                    // A book is entered at its first chapter; the rest is a step away.
                    createdTitles.push(book.entry);
                }

                for (const file of (asOne ? [] : imageFiles)) {
                    setProgress("Converting " + file.name + " to whiteboard...");
                    const img = await readImagePage(file);

                    // Apply unique title logic if name is "image.png"
                    let title = file.name;
                    if (title === "image.png") {
                        title = $tw.utils.formatDateString(new Date(), "image_YYYY-0MM-0DD_0hh:0mm:0XXX.png");
                    }
                    title = $tw.wiki.generateNewTitle(title);

                    const payload = generateWhiteboardData([img]);
                    const isPortrait = img.height > img.width;
                    const wbHeight = isPortrait ? "1056px" : "540px";

                    const wbTiddlerFields = {
                        title: title,
                        text: JSON.stringify(payload),
                        type: "application/tldr",
                        "stream-type": "default",
                        "whiteboard-height": wbHeight
                    };

                    $tw.wiki.addTiddler(new $tw.Tiddler(
                        $tw.wiki.getCreationFields(),
                        $tw.wiki.getModificationFields(),
                        wbTiddlerFields
                    ));
                    createdTitles.push(title);
                }

                clearProgress();

                // Copy imported linked references to the clipboard
                if (createdTitles.length > 0) {
                    var clipboardText = createdTitles.map(function(t) { return "[[" + t + "]]"; }).join("\n");
                    if ($tw.utils && $tw.utils.copyToClipboard) {
                        $tw.utils.copyToClipboard(clipboardText);
                    } else if (navigator.clipboard) {
                        navigator.clipboard.writeText(clipboardText).catch(function(err) {
                            console.error("Clipboard failed:", err);
                        });
                    }
                }

                // Say what arrived and put that list at the top of the river. The same call the
                // launcher's queued gesture makes: a drop and an import into a Lith the person
                // was already reading are one confirmation rather than two wordings of it.
                reportImportedTitles(createdTitles);

                // Handle other (non-PDF/image/notebook) files that were part of the same selection
                const otherFiles = Array.from(files).filter(f => !pdfFiles.includes(f) && !imageFiles.includes(f) && !notebookFiles.includes(f) && !epubFiles.includes(f) && !docxFiles.includes(f));
                if (otherFiles.length > 0) {
                    $tw.utils.each(otherFiles, function(file) {
                        $tw.utils.deserializeTiddlers(file.type, file, {}, function(tiddlers) {
                            $tw.rootWidget.dispatchEvent({type: "tm-import-tiddlers", tiddlers: tiddlers});
                        });
                    });
                }

            } catch (err) {
                clearProgress();
                console.error("Import processing error:", err);
                setProgress("Failed to convert file: " + err.message);
            }
        }
    }

    // Intercept drops
    document.addEventListener("drop", function(event) {
        if (event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files.length > 0) {
            handleFiles(event.dataTransfer.files, event);
        }
    }, true); 

    // Intercept the native Import button (and any other file inputs)
    document.addEventListener("change", function(event) {
        if (event.target.tagName === "INPUT" && event.target.type === "file" && event.target.files && event.target.files.length > 0) {
            handleFiles(event.target.files, event);
        }
    }, true);

    // Intercept paste
    document.addEventListener("paste", function(event) {
        if (event.clipboardData && event.clipboardData.files && event.clipboardData.files.length > 0) {
            handleFiles(event.clipboardData.files, event);
        }
    }, true);
};

})();