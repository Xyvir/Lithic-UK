description: show `application/tldr` type tiddlers in full screen whiteboard
name: White Board
tags: $:/tags/Layout
title: $:/plugins/linonetwo/tw-whiteboard/tiddlywiki-ui/PageLayout/WhiteBoard

\whitespace trim
\define containerClasses()
tc-page-container tc-page-view-$(storyviewTitle)$ tc-language-$(languageTitle)$ tw-whiteboard-layout-container
\end
\import [[$:/core/ui/PageMacros]] [all[shadows+tiddlers]tag[$:/tags/Macro]!has[draft.of]]

<$vars
	tv-config-toolbar-icons={{$:/config/Toolbar/Icons}}
	tv-config-toolbar-text={{$:/config/Toolbar/Text}}
	tv-config-toolbar-class={{$:/config/Toolbar/ButtonClass}}
	tv-show-missing-links={{$:/config/MissingLinks}}
	storyviewTitle={{$:/view}}
	languageTitle={{{ [{$:/language}get[name]] }}}
	currentBoard={{{ [[$:/state/Whiteboard/PageLayout/tiddler]get[text]] ~[all[shadows+tiddlers]field:type[application/tldr]!prefix[$:/temp]sort[modified]first[]] }}}>

<div class=<<containerClasses>>>

<style>
/* Prevent horizontal scrolling from wide tooltips overflowing the screen edges */
body { overflow-x: hidden; }
</style>

<$navigator story="$:/StoryList" history="$:/HistoryList" openLinkFromInsideRiver={{$:/config/Navigation/openLinkFromInsideRiver}} openLinkFromOutsideRiver={{$:/config/Navigation/openLinkFromOutsideRiver}} relinkOnRename={{$:/config/RelinkOnRename}}>

<main class="tw-whiteboard-layout-main-area">
	<$reveal state="$:/state/Whiteboard/PageLayout/tiddler" type="nomatch" text="">
		<$whiteboard tiddler={{$:/state/Whiteboard/PageLayout/tiddler}} height="100vh" />
	</$reveal>
	<!-- default value, when first opened, select widget's state tiddler is empty, but default value filter gives a value, we show that tiddler -->
	<$reveal state="$:/state/Whiteboard/PageLayout/tiddler" type="match" text="">
		<$list filter='[all[shadows+tiddlers]field:type[application/tldr]sort[modified]first[]]'>
			<$whiteboard tiddler={{{[all[shadows+tiddlers]field:type[application/tldr]sort[modified]first[]]}}} height="100vh" />
		</$list>
	</$reveal>
	<!-- Floating Comptext UI -->
	<$reveal state="$:/state/Whiteboard/ComptextPopup" type="match" text="open">
		<div class="lithic-floating-comptext-wrapper" style="position:fixed; top:45%; left:50%; margin-left: -125px; margin-top: -30px; z-index: 999999; width: 250px; max-width: 90vw;">
			<style>
			.lithic-floating-comptext-wrapper { position: relative; }
			.lithic-floating-comptext-wrapper .tc-block-dropdown.ect-block-dropdown {
				top: 100% !important;
				left: 0 !important;
				margin-top: 5px !important;
				position: absolute !important;
				width: 100% !important;
				max-width: 100% !important;
			}
			</style>
			<$keyboard key="Escape" actions="<$action-setfield $tiddler='$:/state/Whiteboard/ComptextPopup' text='closed'/>">
				<$keyboard key="Enter" actions="<$action-dispatch-paste tiddler='$:/temp/whiteboard-comptext-input'/><$action-setfield $tiddler='$:/state/Whiteboard/ComptextPopup' text='closed'/>">
					<$edit-comptext tag="input" tiddler="$:/temp/whiteboard-comptext-input" field="text" class="tc-edit-texteditor lithic-floating-comptext-input" placeholder="Type command or link..." style="width: 100%; border: 1px solid #ccc; padding: 8px; font-size: 1.2em; outline: none; box-sizing: border-box; background: var(--tw-page-bg, white); box-shadow: 0 4px 10px rgba(0,0,0,0.1); border-radius: 4px;" />
				</$keyboard>
			</$keyboard>
		</div>
	</$reveal>
</main>

<!-- put this below main, so nav bar is layered on top of the main. In UI, this nav in on the top of the page. -->
<nav class="tw-whiteboard-layout-top-bar">
	<!-- Searchable combobox replacing standard select -->
	<span style="position:relative; display:inline-flex; align-items:center;" onmousedown="event.stopPropagation();" onpointerdown="event.stopPropagation();" onclick="event.stopPropagation();">
		


		<$let
			searchState="$:/state/Whiteboard/PageLayout/search"
			dropdownState="$:/state/Whiteboard/PageLayout/dropdown"
			currentBoard={{{ [[$:/state/Whiteboard/PageLayout/tiddler]get[text]] ~[all[shadows+tiddlers]field:type[application/tldr]!prefix[$:/temp]sort[modified]first[]] }}}
		>
			<$keyboard key="Escape" actions="<$action-deletetiddler $tiddler=<<dropdownState>>/><$action-setfield $tiddler=<<searchState>> text=''/>">
				<style>
				.lithic-wb-search-input { color: <<colour muted-foreground>> !important; }
				.lithic-wb-search-input::placeholder { color: <<colour foreground>> !important; opacity: 1; }
				</style>
				<div style="display:flex; border: 1px solid #ccc; background: var(--tw-page-bg, white); align-items: stretch; border-radius: 3px;">
					<$keyboard key="Enter" actions="""
						<$let searchTerm={{{ [<searchState>get[text]] }}}>
							<$list filter="[all[shadows+tiddlers]field:type[application/tldr]!prefix[$:/temp]search:title<searchTerm>!sort[modified]limit[1]]">
								<$action-setfield $tiddler="$:/state/Whiteboard/PageLayout/tiddler" text=<<currentTiddler>>/>
								<$action-deletetiddler $tiddler=<<dropdownState>>/>
								<$action-setfield $tiddler=<<searchState>> text=""/>
							</$list>
						</$let>
					""">
						<$edit-text 
							tiddler=<<searchState>> 
							tag="input" 
							placeholder={{{ [<currentBoard>!is[blank]then<currentBoard>] ~[[Search boards...]] }}}
							default="" 
							class="tc-edit-texteditor lithic-wb-search-input" 
							style="width: 230px; padding: 4px 6px; border: none; outline: none; background: transparent; box-shadow: none;"
						/>
					</$keyboard>
					<$button class="tc-btn-invisible" style="padding: 2px 8px; border-left: 1px solid #ccc; cursor: pointer; display: flex; align-items: center; justify-content: center; fill: currentColor;">
						<$list filter="[<dropdownState>get[text]match[open]]" emptyMessage="<$action-setfield $tiddler=<<dropdownState>> text='open'/><span style='width:1em; height:1em;'>{{$:/core/images/down-arrow}}</span>">
							<$action-deletetiddler $tiddler=<<dropdownState>>/>
							<span style="width:1em; height:1em;">{{$:/core/images/up-arrow}}</span>
						</$list>
					</$button>
				</div>

				<$list filter="[<dropdownState>get[text]match[open]] [<searchState>get[text]!is[blank]] +[limit[1]then[show]]" variable="ignore">
					<div style="position:absolute; top:100%; left:0; z-index:9999; margin-top: 2px;">
						<div class="tc-drop-down" style="min-width: 250px; max-height: 400px; overflow-y: auto;">
							<$let searchTerm={{{ [<searchState>get[text]] }}}>
								<$list filter="[all[shadows+tiddlers]field:type[application/tldr]!prefix[$:/temp]search:title<searchTerm>!sort[modified]limit[10]]">
									<$button class="tc-btn-invisible" style="display:block; width:100%; text-align:left; padding: 4px 8px;">
										<$action-setfield $tiddler="$:/state/Whiteboard/PageLayout/tiddler" text=<<currentTiddler>>/>
										<$action-deletetiddler $tiddler=<<dropdownState>>/>
										<$action-setfield $tiddler=<<searchState>> text=""/>
										<$view field="title"/>
									</$button>
								</$list>
							</$let>
						</div>
					</div>
				</$list>
			</$keyboard>
		</$let>
	</span>

	<$reveal state="$:/state/Whiteboard/PageLayout/tiddler" type="nomatch" text="">
		<$button tooltip="Open In StoryView">
			{{$:/core/images/home-button}}
			<$action-setfield $tiddler="$:/layout" text="$:/core/ui/PageTemplate"/>
		</$button>
	</$reveal>
	<!-- default value, when first opened, select widget's state tiddler is empty, but default value filter gives a value, we show that tiddler -->
	<$reveal state="$:/state/Whiteboard/PageLayout/tiddler" type="match" text="">
		<$list filter='[all[shadows+tiddlers]field:type[application/tldr]!prefix[$:/temp]sort[modified]first[]]'>
			<$button tooltip="Open In StoryView">
				{{$:/core/images/home-button}}
				<$action-setfield $tiddler="$:/layout" text="$:/core/ui/PageTemplate"/>
				<$action-navigate $to={{{[all[shadows+tiddlers]field:type[application/tldr]!prefix[$:/temp]sort[modified]first[]]}}} />
			</$button>
		</$list>
	</$reveal>

	<$button tooltip="New Whiteboard" popup="$:/state/Whiteboard/PageLayout/CreateNewTiddlerPopup">
		{{$:/core/images/new-button}}
	</$button>
	<$reveal type="popup" state="$:/state/Whiteboard/PageLayout/CreateNewTiddlerPopup">
		{{$:/plugins/linonetwo/tw-whiteboard/tiddlywiki-ui/PageLayout/CreateNewTiddlerPopup}}
	</$reveal>

	<span class="lithic-wb-save-btn">
		<$button tooltip="Print Sequential Whiteboard" class="tc-btn-invisible">
			{{$:/core/images/print-button}}
			<$vars currentBoard={{{ [[$:/state/Whiteboard/PageLayout/tiddler]get[text]] ~[all[shadows+tiddlers]field:type[application/tldr]!prefix[$:/temp]sort[modified]first[]] }}}>
				<$vars wbHeight={{{ [<currentBoard>get[whiteboard-height]] ~[[540px]] }}}>
					<$action-setfield $tiddler="$:/layout" text="" />
					<$action-setfield $tiddler="$:/StoryList" list="" />
					<$action-setfield $tiddler="Print Sequential Whiteboard" text={{{ [[<<draw-sequential "]] [<currentBoard>] [[" "]] [<wbHeight>] [[">><$trigger-print delay="1000" />]] +[join[]] }}} />
					<$action-navigate $to="Print Sequential Whiteboard" />
				</$vars>
			</$vars>
		</$button>
	</span>

	<span class="lithic-wb-save-btn">{{$:/core/ui/Buttons/save-wiki}}</span>
</nav>

{{$:/plugins/tobibeer/preview/popups}}
</$navigator>

</div>

</$vars>