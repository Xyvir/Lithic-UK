tags: $:/tags/Stylesheet
title: $:/Lithic/Patches/Whiteboard/SaveButtonStyle
type: text/css

/* Ensure the save-wiki button in the whiteboard top bar
   matches the size and pill styling of the adjacent buttons */

.lithic-wb-save-btn {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin: 0 1px;
}

.lithic-wb-save-btn button {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 3.2em !important;
    height: 2.0em !important;
    border-radius: 1.0em !important;
    background: #373d44 !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    cursor: pointer;
    padding: 0 !important;
    box-sizing: border-box !important;
}

.lithic-wb-save-btn button:hover {
    background: #4a5159 !important; /* Slightly lighter on hover */
}

/* Scale up the SVG icon inside */
.lithic-wb-save-btn button svg {
    width: 1.2em;
    height: 1.2em;
}

/* Hide the broken Font selector in the Tldraw style menu */
#TD-Styles-Font-Container {
    display: none !important;
}



/* Comptext injected stickies are ALWAYS transparent (targeted via 'c001' UUID suffix) */
div[id$="c001"][data-shape="sticky"] .c-gLGcPs {
    background-color: transparent !important;
    text-shadow: none !important;
    box-shadow: none !important;
}

/* Replace the 'Insert Media' button icon with a Command Palette icon */
#TD-PrimaryTools-Image svg {
    display: none !important;
}

#TD-PrimaryTools-Image .c-lkmCgW::after {
    content: ":>/";
    font-family: monospace;
    font-size: 14px;
    font-weight: bold;
    color: currentColor;
    display: inline-block;
    line-height: 1;
}

