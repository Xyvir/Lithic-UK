/*\
title: $:/Lithic/Widgets/multi-wb-image.js
type: application/javascript
module-type: widget

A widget to extract and display images from a list of whiteboard tiddlers.
\*/
(function(){

/*jslint node: true, browser: true */
/*global $tw: false */
"use strict";

var Widget = require("$:/core/modules/widgets/widget.js").widget;

var MultiWbImageWidget = function(parseTreeNode,options) {
	this.initialise(parseTreeNode,options);
};

/*
Inherit from the base widget class
*/
MultiWbImageWidget.prototype = new Widget();

/*
Render this widget into the DOM
*/
MultiWbImageWidget.prototype.render = function(parent,nextSibling) {
	this.parentDomNode = parent;
	this.computeAttributes();
	this.execute();
    
    var container = this.document.createElement("div");
    container.className = this.className || "multi-wb-image-container";
    
    for (var i = 0; i < this.boardTitles.length; i++) {
        var boardTitle = this.boardTitles[i];
        var imgNode = this.document.createElement("img");
        
        if(this.width) {
            imgNode.setAttribute("width", this.width);
        }
        if(this.height) {
            imgNode.setAttribute("height", this.height);
        }
        
        var src = this.extractImageSrc(boardTitle);
        if(src) {
            imgNode.setAttribute("src", src);
        } else {
            imgNode.setAttribute("alt", "Whiteboard image not found: " + boardTitle);
            imgNode.style.border = "1px dashed red";
            imgNode.style.display = "inline-block";
            if (!this.width) imgNode.style.width = "100px";
            if (!this.height) imgNode.style.height = "100px";
        }
        container.appendChild(imgNode);
    }

	parent.insertBefore(container,nextSibling);
	this.domNodes.push(container);
};

MultiWbImageWidget.prototype.extractImageSrc = function(boardTitle) {
    var tiddler = this.wiki.getTiddler(boardTitle);
    if (!tiddler || !tiddler.fields.text) return null;
    try {
        var doc = JSON.parse(tiddler.fields.text);
        if (doc && doc.document && doc.document.assets) {
            var assets = doc.document.assets;
            for (var id in assets) {
                var asset = assets[id];
                if (asset.type === "image") {
                    return asset.src;
                }
            }
        }
    } catch(e) {
        console.error("MultiWbImageWidget parse error", e);
    }
    return null;
};

/*
Compute the internal state of the widget
*/
MultiWbImageWidget.prototype.execute = function() {
	var boardsText = this.getAttribute("boards") || this.getAttribute("text") || this.getAttribute("list") || "";
    
    var titles = [];
    var lines = boardsText.split("\n");
    for(var i=0; i<lines.length; i++) {
        var line = lines[i].trim();
        if(!line) continue;
        if(line.startsWith("[[") && line.endsWith("]]")) {
            titles.push(line.substring(2, line.length - 2));
        } else {
            titles.push(line);
        }
    }
    
	this.boardTitles = titles;
	this.width = this.getAttribute("scale") || this.getAttribute("width", "80%");
	this.height = this.getAttribute("height");
    this.className = this.getAttribute("class");
};

/*
Selectively refreshes the widget if needed. Returns true if the widget or any of its children needed re-rendering
*/
MultiWbImageWidget.prototype.refresh = function(changedTiddlers) {
	var changedAttributes = this.computeAttributes();
	if(changedAttributes.scale || changedAttributes.boards || changedAttributes.text || changedAttributes.list || changedAttributes.width || changedAttributes.height || changedAttributes["class"]) {
		this.refreshSelf();
		return true;
	}
    if (this.boardTitles) {
        for (var i = 0; i < this.boardTitles.length; i++) {
            if (changedTiddlers[this.boardTitles[i]]) {
                this.refreshSelf();
                return true;
            }
        }
    }
	return false;
};

exports["multi-wb-image"] = MultiWbImageWidget;
exports["multi.wb.image"] = MultiWbImageWidget;

})();
