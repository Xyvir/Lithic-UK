title: $:/Lithic/Patches/Whiteboard/WriteBehind.js
type: application/javascript
module-type: startup

/*
title: $:/Lithic/Patches/Whiteboard/WriteBehind.js
type: application/javascript
module-type: startup

Write-behind buffer for whiteboard (application/tldr) tiddlers.

The linonetwo/tw-whiteboard widget writes the entire board JSON back to the
wiki store on every (500ms-debounced) stroke and dispatches tm-auto-save-wiki,
which serializes the ENTIRE wiki store whenever autosave is enabled. As the
wiki grows, every stroke pays O(wiki size) in serialization cost.

This patch decouples the board's working memory from the store, following the
same model as the native "edit tiddler" dialog: the whiteboard's state is
transient and is only written back to the tiddler (and thus to the wiki file
on save) when the user actually saves the wiki or closes the board.

1. Text writes to application/tldr tiddlers are buffered in memory instead of
   hitting the store, so strokes fire no change events and never dirty the wiki.
2. The buffer is flushed BEFORE any real wiki save (tm-save-wiki /
   tm-auto-save-wiki) by hooking the root widget's dispatchEvent, so the
   serializer always includes the latest board state.
3. The buffer is flushed on pagehide/beforeunload as a crash safety net (this
   also covers the board's final unmount write when the app closes).

Camera moves are view state, not content (see "View state" below).

View state:
tldraw keeps the camera, the selection and the current page in `pageStates`,
and bumps a top-level `updatedCount` on every store change, so panning a board,
zooming it or flipping through an imported PDF looks exactly like drawing one
to a text-level diff. Entering the layout is enough to produce such a write:
the board normalizes its document on mount and the first-visit fit moves the
camera. Those writes used to flush immediately (the widget dispatches
tm-auto-save-wiki right after its own save), stamping `modified`, firing a
change event and marking the whole wiki dirty, which is wrong for what is
really a read: a board used as a picture viewer dirtied the wiki just by being
looked at.

`document.name` belongs in that set for the same reason, and it is what a fresh
import hits: the widget sets it to the tiddler's title on every change, so a
board whose document still carries the importer's name looked like an edit on
its first open in the layout. The title is the name of record and the widget
re-derives this one, so it is never authored, and it is written with the next
real save like the camera.

So a buffered write whose document is unchanged once `updatedCount`,
`pageStates` and `document.name` are left out is held as view state instead.

- A save that is happening anyway (the wiki is already dirty, or the reader
  pressed Save) carries the camera along, so the board comes back where it was
  left.
- A save that has nothing else to write does not, so panning and zooming never
  dirty the wiki by themselves.

Trade-offs (strict mode):
- Until the wiki is saved, other consumers of the board tiddler (<$wb-image>
   widgets, the comptext paste bridge, other open boards) see the last saved
   state, not live strokes. Use the whiteboard layout's Save button to commit.
- A hard crash before a save loses strokes made since the last save.
- A view-only change (camera, selection, current page, the document's derived
   name) is written on the next real save, not immediately.
*/
(function(){
"use strict";

exports.name = "lithic-whiteboard-write-behind";
exports.platforms = ["browser"];
exports.after = ["startup"];
exports.synchronous = true;

exports.startup = function() {
	if(typeof window === "undefined" || typeof $tw === "undefined") {
		return;
	}

	// title -> the latest text the board asked us to write
	var buffer = {};
	// title -> true when that text differs from what was known only in view state
	var viewOnly = {};
	var originalSetText = $tw.wiki.setText.bind($tw.wiki);

	function isWhiteboard(title) {
		var tiddler = $tw.wiki.getTiddler(title);
		return !!(tiddler && tiddler.fields.type === "application/tldr");
	}

	function hasBuffered(title) {
		return Object.prototype.hasOwnProperty.call(buffer,title);
	}

	// What the board was last seen holding, so a change can be judged against
	// the latest one rather than against the store's older copy.
	function knownText(title) {
		return hasBuffered(title) ? buffer[title] : $tw.wiki.getTiddlerText(title,"");
	}

	// The document with everything that is not content left out: tldraw's own
	// change counter, the per-page view state (camera, selection, current page)
	// and `document.name`, which the widget re-derives from the tiddler title on
	// every change. A replacer serializes the rest in one pass, so what is
	// compared is exactly the board's content however the keys were ordered.
	function contentOf(text) {
		var parsed;
		try {
			parsed = JSON.parse(text);
		} catch(e) {
			return null;
		}
		if(!parsed || typeof parsed !== "object") {
			return null;
		}
		return JSON.stringify(parsed,function(key,value) {
			if(key === "updatedCount" || key === "pageStates") {
				return undefined;
			}
			// `this` is the object holding the key, so this drops the document's own
			// name and leaves every shape's and page's alone.
			if(key === "name" && this === parsed.document) {
				return undefined;
			}
			return value;
		});
	}

	function isViewOnly(previous,next) {
		if(!previous) {
			return false;
		}
		var before = contentOf(previous),
			after = contentOf(next);
		return before !== null && after !== null && before === after;
	}

	// Is the wiki already carrying changes a save would write? A camera move is
	// then free to ride along, because the file is being rewritten anyway.
	function saveHasContent() {
		return !$tw.saverHandler || typeof $tw.saverHandler.isDirty !== "function" || $tw.saverHandler.isDirty();
	}

	function flushBuffer(flushViewState) {
		var titles = Object.keys(buffer);
		if(titles.length === 0) {
			return;
		}
		var heldText = {},
			heldViewOnly = {};
		for(var i = 0; i < titles.length; i++) {
			var title = titles[i];
			if(!flushViewState && viewOnly[title]) {
				heldText[title] = buffer[title];
				heldViewOnly[title] = true;
				continue;
			}
			var text = buffer[title];
			delete buffer[title];
			delete viewOnly[title];
			if(!$tw.wiki.tiddlerExists(title)) {
				continue; // board was deleted before the flush
			}
			try {
				originalSetText(title, undefined, undefined, text);
			} catch(e) {
				console.error("[Lithic] Whiteboard write-behind flush failed for " + title, e);
			}
		}
		// Put held view state back, unless a write landed on that board while we
		// were flushing (it would already carry the newer document).
		for(var heldTitle in heldText) {
			if(hasBuffered(heldTitle)) {
				continue;
			}
			buffer[heldTitle] = heldText[heldTitle];
			viewOnly[heldTitle] = heldViewOnly[heldTitle];
		}
	}

	// 1. Buffer text writes to whiteboard tiddlers; everything else passes through.
	$tw.wiki.setText = function() {
		var title = arguments[0],
			field = arguments[1],
			value = arguments[3];
		if(typeof value !== "string" || !isWhiteboard(title)) {
			return originalSetText.apply(null, arguments);
		}
		// Text writes to a whiteboard are buffered (the heavy per-stroke path).
		if(!field || field === "text") {
			viewOnly[title] = isViewOnly(knownText(title),value);
			buffer[title] = value;
			return;
		}
		// The widget re-writes `type` on every save; if it is already the same
		// value, skip it entirely so the per-stroke write cannot stamp a new
		// `modified` timestamp (which would fire a change event and dirty the wiki).
		if(field === "type" && $tw.wiki.getTiddler(title).fields.type === value) {
			return;
		}
		return originalSetText.apply(null, arguments);
	};

	// 2. Flush before any real wiki save so the serializer sees the latest board.
	function installSaveHook() {
		if(!$tw.rootWidget || $tw.rootWidget.__lithicWriteBehindHooked) {
			return;
		}
		$tw.rootWidget.__lithicWriteBehindHooked = true;
		var originalDispatch = $tw.rootWidget.dispatchEvent;
		$tw.rootWidget.dispatchEvent = function(event) {
			if(event && event.type === "tm-save-wiki") {
				flushBuffer(true);
			} else if(event && event.type === "tm-auto-save-wiki") {
				// The board dispatches this after every camera move too, so only a
				// save with something else to write carries the camera with it.
				flushBuffer(saveHasContent());
			}
			return originalDispatch.call(this, event);
		};
	}
	installSaveHook();
	if(!$tw.rootWidget) {
		var tries = 0;
		var hookTimer = setInterval(function() {
			tries++;
			installSaveHook();
			if($tw.rootWidget || tries > 100) {
				clearInterval(hookTimer);
			}
		}, 50);
	}

	// 3. Crash safety net: flush on page teardown, where the page is leaving and
	// a held camera can no longer dirty anything the reader will see.
	window.addEventListener("pagehide", function() { flushBuffer(true); });
	window.addEventListener("beforeunload", function() { flushBuffer(true); });
};

})();