tags: $:/tags/Stylesheet
title: $:/Lithic/Patches/Whiteboard/PageNavStyle
type: text/css

/* Prev/next page buttons beside the tldraw page-select dropdown,
   mounted by $:/Lithic/Patches/Whiteboard/PageNav.js */

.lithic-wb-page-prev,
.lithic-wb-page-next {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 38px !important;
    height: 30px !important;
    margin: 0 2px !important;
    padding: 0 !important;
    box-sizing: border-box;
    position: relative !important;
    top: 5px !important;
    border: 1px solid transparent;
    border-radius: 4px !important;
    background-color: transparent !important;
    color: inherit;
    cursor: pointer;
}

.lithic-wb-page-prev:hover:not(:disabled),
.lithic-wb-page-next:hover:not(:disabled) {
    background-color: rgba(var(--lithic-c-foreground-rgb), 0.22) !important;
}

.lithic-wb-page-prev:active:not(:disabled),
.lithic-wb-page-next:active:not(:disabled) {
    background-color: rgba(var(--lithic-c-foreground-rgb), 0.32) !important;
}

.lithic-wb-page-prev:disabled,
.lithic-wb-page-next:disabled {
    opacity: 0.35;
    cursor: default;
}

/* Both glyphs are always in the DOM; :disabled picks which one shows. */
.lithic-wb-page-prev .lithic-wb-glyph,
.lithic-wb-page-next .lithic-wb-glyph {
    display: inline-flex;
    line-height: 0;
}

.lithic-wb-page-prev .lithic-wb-glyph-dot,
.lithic-wb-page-next .lithic-wb-glyph-dot {
    display: none;
}

.lithic-wb-page-prev:disabled .lithic-wb-glyph-chevron,
.lithic-wb-page-next:disabled .lithic-wb-glyph-chevron {
    display: none;
}

.lithic-wb-page-prev:disabled .lithic-wb-glyph-dot,
.lithic-wb-page-next:disabled .lithic-wb-glyph-dot {
    display: inline-flex;
}

.lithic-wb-page-prev .lithic-wb-glyph-chevron svg,
.lithic-wb-page-next .lithic-wb-glyph-chevron svg {
    display: block;
    width: 18px;
    height: 18px;
}

.lithic-wb-page-prev .lithic-wb-glyph-dot svg,
.lithic-wb-page-next .lithic-wb-glyph-dot svg {
    display: block;
    width: 10px;
    height: 10px;
}

/* Touch pointers: this menu panel and the layout's own 400px bar are layered
   over the same top strip as tldraw's right-hand cluster (undo/redo/zoom/
   styles), and on a phone there is not room for all three side by side. Two
   collisions have to be undone without moving anything on a desktop, where
   there is room for all of them.

   First: the page arrows sat behind that bar (the bar is layered over the
   board), so the last two panel items were unclickable. They move to a second
   line below the panel. They are taken out of the flow rather than given a
   grid row, because the panel shares its flex row with the right-hand cluster:
   any in-flow child that grows makes the row taller and stretches that cluster
   with it, so one extra line on the left was silently growing undo/redo on the
   right. Positioned absolutely under the panel they add no height, and
   overflow:visible lets them show below the panel's own 41px box. */
@media (pointer: coarse) {
    #TD-MenuPanel {
        position: relative !important;
        height: 41px !important;
        overflow: visible !important;
    }

    /* The inline row only needed the 5px nudge up because the row itself was
       40px tall; on their own line the buttons sit flush and use margins. */
    .lithic-wb-page-prev,
    .lithic-wb-page-next {
        position: absolute !important;
        top: 41px !important;
        margin: 4px 2px !important;
    }

    .lithic-wb-page-prev {
        left: 0 !important;
    }

    .lithic-wb-page-next {
        left: 42px !important;
    }
}

/* Second: that bar is centred at width:400px, so on a landscape phone narrower
   than about 844px its right end covers undo/redo. It starts just right of the
   panel instead and is capped so it stops short of the cluster's 222px, which
   leaves the space next to the panel as the only place the bar can live. The
   board search field is the one item that flexes, so the fixed buttons beside
   it never spill back over the cluster.

   124px clears the widest page label a board is likely to reach - the panel
   measures 99px at "Page 1" and grows about a pixel per character, so even
   "Page 1234" stays clear of the bar. */
@media (pointer: coarse) and (max-width: 1024px) {
    .tw-whiteboard-layout-top-bar {
        box-sizing: border-box !important;
        left: 124px !important;
        width: auto !important;
        max-width: calc(100% - 356px) !important;
        justify-content: flex-start !important;
    }

    .tw-whiteboard-layout-top-bar > span:first-child {
        flex: 0 1 auto;
        min-width: 0;
    }

    /* The search field carries an inline 230px width, so it cannot shrink on
       its own - measured from the viewport it stays inside the bar's cap and
       never slides over the buttons beside it. */
    .lithic-wb-search-input {
        width: min(230px, calc(100vw - 574px)) !important;
    }
}

/* A short landscape phone (iPhone SE and friends) cannot give the board search
   field a width worth having beside the four buttons, so the field steps aside
   and leaves them all at full size. The dropdown arrow next to it still opens
   the board list. */
@media (pointer: coarse) and (max-width: 620px) {
    .lithic-wb-search-input {
        display: none !important;
    }
}