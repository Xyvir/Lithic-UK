title: $:/plugins/tw-jspython/jspython/style
tags: $:/tags/Stylesheet
type: text/css

/* IDE Container */
.tiddler-jspython-ide-container {

  &:where(.tc-single-tiddler-window &){
    position:fixed;
    inset:0;
    display: flex;
    flex-direction: column;
    margin:1ch;
    overflow-y: scroll;
  }
	
	/* Base editor constraints */
  .local-editor {
    cursor: text;
    min-width: 100%;
    min-height: 10lh;
  }

  .tc-edit-texteditor-body {
    flex: 1;
    width: 100%;
    min-height: 200px;
    box-sizing: border-box;
    font-family: monospace;
    border: 1px solid <<colour tiddler-editor-border>>;
    background-color: <<colour tiddler-editor-background>>;
    border-radius: 4px;
    font-size: 14px;
  }
  
  .tc-edit-texteditor-body .unieditor {
    border: none; /* remove unieditor's internal border since we wrapped it */
  }

  .uni-preview-toggle {
    display: none !important;
  }

  .tiddler-ide-btns {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;

    [class*="-btn"] {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 20px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      text-decoration: none;
      transition: all 0.2s ease;
      /* Smooth hover effect */
    }

    .run-btn {
      background-color: <<colour primary>>;
      color: <<colour background>>;
      border: 1px solid <<colour primary>>;
      font-weight: bold;

      &:hover {
        filter: brightness(0.9);
      }
    }

    .clear-btn {
      background-color: <<colour button-background>>;
      color: <<colour button-foreground>>;
      border: 1px solid <<colour button-border>>;
      fill: currentColor;
      line-height: 18px;

      &:hover {
        background-color: <<colour background>>;
        filter: brightness(0.9);
      }
    }
  }

  .console-output {
    margin-top: 15px;

    >label {
      display: block;
      font-size: 0.8em;
      font-weight: bold;
      color: <<colour muted-foreground>>;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }

    .local-console {
      width: 100%;
      box-sizing: border-box;
      min-height: 100px;
      background: <<colour pre-background>>;
      color: <<colour code-foreground>>;
      border: 1px solid <<colour pre-border>>;
      padding: 12px;
      border-radius: 4px;
      overflow-x: auto;
      white-space: pre-wrap;
      margin: 0;
      text-shadow: none;
      font-family: monospace;
    }
  }
}
