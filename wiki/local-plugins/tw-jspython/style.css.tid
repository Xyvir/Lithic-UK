title: $:/plugins/tw-jspython/jspython/style
tags: $:/tags/Stylesheet
type: text/css

/* IDE Container */
.tiddler-jspython-ide-container {

  &:where(.tc-single-tiddler-window &){
    position:fixed;
    inset:0;
    display: flex;
    flex-direction: column;
    margin:1ch;
    overflow-y: scroll;
  }
	
	/* Base editor constraints */
  .CodeMirror,
  .local-editor {
    cursor: text;
    min-width: 100%;
    min-height: 10lh;
    height: 100%;
    overflow-y: scroll;
  }


  .local-editor{
    flex: 1;
    width: 100%;
    box-sizing: border-box;
    height: 200px;
    font-family: monospace;
    border: 1px solid #aaa;
    border-radius: 4px;
    font-size: 14px;
    resize: vertical;
  }

  .tiddler-ide-btns {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;

    [class*="-btn"] {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 20px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      text-decoration: none;
      transition: background-color 0.2s ease;
      /* Smooth hover effect */
    }

    .run-btn {
      background-color: #f7df1e;
      color: #333;
      border: none;
      font-weight: bold;

      &:hover {
        background-color: #d1bc19;
      }
    }

    .clear-btn {
      background-color: #eee;
      color: #333;
      border: 1px solid #ccc;
      fill: currentColor;
      line-height: 18px;

      &:hover {
        background-color: #ddd;
      }
    }
  }

  .console-output {
    margin-top: 15px;

    >label {
      display: block;
      font-size: 0.8em;
      font-weight: bold;
      color: #555;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }

    .local-console {
      width: 100%;
      box-sizing: border-box;
      min-height: 100px;
      background: #222;
      color: #f7df1e;
      padding: 12px;
      border-radius: 4px;
      overflow-x: auto;
      white-space: pre-wrap;
      margin: 0;
      text-shadow: none;
      font-family: monospace;
    }
  }
}
