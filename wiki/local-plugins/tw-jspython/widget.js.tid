/*\
title: $:/plugins/xyvir/tw-jspython/widget.js
type: application/javascript
module-type: widget

A widget to dynamically load and execute JSpython.
\*/
(function(){
"use strict";

var Widget = require("$:/core/modules/widgets/widget.js").widget;

class ActionJSPythonWidget extends Widget {
    render(parent, nextSibling) {
        this.computeAttributes();
        this.execute();
    }

    execute() {
        this.jspythonCode = this.getAttribute("code");
        this.outputTarget = this.getAttribute("outputTarget");
        this.outputTiddler = this.getAttribute("outputTiddler");
    }

    refresh(changedTiddlers) {
        var changedAttributes = this.computeAttributes();
        if(changedAttributes.code || changedAttributes.outputTarget || changedAttributes.outputTiddler) {
            this.refreshSelf();
            return true;
        }
        return this.refreshChildren(changedTiddlers);
    }

    invokeAction(triggeringWidget, event) {
        var jsPythonModule = require("$:/plugins/xyvir/tw-jspython/jspython-interpreter.js");
        var jsPython = jsPythonModule.jsPython;
        
        var interpreter = jsPython();
        var self = this;
        var outputBuffer = [];
        
        // Expose useful DOM and TiddlyWiki APIs
        interpreter.assignGlobalContext({
            document: window.document,
            window: window,
            $tw: $tw,
            widget: self,
            console: window.console,
            eval_jspython: function(code) {
                return interpreter.evaluate(code);
            },
            print: function(...args) {
                if (self.outputTiddler) {
                    outputBuffer.push(args.join(" "));
                    return;
                }
                if (self.outputTarget) {
                    var out = window.document.querySelector(self.outputTarget);
                    if (out) {
                        out.innerText += args.join(" ") + "\n";
                        return;
                    }
                }
                console.log(...args);
            }
        });

        if (this.jspythonCode) {
            // Expand Tiddlywiki transclusions like {{TiddlerName}} or {{Tiddler!!field}}
            var codeToRun = this.jspythonCode.replace(/\{\{([^}]+)\}\}/g, function(match, textRef) {
                var ref = $tw.wiki.getTextReference(textRef, null, self.getVariable("currentTiddler"));
                return (ref !== null && ref !== undefined) ? ref : match;
            });

            try {
                if (this.outputTarget) {
                    var out = window.document.querySelector(this.outputTarget);
                    if (out) out.innerText = ""; // Clear output before running
                }
                
                var result = interpreter.evaluate(codeToRun);
                
                var handleFinish = function() {
                    if (self.outputTiddler) {
                        var outputText = "```\n" + outputBuffer.join("\n") + "\n```";
                        $tw.wiki.setText(self.outputTiddler, "text", null, outputText);
                        $tw.wiki.setText(self.outputTiddler, "type", null, "text/markdown");
                    }
                };

                if (result && typeof result.then === 'function') {
                    result.then(handleFinish).catch(function(e) {
                        console.error("JSpython async execution error:", e);
                        var errorMsg = "❌ Error: " + (e.message || e.toString());
                        if (self.outputTarget) {
                            var out = window.document.querySelector(self.outputTarget);
                            if (out) {
                                out.innerText += "\n" + errorMsg;
                            }
                        }
                        if (self.outputTiddler) {
                            outputBuffer.push(errorMsg);
                            var outputText = "```\n" + outputBuffer.join("\n") + "\n```";
                            $tw.wiki.setText(self.outputTiddler, "text", null, outputText);
                            $tw.wiki.setText(self.outputTiddler, "type", null, "text/markdown");
                        }
                    });
                } else {
                    handleFinish();
                }
            } catch (e) {
                console.error("JSpython execution error:", e);
                var errorMsg = "❌ Error: " + (e.message || e.toString());
                if (this.outputTarget) {
                    var out = window.document.querySelector(this.outputTarget);
                    if (out) {
                        out.innerText += "\n" + errorMsg;
                    }
                }
                if (this.outputTiddler) {
                    outputBuffer.push(errorMsg);
                    var outputText = "```\n" + outputBuffer.join("\n") + "\n```";
                    $tw.wiki.setText(this.outputTiddler, "text", null, outputText);
                    $tw.wiki.setText(this.outputTiddler, "type", null, "text/markdown");
                }
            }
        }
        return true; // Action was invoked
    }
}

exports["action-jspython"] = ActionJSPythonWidget;
})();
