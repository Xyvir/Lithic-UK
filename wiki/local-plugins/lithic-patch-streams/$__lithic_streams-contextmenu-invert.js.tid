type: application/javascript
module-type: startup

/*\
title: $:/lithic/streams-contextmenu-invert.js
type: application/javascript
module-type: startup

Keeps the streams context menu above everything drawn on the page.

Root cause, in two parts. TW renders a $reveal popup inside the widget that owns
it, so the menu is a DOM descendant of the stream row it was opened from. The
notebook theme then makes every story frame its own stacking context: position
relative with a z-index of 200 minus its nth-child index, so an earlier frame
outranks a later one. A z-index on the menu, however high, only orders it inside
the frame holding it, which is why a frame could be drawn over the whole menu, and
why a missing journal's placeholder stub painted in front of it.

Fix: promote the popup into the browser's top layer with the popover API, which is
painted above every stacking context and cannot be re-ordered by z-index.
popover="manual" leaves TW in charge of opening and closing the menu (no light
dismiss), and the DOM position is deliberately left alone: the hover preview in
$:/lithic/streams/styles/ctx-preview matches on the menu's ancestry
(.stream-root:has(.sq-contextmenu ...)), and TW removes the node through its live
parentNode, so nothing depends on where the node sits.

The menu still gets the fixed positioning and z-index below, both for browsers
without the popover API and as the state the promotion starts from.
\*/
(function(){
"use strict";

exports.name = "streams-contextmenu-invert";
exports.platforms = ["browser"];
exports.after = ["startup"];
exports.synchronous = true;

exports.startup = function() {

    // Hand the menu to the browser's top layer. Geometry is cleared first so the UA
    // popover box (inset 0 with auto margins) cannot move or centre it; the chrome
    // that box also brings is reset by .tc-popup[popover] in $:/lithic/streams-menu-fix.
    // Without the popover API the positioned fallback below is all there is, which is
    // the behaviour this module shipped before.
    function promoteToTopLayer(node) {
        if (typeof node.showPopover !== "function") return;
        try {
            node.setAttribute("popover","manual");
            if (!node.matches(":popover-open")) {
                node.showPopover();
            }
        } catch (err) {
            // Already open, or refused: the fixed positioning and z-index stand.
        }
    }

    function fixPopup(node) {
        if (node.nodeType !== 1 || !node.classList || !node.classList.contains("tc-popup")) return;
        if (!node.querySelector(".sq-contextmenu")) return;

        // If the element hasn't laid out yet, defer one frame and retry
        var rect = node.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) {
            requestAnimationFrame(function() { fixPopup(node); });
            return;
        }

        var sidebarWidth = 0;
        var sidebar = document.querySelector(".nc-sidebar");
        if (sidebar) sidebarWidth = sidebar.getBoundingClientRect().right;

        // Use current viewport coordinates as the basis for fixed positioning.
        // getBoundingClientRect() gives viewport-relative coords regardless of
        // how the element is currently positioned.
        var left = rect.left;
        var top  = rect.top;

        // Push right if the menu overlaps the sidebar
        if (left < sidebarWidth + 4) {
            left = sidebarWidth + 4;
        }

        // Push left if it overflows the right viewport edge
        if (left + rect.width > window.innerWidth - 4) {
            left = window.innerWidth - rect.width - 4;
        }

        // Push up if it overflows the bottom viewport edge
        if (top + rect.height > window.innerHeight - 4) {
            top = top - rect.height;
        }
        if (top < 4) top = 4;

        // Position at the corrected viewport coordinates, then promote. position:fixed
        // keeps the menu at those coordinates once it is in the top layer, which is
        // itself contained by the viewport.
        node.style.position = "fixed";
        node.style.inset    = "auto";
        node.style.margin   = "0";
        node.style.left     = left + "px";
        node.style.top      = top  + "px";
        node.style.zIndex   = "100000";
        promoteToTopLayer(node);
    }

    var observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.type === "childList") {
                mutation.addedNodes.forEach(function(node) {
                    fixPopup(node);
                });
            }
        });
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
};

})();