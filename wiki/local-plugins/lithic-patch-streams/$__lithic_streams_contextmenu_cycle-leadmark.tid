title: $:/lithic/streams/contextmenu/cycle-leadmark
tags: $:/tags/streams/contextmenu
sq-contextmenu-name: cycle leadmark
sq-contextmenu-name-children: cycle child leadmarks
sq-contextmenu-name-siblings: cycle sibling leadmarks
type: text/vnd.tiddlywiki

\whitespace trim
\define cycle-leadmark-mass()
<$vars
	todo1="[ ] "
	todo2="- [ ] "
	done1="[x] "
	done2="[X] "
	done3="- [x] "
	done4="- [X] "
	num1="<<num>> "
>
	<$let
		srcTodo={{{ [<source>tag[done]then<todo1>] ~[<done1>] }}}
		nextState={{{ [<source>get[text]prefix<num1>then[none]] ~[<source>get[text]prefix<done1>then<num1>] ~[<source>get[text]prefix<done2>then<num1>] ~[<source>get[text]prefix<done3>then<num1>] ~[<source>get[text]prefix<done4>then<num1>] ~[<source>get[text]prefix<todo1>then<srcTodo>] ~[<source>get[text]prefix<todo2>then<srcTodo>] ~[<todo1>] }}}
	>
		<$let
			t={{{ [<target>get[text]] }}}
			stripped={{{ [<t>removeprefix<todo1>] ~[<t>removeprefix<todo2>] ~[<t>removeprefix<done1>] ~[<t>removeprefix<done2>] ~[<t>removeprefix<done3>] ~[<t>removeprefix<done4>] ~[<t>removeprefix<num1>] ~[<t>] }}}
		>
			<$list filter="[<nextState>match[none]]" variable="_NULL">
				<$action-setfield $tiddler=<<target>> text=<<stripped>>/>
			</$list>
			<$list filter="[<nextState>!match[none]]" variable="_NULL">
				<$action-setfield $tiddler=<<target>> text={{{ [<stripped>addprefix<nextState>] }}}/>
			</$list>
			<$action-listops $tiddler=<<target>> $tags="-[[done]]"/>
		</$let>
	</$let>
</$vars>
\end

<$list filter="[<currentTiddler>get[stream-list]enlist-input[]is[tiddler]count[]!match[0]]" variable="_NULL">
	<$let source={{{ [<currentTiddler>get[stream-list]enlist-input[]is[tiddler]first[]] }}}>
		<$list filter="[enlist{!!stream-list}is[tiddler]]" variable="target">
			<<cycle-leadmark-mass>>
		</$list>
	</$let>
</$list>
<$list filter="[<currentTiddler>get[stream-list]enlist-input[]is[tiddler]count[]match[0]]" variable="_NULL">
	<$let source=<<currentTiddler>>>
		<$list filter="[<currentTiddler>get[parent]get[stream-list]enlist-input[]is[tiddler]count[]!match[0]]" variable="_NULL">
			<$set name="currentTiddler" filter="[<currentTiddler>get[parent]]" select="0">
				<$list filter="[enlist{!!stream-list}is[tiddler]]" variable="target">
					<<cycle-leadmark-mass>>
				</$list>
			</$set>
		</$list>
		<$list filter="[<currentTiddler>get[parent]get[stream-list]enlist-input[]is[tiddler]count[]match[0]]" variable="_NULL">
			<$list filter="[<currentTiddler>is[tiddler]]" variable="target">
				<<cycle-leadmark-mass>>
			</$list>
		</$list>
	</$let>
</$list>