title: $:/lithic/streams/contextmenu/cycle-leadmark
tags: $:/tags/streams/contextmenu
sq-contextmenu-name: cycle leadmark
type: text/vnd.tiddlywiki

\whitespace trim
\define cycle-leadmark-ops()
<$vars
	todo1="[ ] "
	todo2="- [ ] "
	done1="[x] "
	done2="[X] "
	done3="- [x] "
	done4="- [X] "
	num1="<<num>> "
>
	<$list filter="[<target>get[text]]" variable="t">
		<$list filter="[<t>prefix<num1>]" variable="_NULL">
			<$action-setfield $tiddler=<<target>> text={{{ [<t>removeprefix<num1>] }}}/>
			<$action-listops $tiddler=<<target>> $tags="-[done]"/>
		</$list>
		<$list filter="[<t>prefix<done1>] ~[<t>prefix<done2>] ~[<t>prefix<done3>] ~[<t>prefix<done4>]" variable="_NULL">
			<$action-setfield $tiddler=<<target>> text={{{ [<t>removeprefix<done1>addprefix<num1>] ~[<t>removeprefix<done2>addprefix<num1>] ~[<t>removeprefix<done3>addprefix<num1>] ~[<t>removeprefix<done4>addprefix<num1>] }}}/>
			<$action-listops $tiddler=<<target>> $tags="-[done]"/>
		</$list>
		<$list filter="[<t>prefix<todo1>] ~[<t>prefix<todo2>]" variable="_NULL">
			<$list filter="[<target>tag[done]]" variable="_NULL">
				<$action-listops $tiddler=<<target>> $tags="-[done]"/>
			</$list>
			<$list filter="[<target>!tag[done]]" variable="_NULL">
				<$action-setfield $tiddler=<<target>> text={{{ [<t>removeprefix<todo1>addprefix<done1>] ~[<t>removeprefix<todo2>addprefix<done1>] }}}/>
			</$list>
		</$list>
		<$list filter="[<t>!prefix<num1>!prefix<done1>!prefix<done2>!prefix<done3>!prefix<done4>!prefix<todo1>!prefix<todo2>]" variable="_NULL">
			<$action-setfield $tiddler=<<target>> text={{{ [<t>addprefix<todo1>] }}}/>
			<$action-listops $tiddler=<<target>> $tags="-[done]"/>
		</$list>
	</$list>
</$vars>
\end

<$list filter="[enlist{!!stream-list}is[tiddler]count[]!match[0]]" variable="_NULL" emptyMessage="""<$vars target=<<currentTiddler>>><<cycle-leadmark-ops>></$vars>""">
	<$list filter="[enlist{!!stream-list}is[tiddler]]" variable="target">
		<<cycle-leadmark-ops>>
	</$list>
</$list>