/*
title: $:/plugins/orange/mermaid-tw5/wrapper.js
type: application/javascript
module-type: widget
author: Nathaniel Jones 2017-05-26
modified: E Furlan 2022-05-08; Lithic 2026-09-14 (re-applied D3 pan/zoom from xyvir/lithic-patch-mermaid)
*/
(function() {
    // jslint node: true, browser: true
    // global $tw: false
    'use strict';

    var Rocklib = require('$:/plugins/orange/mermaid-tw5/widget-tools.js').rocklib,
        Widget = require('$:/core/modules/widgets/widget.js').widget,
        rocklib = new Rocklib(),
        mermaidModule = null,
        mermaidAPI = null,
        d3 = null,
        isZoomEnabled = false;

    function escapeHtml(text) {
        if (text === null || text === undefined) {
            return '';
        }
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function decodeHtmlEntities(text) {
        if (!text) return text;
        var el = document.createElement('textarea');
        el.innerHTML = text;
        return el.value !== undefined ? el.value : (el.innerHTML || text);
    }

    function getSimpleStack(ex) {
        if (!ex || !ex.stack) {
            return '';
        }
        var lines = String(ex.stack).split('\n');
        var frames = [];
        for (var i = 0; i < lines.length && frames.length < 3; i++) {
            var line = lines[i].trim();
            if (line.indexOf('at ') === 0) {
                var match = line.match(/at\s+(?:[^\s(]+\s+\()?([^)]+)\)?/);
                if (match) {
                    var loc = match[1];
                    var fileName = loc.split('/').pop().split(':')[0];
                    frames.push(fileName);
                }
            }
        }
        return frames.join('\n');
    }

    function cleanupStrayErrorSVGs() {
        if (typeof document === 'undefined') return;
        try {
            var errorSvgs = document.querySelectorAll('svg[aria-roledescription="error"], svg.error-icon');
            for (var i = 0; i < errorSvgs.length; i++) {
                if (errorSvgs[i] && errorSvgs[i].parentNode) {
                    errorSvgs[i].parentNode.removeChild(errorSvgs[i]);
                }
            }
        } catch (e) {}
    }

    // START ZOOM LOGIC: Enable zooming/panning the mermaid diagram with D3.
    // by fkmiec 2023-05-21 (originally shipped via xyvir/lithic-patch-mermaid on
    // the mm9 wrapper); re-applied here against the Mermaid 11 wrapper.
    // Click a diagram to toggle zoom/pan; re-click to release (so page scroll
    // and text selection are not hijacked while zoom is off).
    function hookupZoom(node) {
        try {
            if (!d3 || !node ||
                !node.firstChild || typeof node.firstChild.setAttribute !== 'function') {
                return;
            }
            var id = Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 7);
            node.firstChild.setAttribute('id', id);
            var svg = d3.select('#' + id);
            svg.html('<g>' + svg.html() + '</g>');
            var inner = svg.select('g');
            var zoom = d3.zoom().filter(function() { return isZoomEnabled; }).on('zoom', function(event) {
                inner.attr('transform', event.transform);
            });
            svg.call(zoom);
            node.addEventListener('click', function() {
                isZoomEnabled = !isZoomEnabled;
            });
        } catch (zoomErr) {
            console.error('[mermaid-tw5] zoom hookup error:', zoomErr);
        }
    }

    var SECURE_KEYS = ['secure', 'securityLevel', 'startOnLoad',
                       'maxTextSize', 'maxEdges', 'suppressErrorRendering'];

    var CONFIG_WHITELIST = [
        'theme', 'themeVariables', 'themeCSS', 'look', 'handDrawnSeed',
        'fontFamily', 'altFontFamily', 'fontSize', 'darkMode', 'wrap',
        'htmlLabels', 'markdownAutoWrap', 'logLevel',
        'arrowMarkerAbsolute', 'deterministicIds', 'deterministicIDSeed',
        'flowchart', 'sequence', 'gantt', 'pie', 'class', 'state', 'er',
        'journey', 'gitGraph', 'quadrantChart', 'xyChart', 'sankey',
        'timeline', 'mindmap', 'packet', 'block', 'architecture', 'kanban',
        'c4', 'requirement', 'radar',
        'securityLevel', 'maxTextSize', 'maxEdges', 'suppressErrorRendering'
    ];

    var NON_SECURE_INJECT_KEYS = ['theme', 'look', 'fontFamily', 'fontSize',
                                   'themeVariables', 'darkMode'];

    function buildSiteConfig() {
        var config = {
            startOnLoad: false,
            securityLevel: 'loose',
            suppressErrorRendering: true,
            deterministicIds: true,
            flowchart: { useMaxWidth: true, htmlLabels: true }
        };
        var configTitle = '$:/plugins/orange/mermaid-tw5/config';
        var data = $tw.wiki.getTiddlerData(configTitle, {});
        for (var k in data) {
            if (Object.prototype.hasOwnProperty.call(data, k) &&
                CONFIG_WHITELIST.indexOf(k) !== -1) {
                if (k === 'startOnLoad') continue;  // D-07: never allow override
                config[k] = data[k];                // shallow replace per D-04
            }
        }
        return config;
    }

    function buildPerWidgetInit(options) {
        var init = {};
        for (var i = 0; i < NON_SECURE_INJECT_KEYS.length; i++) {
            var k = NON_SECURE_INJECT_KEYS[i];
            if (options[k] !== undefined && options[k] !== '') {
                init[k] = options[k];
            }
        }
        return Object.keys(init).length > 0 ? init : null;
    }

    var MermaidWidget = function(parseTreeNode, options) {
        this.initialise(parseTreeNode, options);
    };
    MermaidWidget.prototype = new Widget();

    // Render this widget into the DOM
    MermaidWidget.prototype.render = function(parent, nextSibling) {
        this.parentDomNode = parent;
        this.computeAttributes();
        this.execute();
        var tag = 'mermaid',
            rawBody = rocklib.getScriptBody(this, 'text') || '',
            scriptBody = (typeof rawBody === 'string' ? rawBody : String(rawBody)).trim(),
            divNode = rocklib.getCanvas(this, tag);
        var _insertSVG = function(svgCode, bindFunctions) {
            divNode.innerHTML = svgCode;
            if (bindFunctions) {
                try {
                    bindFunctions(divNode);
                } catch (bfErr) {
                    console.error('[mermaid-tw5] bindFunctions error:', bfErr);
                }
            }
        };

        // Skip rendering during static HTML generation (Node.js build).
        // Mermaid 11 requires a browser DOM (document) to render diagrams.
        if (!$tw.browser) {
            divNode.innerHTML = '<div style="border-left:3px solid #2196F3;background:#e3f2fd;padding:8px 12px;">' +
                '<strong>Mermaid diagram</strong> (interactive rendering requires a browser)' +
                '</div>';
            parent.insertBefore(divNode, nextSibling);
            this.domNodes.push(divNode);
            return;
        }

        try {
            // Lazy-load mermaid and D3 on first render
            if (!mermaidAPI) {
                divNode.innerHTML = '<div style="border-left:3px solid #999;background:#f5f5f5;padding:8px 12px;">Loading diagram…</div>';
                var loadedLib = require('$:/plugins/orange/mermaid-tw5/mermaid.min.js');
                mermaidModule = (loadedLib && (loadedLib.mermaid || loadedLib.default || (typeof loadedLib.initialize === 'function' ? loadedLib : null)));
                if (!mermaidModule && typeof window !== 'undefined') {
                    mermaidModule = window.mermaid || (window.__esbuild_esm_mermaid_nm && (window.__esbuild_esm_mermaid_nm.default || window.__esbuild_esm_mermaid_nm.mermaid));
                }
                if (!mermaidModule) {
                    mermaidModule = loadedLib;
                }
                mermaidAPI = (mermaidModule && mermaidModule.mermaidAPI) ? mermaidModule.mermaidAPI : mermaidModule;
                d3 = require('$:/plugins/orange/mermaid-tw5/d3.v6.min.js');
                if (mermaidAPI && typeof mermaidAPI.initialize === 'function') {
                    mermaidAPI.initialize(buildSiteConfig());  // D-05: once per page load
                }
            }

            var options = {
                theme: ''
            };
            rocklib.getOptions(this, tag, options);

            scriptBody = decodeHtmlEntities(scriptBody).trim();
            // TiddlyWiki's WikiText parser converts -- to en-dash and --- to em-dash
            // in widget attribute values. Normalize them back for Mermaid arrow syntax.
            scriptBody = scriptBody.replace(/\u2013/g, '--').replace(/\u2014/g, '---');

            // D-02: inject per-widget non-secure config as %%{init}%% PREPENDED
            var perWidgetInit = buildPerWidgetInit(options);
            if (perWidgetInit) {
                scriptBody = '%%{init: ' + JSON.stringify(perWidgetInit) + '}%%\n' + scriptBody;
            }

            var renderDiagram = function() {
                var svgId = divNode.id + '_svg';
                
                // Mermaid 10/11 async render() is not thread-safe.
                // We must queue render requests to prevent concurrent execution.
                if (typeof window !== 'undefined') {
                    window.$tw_mermaid_queue = window.$tw_mermaid_queue || [];
                    window.$tw_mermaid_is_rendering = window.$tw_mermaid_is_rendering || false;
                }
                
                var queue = (typeof window !== 'undefined') ? window.$tw_mermaid_queue : [];
                
                var task = {
                    svgId: svgId,
                    scriptBody: scriptBody,
                    onSuccess: function(res) {
                        _insertSVG(res.svg, res.bindFunctions);
                        hookupZoom(divNode);
                    },
                    onError: function(ex) {
                        cleanupStrayErrorSVGs();
                        var errorHtml = '<div style="border-left:3px solid #ff4444;background:#fff0f0;padding:8px 12px;">' +
                            '<p><strong>Mermaid diagram could not be rendered.</strong> The diagram syntax may contain an error.</p>' +
                            '<pre style="margin:8px 0;padding:6px;background:#ffffff;border:1px solid #ffcccc;overflow:auto;">' +
                            escapeHtml(scriptBody) +
                            '</pre>' +
                            '<details>' +
                            '<summary style="cursor:pointer;color:#666;font-size:12px;">Technical details</summary>' +
                            '<p style="margin:8px 0 0 0;font-size:12px;"><strong>' + escapeHtml(ex.name || 'Error') + ':</strong> ' +
                            escapeHtml(ex.message || String(ex)) + '</p>' +
                            '<pre style="margin:4px 0 0 0;font-size:11px;overflow:auto;">' + escapeHtml(getSimpleStack(ex)) + '</pre>' +
                            '</details>' +
                            '</div>';
                        divNode.innerHTML = errorHtml;
                    }
                };

                var processQueue = function() {
                    if (typeof window === 'undefined') return;
                    if (window.$tw_mermaid_is_rendering || window.$tw_mermaid_queue.length === 0) return;
                    
                    window.$tw_mermaid_is_rendering = true;
                    var currentTask = window.$tw_mermaid_queue.shift();
                    
                    var result;
                    try {
                        result = mermaidAPI.render(currentTask.svgId, currentTask.scriptBody);
                    } catch (ex) {
                        currentTask.onError(ex);
                        window.$tw_mermaid_is_rendering = false;
                        setTimeout(processQueue, 0);
                        return;
                    }

                    if (result && typeof result.then === 'function') {
                        result.then(function(res) {
                            currentTask.onSuccess(res);
                        }).catch(function(err) {
                            currentTask.onError(err);
                        }).finally(function() {
                            window.$tw_mermaid_is_rendering = false;
                            setTimeout(processQueue, 0);
                        });
                    } else {
                        currentTask.onSuccess({ svg: result });
                        window.$tw_mermaid_is_rendering = false;
                        setTimeout(processQueue, 0);
                    }
                };

                if (typeof window !== 'undefined') {
                    window.$tw_mermaid_queue.push(task);
                    processQueue();
                } else {
                    // Fallback for node environment (though we abort earlier for node)
                    try {
                        var res = mermaidAPI.render(svgId, scriptBody);
                        if (res && res.then) res.then(task.onSuccess).catch(task.onError);
                        else task.onSuccess({ svg: res });
                    } catch (e) {
                        task.onError(e);
                    }
                }
            };

            try {
                renderDiagram();
            } catch (ex) {
                cleanupStrayErrorSVGs();
                throw ex;
            }

        } catch (ex) {
            cleanupStrayErrorSVGs();
            var errorHtml = '<div style="border-left:3px solid #ff4444;background:#fff0f0;padding:8px 12px;">' +
                '<p><strong>Mermaid diagram could not be rendered.</strong> The diagram syntax may contain an error.</p>' +
                '<pre style="margin:8px 0;padding:6px;background:#ffffff;border:1px solid #ffcccc;overflow:auto;">' +
                escapeHtml(scriptBody) +
                '</pre>' +
                '<details>' +
                '<summary style="cursor:pointer;color:#666;font-size:12px;">Technical details</summary>' +
                '<p style="margin:8px 0 0 0;font-size:12px;"><strong>' + escapeHtml(ex.name || 'Error') + ':</strong> ' +
                escapeHtml(ex.message || String(ex)) + '</p>' +
                '<pre style="margin:4px 0 0 0;font-size:11px;overflow:auto;">' + escapeHtml(getSimpleStack(ex)) + '</pre>' +
                '</details>' +
                '</div>';
            divNode.innerHTML = errorHtml;
        }
        parent.insertBefore(divNode, nextSibling);
        this.domNodes.push(divNode);
    };
    MermaidWidget.prototype.execute = function() {
        // Nothing to do
    };
    MermaidWidget.prototype.refresh = function(changedTiddlers) {
        return false;
    };
    exports.mermaid = MermaidWidget;
})();