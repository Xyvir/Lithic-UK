type: application/javascript
module-type: widget

/*
title: $:/plugins/orange/mermaid-tw5/wrapper.js
type: application/javascript
module-type: widget
author: Nathaniel Jones 2017-05-26
modified: Lithic 2026-10-19 (engine swap: diagrams render through the vendored pele engine instead of mermaid.js; pele owns layout, zoom controls and font-aware sizing; the Mermaid-only rocklib, d3 and render queue are gone; source handling and the self-heal ladder are unchanged)
*/
(function() {
    // jslint node: true, browser: true
    // global $tw: false
    'use strict';

    // Soft dependency: if the pele engine or the wiki core is missing, bail at
    // load time with a warning instead of aborting the whole TiddlyWiki boot.
    var Widget, pele;
    try {
        Widget = require('$:/core/modules/widgets/widget.js').widget;
        pele = require('$:/plugins/xyvir/lithic-patch-mermaid/pele.js').pele;
    } catch (bootDepErr) {
        console.warn('[lithic-patch-mermaid] pele engine not available; <$mermaid> disabled.');
        return;
    }

    var CONFIG_TITLE = '$:/plugins/orange/mermaid-tw5/config',
        DEFAULT_FONT = 'Vollkorn',
        uniqueID = 1;

    function escapeHtml(text) {
        if (text === null || text === undefined) {
            return '';
        }
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function decodeHtmlEntities(text) {
        if (!text) return text;
        var el = document.createElement('textarea');
        el.innerHTML = text;
        return el.value !== undefined ? el.value : (el.innerHTML || text);
    }

    // ---- ROBUST SOURCE EXTRACTION --------------------------------------
    // Decodes every entity (the upstream tree-walk only knew five and passed the
    // rest through as literal text, which then failed to parse) and keeps line
    // structure.
    function decodeEntity(entity) {
        if (!entity) return '';
        var named = {
            '&ndash;': '--',   // wikitext turns -- into en-dash; keep upstream heal
            '&mdash;': '---',  // same for ---
            '&gt;': '>', '&lt;': '<', '&amp;': '&', '&quot;': '"',
            '&nbsp;': ' ',
            '&lsquo;': "'", '&rsquo;': "'", '&sbquo;': "'",
            '&ldquo;': '"', '&rdquo;': '"',
            '&hellip;': '...', '&bull;': '*', '&middot;': '*',
            '&minus;': '-', '&lowast;': '*', '&plusmn;': '+/-'
        };
        if (named[entity] !== undefined) return named[entity];
        var m = /^&#(\d+);$/.exec(entity);
        if (m) {
            var code = parseInt(m[1], 10);
            if (code > 0 && code <= 0x10FFFF) {
                try { return String.fromCodePoint(code); } catch (e) {}
            }
        }
        m = /^&#x([0-9a-f]+);$/i.exec(entity);
        if (m) {
            var code2 = parseInt(m[1], 16);
            if (code2 > 0 && code2 <= 0x10FFFF) {
                try { return String.fromCodePoint(code2); } catch (e) {}
            }
        }
        // any other named entity: let the DOM decode it; unparseable stays literal
        try {
            var el = document.createElement('textarea');
            el.innerHTML = entity;
            if (el.value !== undefined && el.value !== '') return el.value;
        } catch (e) {}
        return entity;
    }

    function extractDiagramSource(widget) {
        var attr = widget.getAttribute('text', '');
        if (attr) return String(attr);
        var node = widget.parseTreeNode;
        if (!node) return '';
        if (typeof node.text === 'string') return node.text;
        if (!node.children || !node.children.length) return '';
        var out = '';
        var walk = function(nodes) {
            for (var i = 0; i < nodes.length; i++) {
                var n = nodes[i];
                if (!n) continue;
                if (n.type === 'text') { out += (n.text || ''); continue; }
                if (n.type === 'entity') { out += decodeEntity(n.entity); continue; }
                if (n.type === 'element') {
                    if (n.tag === 'br') { out += '\n'; continue; }
                    if (n.children && n.children.length) {
                        walk(n.children);
                        if (n.tag === 'div' || n.tag === 'p') out += '\n';
                    }
                    continue;
                }
                if (n.children && n.children.length) walk(n.children);
            }
        };
        walk(node.children);
        return out;
    }

    // ---- POISON-CHARACTER SANITIZER -------------------------------------
    // Diagram sources reach this widget via typing, paste, tiddler import and
    // markdown transclusion; those paths can leave invisible or typographic
    // characters the diagram grammar rejects. Each replacement maps such a
    // character onto its plain-ASCII meaning.
    function sanitizeDiagramSource(src) {
        if (!src) return src;
        var s = String(src);
        // BOM + line/paragraph separators -> plain newlines; CRLF -> LF
        s = s.replace(/^\uFEFF/, '').replace(/\u2028|\u2029/g, '\n').replace(/\r\n?/g, '\n');
        // zero-width characters and bidi controls (invisible paste artifacts)
        s = s.replace(/[\u200B-\u200D\u2060\uFEFF\u202A-\u202E\u2066-\u2069]/g, '');
        // every Unicode whitespace variant -> plain space
        s = s.replace(/[\u00A0\u1680\u2000-\u200A\u202F\u205F\u3000]/g, ' ');
        // C0 controls (except tab/newline) and DEL -- pure poison, no meaning
        s = s.replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g, '');
        // typographic punctuation the grammar never accepts
        s = s.replace(/\u2212/g, '-')
             .replace(/[\u2010\u2011]/g, '-')
             .replace(/[\u2018\u2019\u201B]/g, "'")
             .replace(/[\u201C\u201D]/g, '"')
             .replace(/\u2032/g, "'")
             .replace(/\u2033/g, '"')
             .replace(/\u2026/g, '...');
        return s;
    }

    // ---- SELF-HEAL RENDER LADDER -----------------------------------------
    // Attempt 1 is the sanitized source; attempt 2 (only if attempt 1 fails)
    // drops every %%{...}%% directive, since a malformed directive is the most
    // common hand-edit failure and default rendering beats an error box.
    function buildRenderAttempts(source) {
        var attempts = [{ label: 'sanitized', text: source }];
        if (/%%\{[\s\S]*?%%/.test(source)) {
            attempts.push({
                label: 'directives-stripped',
                text: source.replace(/%%\{[\s\S]*?}%%/g, '').trim()
            });
        }
        return attempts;
    }

    // Style gating: a diagram that declares its own styling keeps it. The
    // container gets `mm-user`, which opts it out of the palette defaults in
    // the stylesheet. Over-detection is safe: the diagram just keeps the
    // engine's own colours.
    function hasSelfStyling(source) {
        if (!source) return false;
        if (/%%\s*\{\s*(init|config)\s*:/i.test(source)) return true;
        if (/^\s*(style|classDef|linkStyle)\s+\S/m.test(source)) return true;
        return false;
    }

    // Site typeface: the Pyramid pins Vollkorn per widget; other diagrams read
    // the config tiddler and fall back to Vollkorn. Only a plain family name is
    // accepted, since it is handed to the measurer and to a CSS font list.
    function siteFontFamily() {
        var data = $tw.wiki.getTiddlerData(CONFIG_TITLE, {});
        var family = data && typeof data.fontFamily === 'string' ? data.fontFamily : '';
        return (/^[\w\s,'-]+$/.test(family) && family) || DEFAULT_FONT;
    }

    function errorBox(source, ex) {
        var name = (ex && ex.name) || 'Error';
        var message = (ex && ex.message) || String(ex);
        return '<div style="border-left:3px solid var(--lithic-c-code-warn);background:var(--lithic-c-note-bg);padding:8px 12px;">' +
            '<p><strong>Mermaid diagram could not be rendered.</strong> The diagram syntax may contain an error.</p>' +
            '<pre style="margin:8px 0;padding:6px;background:var(--lithic-c-code-bg);border:1px solid var(--lithic-c-code-border);overflow:auto;">' +
            escapeHtml(source) +
            '</pre>' +
            '<details>' +
            '<summary style="cursor:pointer;color:var(--lithic-c-foreground-muted);font-size:12px;">Technical details</summary>' +
            '<p style="margin:8px 0 0 0;font-size:12px;"><strong>' + escapeHtml(name) + ':</strong> ' +
            escapeHtml(message) + '</p>' +
            '</details>' +
            '</div>';
    }

    var MermaidWidget = function(parseTreeNode, options) {
        this.initialise(parseTreeNode, options);
    };
    MermaidWidget.prototype = new Widget();

    MermaidWidget.prototype.render = function(parent, nextSibling) {
        this.parentDomNode = parent;
        this.computeAttributes();
        this.execute();

        var rawBody = extractDiagramSource(this) || '';
        var source = String(rawBody).trim();
        // Entities first, then the dash repair TiddlyWiki's parser applies to
        // widget attribute values, then the poison-character pass.
        source = decodeHtmlEntities(source).trim();
        source = source.replace(/\u2013/g, '--').replace(/\u2014/g, '---');
        source = sanitizeDiagramSource(source).trim();

        var divNode = this.document.createElement('div');
        divNode.id = 'mermaid_' + (uniqueID++) + '_' + Math.random().toString(36).slice(2, 7);
        divNode.className = 'mm-themed' + (hasSelfStyling(source) ? ' mm-user' : '');
        // Visible version stamp for debugging: which wrapper drew this diagram?
        divNode.setAttribute('data-mmwrapver', '2026-10-19.pele');
        parent.insertBefore(divNode, nextSibling);
        this.domNodes.push(divNode);

        // Skip rendering during static HTML generation (Node.js build).
        if (!$tw.browser) {
            divNode.innerHTML = '<div style="border-left:3px solid var(--lithic-c-accent);background:var(--lithic-c-note-bg);padding:8px 12px;">' +
                '<strong>Mermaid diagram</strong> (interactive rendering requires a browser)' +
                '</div>';
            return;
        }

        var fontFamily = this.getAttribute('fontFamily', siteFontFamily());
        if (!/^[\w\s,'-]+$/.test(fontFamily)) fontFamily = DEFAULT_FONT;

        // pele.render is synchronous and throws a PeleError on bad syntax, so
        // the self-heal ladder can pick a source variant before anything is mounted.
        var attempts = buildRenderAttempts(source),
            chosen = null,
            lastError = null;
        for (var i = 0; i < attempts.length; i++) {
            try {
                pele.render(attempts[i].text, { fontFamily: fontFamily });
                chosen = attempts[i];
                break;
            } catch (renderErr) {
                lastError = renderErr;
                console.warn('[lithic-patch-mermaid] render failed (attempt: ' + attempts[i].label + ')');
            }
        }
        if (!chosen) {
            divNode.innerHTML = errorBox(source, lastError);
            return;
        }

        var self = this;
        var mountNow = function() {
            // Removed from the page before the fonts settled: nothing to draw into.
            if (self.mounted || !divNode.isConnected) return;
            try {
                self.mounted = pele.mount(divNode, chosen.text, {
                    fontFamily: fontFamily,
                    // Diagrams are static: no pele zoom buttons, and no wheel, pinch or keyboard zoom.
                    zoom: false,
                    onError: function(err) {
                        divNode.innerHTML = errorBox(source, err);
                    }
                });
            } catch (mountErr) {
                divNode.innerHTML = errorBox(source, mountErr);
            }
        };

        // Measure labels only once the webfont is loaded, so the measured box and
        // the painted label use the same face. Bounded by a 3s fallback.
        if (document.fonts && document.fonts.ready && typeof document.fonts.ready.then === 'function') {
            var started = false;
            var go = function() {
                if (started) return;
                started = true;
                mountNow();
            };
            try {
                if (document.fonts.load) {
                    document.fonts.load('16px ' + fontFamily, '0123456789');
                    document.fonts.load('16px ' + fontFamily, 'R(s)');
                }
            } catch (flErr) { /* font loading is best-effort */ }
            document.fonts.ready.then(go, go);
            setTimeout(go, 3000);
        } else {
            mountNow();
        }
    };

    // Tear the engine down before TiddlyWiki replaces this widget's DOM, so
    // pele's resize observer does not outlive the diagram it watches.
    MermaidWidget.prototype.removeChildDomNodes = function() {
        if (this.mounted) {
            try { this.mounted.destroy(); } catch (destroyErr) { /* already gone */ }
            this.mounted = null;
        }
        Widget.prototype.removeChildDomNodes.call(this);
    };

    MermaidWidget.prototype.execute = function() {
        // Nothing to do
    };

    exports.mermaid = MermaidWidget;
})();