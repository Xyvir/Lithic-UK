title: $:/plugins/orange/mermaid-tw5/styles
type: text/css

/* Theming for Mermaid diagrams drawn by the pele engine.

   pele reads its colours from --pele-* custom properties on the diagram's
   container. Those are mapped onto the palette's contrast roles here, so a
   palette switch re-themes every diagram without re-rendering it. Diagrams that
   declare their own styling (container class mm-user) keep their own colours on
   the parts the author styled, and pele's theme still covers the rest.

   The variables are read from the --lithic-c-* palette published by
   $:/plugins/xyvir/lithic-core/contrast-publisher.js. */

div.mm-themed {
    --pele-bg: var(--lithic-c-page);
    --pele-fg: var(--lithic-c-node-fg);
    --pele-muted: var(--lithic-c-foreground-muted);
    --pele-line: var(--lithic-c-line);
    --pele-surface: var(--lithic-c-node-bg);
    --pele-surface-alt: var(--lithic-c-cluster-bg);
    --pele-border: var(--lithic-c-node-border);
    --pele-accent: var(--lithic-c-accent);
    --pele-critical: var(--lithic-c-code-warn);
    --pele-error: var(--lithic-c-code-warn);
    --pele-radius: 4px;
}

/* =========================================================
   PRINT: greyscale for all mermaid diagrams

   Diagrams should never print palette colours. Redefining the
   --pele-* variables to print greys re-themes the whole diagram
   with no selector duplication, and the grayscale filter catches
   anything an author styled with explicit colours.
   ========================================================= */
@media print {
    div.mm-themed {
        --pele-bg: #ffffff;
        --pele-fg: #000000;
        --pele-muted: #444444;
        --pele-line: #000000;
        --pele-surface: #f2f2f2;
        --pele-surface-alt: #ffffff;
        --pele-border: #000000;
        --pele-accent: #000000;
        --pele-critical: #000000;
        --pele-error: #000000;
        background: #ffffff !important;
        filter: grayscale(1) !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
}