tags: $:/tags/Stylesheet
title: $:/plugins/richlink/richlink-styles
type: text/vnd.tiddlywiki

/* Palette-reactive styling for the richlink plugin.
   All colours come from the active TiddlyWiki palette via <<colour ...>>. */

/* ---- Generic richlink card shell ---- */

.rl-3dmodel,
.rl-iframe-card,
.rl-txt {
    display: block;
    max-width: 48em;
    margin: 0.35em 0;
    padding: 0.45em 0.55em;
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 0.45em;
    background: <<colour background>>;
    color: <<colour foreground>>;
}

.rl-3dmodel-header,
.rl-iframe-credit {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    line-height: 1.3;
    margin-bottom: 0.45em;
}

.rl-3dmodel-icon {
    color: <<colour muted-foreground>>;
    font-size: 0.9em;
}

.rl-3dmodel-link,
.rl-txt-fallback a {
    color: <<colour primary>>;
    text-decoration: none;
    word-break: break-word;
}

.rl-3dmodel-link:hover,
.rl-txt-fallback a:hover {
    text-decoration: underline;
}

/* ---- GitHub issue button ---- */

.gh-issue {
    display: inline;
    border: 1px solid <<colour tiddler-border>>;
    padding: 0px 0px 1px 5px;
    border-radius: 3px;
    margin-right: 5px;
    background: <<colour background>>;
}

.gh-issue a.tc-tiddlylink-external {
    color: <<colour foreground>>;
    text-decoration: none;
    font-size: 80%;
}

.gh-issue:hover a.tc-tiddlylink-external {
    color: <<colour primary>>;
    text-decoration: underline;
}

.gh-issue svg {
    width: .9em;
    vertical-align: -.65em;
    fill: currentColor;
}

/* ---- Wikipedia link ---- */

.rl-wikipedia {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    color: <<colour primary>>;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1.2;
}

.rl-wikipedia:hover .rl-wikipedia-title {
    text-decoration: underline;
}

.rl-wikipedia-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
    color: <<colour muted-foreground>>;
    transform: translateY(0.12em);
    flex: 0 0 auto;
}

.rl-wikipedia-icon svg {
    width: 1em;
    height: 1em;
    fill: currentColor;
    vertical-align: middle;
}

.rl-wikipedia-title {
    color: <<colour primary>>;
}

/* ---- TiddlyWiki docs button ---- */

.twd {
    display: inline;
    margin-right: 5px;
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 3px;
    padding: 1px 0px 1px 5px;
    background: <<colour background>>;
    font-size: 80%;
}

.twd a.tc-tiddlylink-external {
    color: <<colour foreground>>;
    text-decoration: none;
}

.twd a.tc-tiddlylink-external:hover {
    color: <<colour primary>>;
    text-decoration: underline;
}

.twd svg {
    width: 1em;
    vertical-align: bottom;
    fill: currentColor;
}

/* ---- Embedded media (YouTube / audio / video) ---- */

.rich-iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
}

.richlink-audio,
.richlink-video {
    width: 100%;
    display: block;
}

/* ---- Text card ---- */

.rl-txt-frame-wrap {
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 0.4em;
    overflow: hidden;
    background: <<colour page-background>>;
    color: <<colour foreground>> !important;
}

.rl-txt-body {
    margin: 0;
    padding: 0.6em 0.8em;
    max-height: 100%;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: inherit;
    font-size: 0.9em;
    line-height: 1.45;
    color: <<colour foreground>> !important;
    background: <<colour background>> !important;
}

.rl-txt-fallback {
    margin-top: 0.35em;
    font-size: 0.8em;
    color: <<colour muted-foreground>>;
    word-break: break-all;
}

/* ---- Image card ---- */

.richlink-img {
    display: inline-block;
    background: <<colour background>>;
    margin: 0 0 27px 30px;
    padding: 10px 10px 15px;
    text-align: center;
    text-decoration: none;
    color: <<colour foreground>>;
    font-size: 18px;
    box-shadow: 0 3px 6px rgba(0,0,0,.55);
}

.richlink-img a {
    display: block;
    text-decoration: none;
}

.richlink-img img {
    display: block;
    max-width: 100%;
    height: auto;
}

.richlink-img-caption {
    display: block;
    text-align: center;
    color: <<colour muted-foreground>>;
    font-size: 0.8em;
}

/* ---- Generic iframe card ---- */

.rl-iframe-credit,
.rl-iframe-title,
.rl-iframe-site,
.rl-iframe-by {
    color: <<colour muted-foreground>>;
    font-size: 13px;
}

.rl-iframe-title,
.rl-iframe-site {
    text-decoration: none;
}

.rl-iframe-title:hover,
.rl-iframe-site:hover {
    text-decoration: underline;
}

.rl-iframe-wrap {
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 0.4em;
    overflow: hidden;
    background: <<colour page-background>>;
}

.rl-iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
}

.rl-iframe-empty {
    color: <<colour muted-foreground>>;
    font-size: 0.9em;
}
