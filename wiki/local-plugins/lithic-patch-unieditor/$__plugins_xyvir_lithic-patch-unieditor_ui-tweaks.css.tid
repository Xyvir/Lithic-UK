/* UniEditor UI tweaks: border, background, hide scrollbars */

.unieditor {
	border: 1.5px solid <<colour primary>>;
	border-radius: 4px;
	background: <<colour tiddler-editor-fields-odd>>;
}
.unieditor textarea,
.unieditor textarea.unieditor__textarea,
.unieditor textarea.unieditor_controlwrap {
	caret-color: <<colour primary>> !important;
}

/* Override upstream .overflowy { overflow-y: scroll !important } —
   the textarea auto-expands so forced scroll is just visual clutter. */
.unieditor .overflowy {
	overflow-y: auto !important;
	scrollbar-width: none !important;
	-ms-overflow-style: none !important;
}
.unieditor .overflowy::-webkit-scrollbar {
	display: none !important;
}

/* --- Floating preview toggle button --- */
.uni-preview-toggle {
	position: absolute !important;
	top: 4px !important;
	right: 4px !important;
	left: auto !important;
	z-index: 10;
	background: transparent;
	border: none;
	cursor: pointer;
	opacity: 0.25;
	padding: 2px;
	width: 22px !important;
	height: 22px !important;
	line-height: 0;
	transition: opacity 0.2s ease;
}
.uni-preview-toggle:hover {
	opacity: 0.8;
}
.uni-preview-toggle p {
	margin: 0;
	padding: 0;
	line-height: 0;
}
.uni-preview-toggle svg {
	width: 100%;
	height: 100%;
	fill: <<colour foreground>>;
}

/* --- Streams Preview Wrapping --- */
.streams-unieditor-wrapper.preview-yes {
	border: 1.5px solid <<colour primary>>;
	border-radius: 4px;
	overflow: hidden;
	display: flex;
	flex-direction: column;
}
.streams-unieditor-wrapper.preview-yes .tc-edit-texteditor,
.streams-unieditor-wrapper.preview-yes .unieditor,
.streams-unieditor-wrapper.preview-yes .streams-editor,
.streams-unieditor-wrapper.preview-yes textarea {
	border-top-color: transparent !important;
	border-left-color: transparent !important;
	border-right-color: transparent !important;
	box-shadow: none !important;
	outline: none !important;
}
.streams-unieditor-wrapper.preview-yes .unieditor {
	border-bottom: 1px dashed <<colour tiddler-editor-border>> !important;
	border-bottom-left-radius: 0 !important;
	border-bottom-right-radius: 0 !important;
	/* Keep its darker shading */
}
.streams-unieditor-wrapper.preview-yes .streams-preview {
	background: <<colour background>>;
	margin-top: 0 !important;
	border-top: none !important;
	padding: 10px;
}

/* --- Streams Minimal Height --- */
.streams-unieditor-wrapper .tc-edit-texteditor,
.streams-unieditor-wrapper .unieditor,
.streams-unieditor-wrapper .unieditor textarea,
.streams-unieditor-wrapper .unieditor canvas,
.streams-unieditor-wrapper .unieditor .textlayer {
	min-height: 46px !important;
}

/* --- Ensure Embedded Highlights Don't Break Canvas Alignment --- */
.unieditor .md-code-block.hljs {
	display: inline !important;
	padding: 0 !important;
	margin: 0 !important;
	border: none !important;
	background: transparent !important;
	line-height: inherit !important;
	font-size: inherit !important;
	font-family: inherit !important;
}


/* --- CSS Hack for Line Numbers --- */
.streams-unieditor-wrapper {
    position: relative;
}
.streams-unieditor-wrapper::before {
    white-space: pre-wrap;
    position: absolute;
    top: 1.2em; /* Em-based vertical gap */
    left: -2.5em;
    bottom: 26px; /* Clip mask before checkmark! */
    width: 2em;
    overflow: hidden;
    text-align: right;
    font-family: monospace !important;
    color: <<colour primary>>;
    opacity: 0.8;
    pointer-events: none;
    user-select: none;
    
    font-size: 10px;
    line-height: 19.2px; 
    padding-top: 0;
}

/* Hide line numbers in preview mode */
.streams-unieditor-wrapper.preview-yes::before {
    display: none !important;
}
