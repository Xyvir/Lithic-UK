/*\
title: $:/plugins/xyvir/lithic-patch-unieditor/md-highlight.js
type: application/javascript
module-type: library

Styled markdown+wikitext highlighter for UniEditor canvas overlay.
Produces OverType-style rendering: bold is bold, italic is italic,
syntax markers are dimmed. Also highlights TiddlyWiki wikitext
constructs that are valid inside markdown (macros, links, embeds,
transcludes, KaTeX). Preserves character-for-character alignment.
\*/
(function(){

"use strict";

var hljsLib;
if (typeof window !== "undefined") hljsLib = window.hljs;
if (!hljsLib && typeof require !== "undefined") {
	try { hljsLib = require("$:/plugins/tiddlywiki/highlight/highlight.js"); } catch(e) {}
}


function htmlEscape(str) {
	return str
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;')
		.replace(/'/g, '&#39;');
}

// Wrap markdown markers in a dim span
function m(text) {
	return '<span class="md-marker">' + text + '</span>';
}

function parseInline(text) {
	// 1. Protect inline code spans first
	var codeSpans = [];
	text = text.replace(/`([^`\n]+)`/g, function(_match, content) {
		var idx = codeSpans.length;
		codeSpans.push('<span class="md-code">' + m('`') + content + m('`') + '</span>');
		return '\uE000' + idx + '\uE001';
	});

	// 2. KaTeX: matches both $$...$$ and $...$ in one pass
	text = text.replace(/(\${1,2})([^$\n]+?)\1/g, function(_match, delim, content) {
		return '<span class="md-katex">' + m(delim) + content + m(delim) + '</span>';
	});

	// 3. TiddlyWiki embeds/transcludes: matches both {{{...}}} and {{...}}
	text = text.replace(/(\{{2,3})([^{}]+?)(\}{2,3})/g, function(_match, open, content, close) {
		return '<span class="md-tw-embed">' + m(open) + content + m(close) + '</span>';
	});

	// 6. TiddlyWiki macros <<...>>
	text = text.replace(/&lt;&lt;(.+?)&gt;&gt;/g,
		'<span class="md-tw-macro">' + m('&lt;&lt;') + '$1' + m('&gt;&gt;') + '</span>');

	// 7. Images ![alt](url) — before links
	text = text.replace(/!\[([^\]]*)\]\(([^)]+)\)/g,
		'<span class="md-image">' + m('![') + '$1' + m('](') + '<span class="md-url">$2</span>' + m(')') + '</span>');

	// 8. Markdown links [text](url)
	text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g,
		'<span class="md-link">' + m('[') + '$1' + m('](') + '<span class="md-url">$2</span>' + m(')') + '</span>');

	// 9. TiddlyWiki links [[text]]
	text = text.replace(/\[\[([^\]]+)\]\]/g,
		'<span class="md-tw-link">' + m('[[') + '$1' + m(']]') + '</span>');

	// 10. #hashtag links (camelCase or hyphenated)
	text = text.replace(/(^|[\s(])#([a-zA-Z][a-zA-Z0-9_\-\/]*)/g,
		'$1<span class="md-tw-hashtag">' + m('#') + '$2</span>');

	// 11. Bold **text**
	text = text.replace(/\*\*(.+?)\*\*/g,
		'<span class="md-strong">' + m('**') + '$1' + m('**') + '</span>');

	// 12. Bold __text__
	text = text.replace(/__(.+?)__/g,
		'<span class="md-strong">' + m('__') + '$1' + m('__') + '</span>');

	// 13. Strikethrough ~~text~~
	text = text.replace(/~~(.+?)~~/g,
		'<span class="md-del">' + m('~~') + '$1' + m('~~') + '</span>');

	// 14. Italic *text*
	text = text.replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g,
		'$1<span class="md-em">' + m('*') + '$2' + m('*') + '</span>');

	// 15. Italic _text_
	text = text.replace(/(^|\s)_([^_\n]+)_(?=\s|$)/g,
		'$1<span class="md-em">' + m('_') + '$2' + m('_') + '</span>');

	// 16. Restore protected code spans
	for (var i = 0; i < codeSpans.length; i++) {
		text = text.replace('\uE000' + i + '\uE001', codeSpans[i]);
	}

	return text;
}

/**
 * Main highlighter: takes raw markdown text, returns styled HTML
 * that is character-for-character aligned with the original.
 */
function highlight(code) {
	var lines = code.split('\n');
	var result = [];
	var inCodeBlock = false;
	var codeBlockFence = '';
	var codeBlockLang = '';
	var codeBlockBuffer = [];
	var inKatexBlock = false;

	for (var i = 0; i < lines.length; i++) {
		var line = lines[i];
		var escaped = htmlEscape(line);

		// KaTeX block delimiters $$
		if (/^\$\$$/.test(line.trim())) {
			inKatexBlock = !inKatexBlock;
			result.push('<span class="md-katex-fence">' + escaped + '</span>');
			continue;
		}

		if (inKatexBlock) {
			result.push('<span class="md-katex-block">' + escaped + '</span>');
			continue;
		}

		// Code fences
		if (!inCodeBlock) {
			var fenceMatch = line.match(/^(`{3,})(\w*)/);
			if (fenceMatch) {
				inCodeBlock = true;
				codeBlockFence = fenceMatch[1];
				codeBlockLang = fenceMatch[2];
				result.push('<span class="md-code-fence">' + escaped + '</span>');
				codeBlockBuffer = [];
				continue;
			}
		} else {
			if (line.startsWith(codeBlockFence)) {
				// Flush buffer
				var rawBlock = codeBlockBuffer.join('\n');
				var highlightedHTML;
				if (codeBlockLang && hljsLib && hljsLib.getLanguage(codeBlockLang)) {
					try {
						// Try highlight.js v11+ API
						highlightedHTML = hljsLib.highlight(rawBlock, {language: codeBlockLang, ignoreIllegals: true}).value;
					} catch (err) {
						try {
							// Fallback to highlight.js v10 API
							highlightedHTML = hljsLib.highlight(codeBlockLang, rawBlock, true).value;
						} catch(e) {
							highlightedHTML = htmlEscape(rawBlock);
						}
					}
				} else {
					highlightedHTML = htmlEscape(rawBlock);
				}
				
				if (codeBlockBuffer.length > 0) {
					result.push('<span class="md-code-block hljs">' + highlightedHTML + '</span>');
				}
				
				inCodeBlock = false;
				result.push('<span class="md-code-fence">' + escaped + '</span>');
				continue;
			} else {
				codeBlockBuffer.push(line);
				continue;
			}
		}

		// TiddlyWiki pragma lines (\define, \procedure, etc.)
		if (/^\\[a-zA-Z]/.test(line)) {
			result.push('<span class="md-tw-pragma">' + escaped + '</span>');
			continue;
		}

		// Headers
		var headerMatch = line.match(/^(#{1,6})\s/);
		if (headerMatch) {
			var level = headerMatch[1].length;
			var markerLen = headerMatch[0].length;
			var markerText = escaped.substring(0, markerLen);
			var content = parseInline(escaped.substring(markerLen));
			result.push('<span class="md-h md-h' + level + '">' + m(markerText) + content + '</span>');
			continue;
		}



		// Horizontal rule
		if (/^(-{3,}|\*{3,}|_{3,})\s*$/.test(line)) {
			result.push('<span class="md-hr">' + escaped + '</span>');
			continue;
		}

		// Task list: - [ ] or - [x] (with optional indent)
		var taskMatch = line.match(/^(\s*[-*+]\s\[[ xX]\]\s)/);
		if (taskMatch) {
			var mLen = taskMatch[0].length;
			var content = parseInline(escaped.substring(mLen));
			result.push('<span class="md-list-marker">' + escaped.substring(0, mLen) + '</span>' + content);
			continue;
		}

		// Bullet list (with optional indent)
		var bulletMatch = line.match(/^(\s*[-*+])\s/);
		if (bulletMatch) {
			var mLen = bulletMatch[0].length;
			var content = parseInline(escaped.substring(mLen));
			result.push('<span class="md-list-marker">' + escaped.substring(0, mLen) + '</span>' + content);
			continue;
		}

		// Numbered list (with optional indent)
		var numMatch = line.match(/^(\s*\d+\.)\s/);
		if (numMatch) {
			var mLen = numMatch[0].length;
			var content = parseInline(escaped.substring(mLen));
			result.push('<span class="md-list-marker">' + escaped.substring(0, mLen) + '</span>' + content);
			continue;
		}

		// Regular line
		result.push(parseInline(escaped));
	}

	// Flush unclosed code block if necessary
	if (inCodeBlock) {
		var rawBlock = codeBlockBuffer.join('\n');
		var highlightedHTML;
		if (codeBlockLang && hljsLib && hljsLib.getLanguage(codeBlockLang)) {
			try {
				highlightedHTML = hljsLib.highlight(rawBlock, {language: codeBlockLang, ignoreIllegals: true}).value;
			} catch (err) {
				try {
					highlightedHTML = hljsLib.highlight(codeBlockLang, rawBlock, true).value;
				} catch(e) {
					highlightedHTML = htmlEscape(rawBlock);
				}
			}
		} else {
			highlightedHTML = htmlEscape(rawBlock);
		}
		if (codeBlockBuffer.length > 0) {
			result.push('<span class="md-code-block hljs">' + highlightedHTML + '</span>');
		}
	}

	return result.join('\n');
}

exports.highlight = highlight;

})();
