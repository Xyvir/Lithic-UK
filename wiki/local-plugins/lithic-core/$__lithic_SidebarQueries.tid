caption: Queries
tags: $:/tags/SideBar
title: $:/lithic/SidebarQueries

\define make-fallback() [all[tiddlers]!has[plugin-type]!prefix[$:/boot/]!prefix[$:/library/]!prefix[$:/temp/advancedsearch]!prefix[$:/temp/queries]!match[$:/lithic/startup/webdav-utils.js]!is[draft]search::literal[$(rawFilter)$]]
\define make-wildcard-fallback() [all[tiddlers]!has[plugin-type]!prefix[$:/boot/]!prefix[$:/library/]!prefix[$:/temp/advancedsearch]!prefix[$:/temp/queries]!match[$:/lithic/startup/webdav-utils.js]!is[draft]is[shadow]!sort[modified]] [all[tiddlers]!has[plugin-type]!prefix[$:/boot/]!prefix[$:/library/]!prefix[$:/temp/advancedsearch]!prefix[$:/temp/queries]!match[$:/lithic/startup/webdav-utils.js]!is[draft]!is[shadow]!sort[modified]]

\procedure handle-queries-input()
  <$let
    rawFilter={{$:/temp/queries/input}}
    fallbackFilter=<<make-fallback>>
    wildcardFilter=<<make-wildcard-fallback>>
    regexPattern="(?i)^[a-z0-9\s]+$"
    isFallback={{{ [<rawFilter>match[*]then[yes]] ~[<rawFilter>regexp<regexPattern>then[yes]else[no]] }}}
    actualFilter={{{ [<rawFilter>match[*]then<wildcardFilter>] ~[<isFallback>match[yes]then<fallbackFilter>] ~[<rawFilter>] }}}
  >
    <$action-setfield $tiddler="$:/temp/advancedsearch" text=<<actualFilter>> />
    <$action-setfield $tiddler="$:/temp/advancedsearch/input" text=<<actualFilter>> />
  </$let>
\end

\procedure cancel-search-actions()
  <$action-deletetiddler $filter="[[$:/temp/advancedsearch]] [[$:/temp/advancedsearch/input]] [[$:/temp/advancedsearch/selected-item]] [[$:/temp/queries/input]]"/>
\end

\procedure lingo(title)
  <%if [<title>match[Filter/Hint]] %>
    <$link to="$:/FilterReference">Search using filter syntax</$link>
  <%elseif [<title>match[Filter/Matches]] %>
    <$let 
      rawFilter={{$:/temp/queries/input}}
      regexPattern="(?i)^[a-z0-9\s]+$"
      isFallback={{{ [<rawFilter>match[*]then[yes]] ~[<rawFilter>regexp<regexPattern>then[yes]else[no]] }}}>
      <%if [<rawFilter>match[*]] %>
          <span class="tc-muted" style="font-style: italic; display: block; margin-bottom: 0.5em;">
              Showing all search targets
          </span>
      <%elseif [<isFallback>match[yes]] %>
          <span class="tc-muted" style="font-style: italic; display: block; margin-bottom: 0.5em;">
              String search fallback
          </span>
      <%endif%>
    </$let>
    <$transclude $tiddler={{{ [<lingo-base>addsuffix<title>] }}}>
      <$transclude $tiddler={{{ [[$:/language/]addsuffix<title>] }}}/>
    </$transclude>
  <%else%>
    <$transclude $tiddler={{{ [<lingo-base>addsuffix<title>] }}}>
      <$transclude $tiddler={{{ [[$:/language/]addsuffix<title>] }}}/>
    </$transclude>
  <%endif%>
\end

\procedure keyboard-driven-input(tiddler, storeTitle, refreshTitle, selectionStateTitle, type, tag, focus, configTiddlerFilter, firstSearchFilterField, inputAcceptActions, inputAcceptVariantActions, inputCancelActions, filterMinLength)
  <$edit-text tiddler="$:/temp/queries/input" tag="input" type="search" focus="yes" default="" inputActions=<<handle-queries-input>> />
\end

<div class="lithic-sidebar-search">
<$let lithic-sidebar-filters="dummy_ignore_me">

  {{$:/core/ui/AdvancedSearch/Filter}}

</$let>
</div>