tags: $:/tags/Stylesheet
title: $:/lithic/styles/AdvancedSearch.css
type: text/vnd.tiddlywiki

.lithic-sidebar-search .tc-advanced-search input[type="search"] {
    display: block;
    width: 100%;
    margin-bottom: 5px;
}

.lithic-sidebar-search .tc-search-results a {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lithic-flex-input {
    flex: 1 1 0;
    min-width: 0;
    width: 100%;
}

.lithic-core-search-results .tc-advanced-search-filter-buttons {
    display: none !important;
}

.lithic-core-search-results .tc-advanced-search {
    display: none !important;
}

.lithic-sidebar-search .tc-advanced-search-filter-buttons button svg {
    width: 1.2em;
    height: 1.2em;
    fill: <<colour muted-foreground>>;
}

.lithic-sidebar-search .tc-advanced-search-filter-buttons button.tc-btn-invisible svg {
    width: 1.2em;
    height: 1.2em;
    fill: <<colour muted-foreground>>;
}