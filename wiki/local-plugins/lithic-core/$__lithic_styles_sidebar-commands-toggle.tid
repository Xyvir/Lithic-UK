title: $:/lithic/styles/sidebar-commands-toggle
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki



.lithic-commands-toggle-btn {
    position: absolute;
    right: 15px;
    top: 25px; /* Adjust according to header size */
    z-index: 100;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.lithic-nut-slider {
    width: 36px;
    height: 18px;
    background-color: <<colour foreground>>; /* Dark track */
    clip-path: polygon(6px 0%, calc(100% - 6px) 0%, 100% 50%, calc(100% - 6px) 100%, 6px 100%, 0% 50%);
    position: relative;
    display: flex;
    align-items: center;
    transition: background-color 0.2s;
    box-sizing: border-box;
}

.lithic-nut-slider.active {
    background-color: <<colour dropzone-background>>; /* Lithic orange/accent color */
}

.lithic-nut {
    width: 16px;
    height: 14px;
    background-color: <<colour background>>;
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    left: 4px;
    transition: left 0.2s, transform 0.2s;
}

.lithic-nut-hole {
    display: block;
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: <<colour foreground>>; /* Dark hole matching track */
    transition: background-color 0.2s;
}

.lithic-nut-slider.active .lithic-nut {
    left: 16px;
}

.lithic-nut-slider.active .lithic-nut-hole {
    background-color: <<colour dropzone-background>>; /* Matches the active orange track */
}

.lithic-inline-edit {
    background: rgba(0,0,0,0.1);
    border: 1px solid <<colour dropzone-background>>;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    width: calc(100% - 50px);
    border-radius: 4px;
    padding: 2px 4px;
    box-sizing: border-box;
}

.lithic-settings-heading {
    font-weight: 700;
    opacity: 0.6;
    padding: 4px 6px;
    margin-top: 0.5em;
}

.lithic-settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 4px 6px;
    cursor: pointer;
    gap: 8px;
    box-sizing: border-box;
}

.lithic-settings-label {
    flex: 1;
    text-align: left;
}

.lithic-settings-hint {
    font-size: 0.75em;
    font-style: italic;
    opacity: 0.55;
    white-space: nowrap;
}

.lithic-settings-link {
    padding: 2px 6px 4px;
}

.lithic-settings-link-btn {
    font-size: 0.85em;
    opacity: 0.75;
    color: <<colour tiddler-link-foreground>>;
    padding: 0;
    cursor: pointer;
}

.lithic-settings-link-btn:hover {
    opacity: 1;
    text-decoration: underline;
}
