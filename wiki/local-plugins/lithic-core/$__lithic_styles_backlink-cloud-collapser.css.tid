/* ── Backlink Cloud Collapser ── */

/* Hide wrapper entirely when the footer has no backlink pills */
.backlink-cloud-wrapper:not(:has(.footer li)) {
  display: none;
}

/* Container: one row, so the toggle keeps a lane of its own instead of
   floating over the pills. The lane is pulled out by the width the streams
   add-node control sits at (4px column padding + 16px arrow), which is the
   button this toggle lines up under. Pulling it out here rather than
   overhanging the button keeps the row inside the tiddler frame. */
.backlink-cloud-wrapper {
  display: flex;
  align-items: flex-start;
  gap: 2px;
  margin-left: -20px;
  padding-left: 20px;
}

/* Streams only outdents its control column by 1em below 600px, so the gap
   the lane fills is already closed there. */
@media (max-width: 600px) {
  .backlink-cloud-wrapper {
    margin-left: 0;
    padding-left: 0;
  }
}

/* Pills take the rest of the row and wrap inside it, never under the toggle */
.backlink-cloud-wrapper > .footer {
  flex: 1 1 auto;
  min-width: 0;
}

/* The collapse toggle: a fixed 20px lane at the start of the row */
.backlink-cloud-collapser {
  flex: 0 0 20px;
  width: 20px;
  height: 20px;
  margin-top: 2px;
  padding: 0;
  border: none;
  background: none;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.15s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.backlink-cloud-collapser svg {
  fill: <<colour muted-foreground>>;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}

.backlink-cloud-collapsed .backlink-cloud-collapser svg {
  transform: rotate(0deg);
}

/* Always legible when the cloud IS collapsed (to indicate hidden content) */
.backlink-cloud-collapsed .backlink-cloud-collapser {
  opacity: 0.7;
}

/* Brighten on hover of the toggle or the row it sits in */
.backlink-cloud-wrapper:hover .backlink-cloud-collapser,
.backlink-cloud-collapser:hover {
  opacity: 1;
}

/* Hide the pill list when collapsed (CSS-based, keeps elements in DOM for :has check) */
.backlink-cloud-collapsed .footer {
  display: none;
}