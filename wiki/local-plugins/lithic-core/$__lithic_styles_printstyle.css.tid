tags: $:/tags/Stylesheet
title: $:/lithic/styles/printstyle.css
type: text/css

@media print {
    /* =======================================================
       1. HIDE ALL NAVIGATION AND INTERFACE ELEMENTS
       (Ensures only content is printed)
       ======================================================= */

    /* Hide breadcrumbs */
    .sq-breadcrumbs-fragment {
        display: none !important;
    }

    /* Hide the entire custom top bar */
    .nc-topbar {
        display: none !important;
    }

    /* Hide the entire custom bottom bar */
    .nc-bottombar {
        display: none !important;
    }

    /* Hide the custom left sidebar and its resizer */
    .nc-sidebar,
    .oresizer {
        display: none !important;
    }

    /* The main TiddlyWiki Sidebar and its header */
    .tc-sidebar-scrollable,
    .tc-sidebar-header {
        display: none !important;
    }

    /* HIDE THE TIDDLER TITLE BAR (including title and controls) */
    .tc-titlebar {
        display: none !important;
    }

    /* The main 'ViewToolbar' buttons (e.g., Edit, Delete, Tag, permalink) */
    .tc-tiddler-controls,
    .tc-toolbar-group,
    .tc-toolbar-item {
        display: none !important;
    }

    /* HIDE THE TIDDLER FOOTER (e.g., backlinks, filter results) */
    .footer {
        display: none !important;
    }

    /* TiddlyWiki's core style for the Edit Template buttons/footer */
    .tc-editor-footer {
        display: none !important;
    }

    /* The Control Panel button (top right) */
    .tc-more-toolbar-wrapper {
        display: none !important;
    }

    /* If you have a custom Tiddler that shows the edit state */
    .tc-edit-text-wrapper {
        display: none !important;
    }

    /* Hide the 'Add New Node' button/control from Streams plugin */
    .stream-node-control-addnew {
        display: none !important;
    }

    /* Hide the Tiddler Subtitle (Date/Time info) */
    .tc-subtitle {
        display: none !important;
    }

    /* Hide the Tiddler Tags wrapper */
    .tc-tags-wrapper {
        display: none !important;
    }

    /* Hide the 'Copy to Clipboard' button on code blocks */
    svg.tc-image-copy-clipboard {
        display: none !important;
    }

    /* Hide transient UI notifications like "Saved Wiki" */
    .tc-notification {
        display: none !important;
    }

    /* =======================================================
       2. OPTIMIZE CONTENT DISPLAY & FRAME FIXES
       (Ensures text takes up full page width and removes outlines)
       ======================================================= */

    /* Ensure the main content takes up the full width and strips shadows/borders */
    .tc-tiddler-frame {
        width: 100% !important;
        margin-left: 0 !important;
        padding: 0 !important;
        border: none !important;
        box-shadow: none !important; /* <-- This kills the shadow box at low zoom */
        background: transparent !important;
        /* Set page break to keep tiddlers from splitting awkwardly */
        page-break-inside: avoid;
    }

    /* Ensure the Story River expands to full width */
    .tc-story-river {
        width: 100% !important;
    }

    /* =======================================================
       3. GENERAL STREAM MODIFICATIONS
       ======================================================= */

    /* Remove the left indentation border from ALL stream children */
    .stream-row-children {
        border-left: none !important;
    }

    /* =======================================================
       4. TYPOGRAPHY & COLORS
       (Overrides dark mode text for printing)
       ======================================================= */

    /* Force body text to pure black for better print contrast */
    body.tc-body {
        color: #000000 !important;
    }

    /* =======================================================
       5. CODEBLOCK BORDER FIX
       (Left-only barber-pole border for code blocks in print)
       ======================================================= */

    /* Left-only border with diagonal barber-pole stripe pattern */
    pre.hljs,
    pre {
        border: none !important;
        border-left: 6px solid #000 !important;
        border-image: repeating-linear-gradient(
            -45deg,
            #999999 0px,
            #999999 3.5px,
            #ffffff 4px,
            #ffffff 7.5px,
            #999999 8px
        ) 6 !important;
        border-image-width: 0 0 0 6px !important;
        padding: 10px !important;
        padding-left: 14px !important;
        background-color: #fcfcfc !important;
    }

    /* Strip the redundant border and padding from the inner code element */
    pre code.hljs,
    pre code {
        border: none !important;
        padding: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
    }

    /* =======================================================
       6. INTERNAL LINK FORMATTING
       (Forces internal TiddlyWiki links to black text)
       ======================================================= */

    a.tc-tiddlylink:not(.tc-tiddlylink-external) {
        color: #000000 !important;
        text-decoration: none !important;
    }

    /* =======================================================
       7. DOUBLE HR AS PAGE BREAK
       (Turns double <hr> into a hard page break; hides the visible bars)
       ======================================================= */

    hr:has(+ hr) {
        display: none !important;
    }

    hr + hr {
        border: none !important;
        margin: 0 !important;
        height: 0 !important;
        page-break-after: always !important;
        break-after: page !important;
    }

    /* =======================================================
       8. HIDE WHITEBOARD UI ELEMENTS
       (Ensures whiteboard content prints without menus)
       ======================================================= */

    /* Hide TLDraw Left Menu Panel and Icon */
    #TD-MenuPanel,
    #TD-MenuIcon,
    #TD-Page {
        display: none !important;
    }

    /* Hide TLDraw right-side UI (Zoom, Read Only indicator) */
    .c-bUEyht-jvfJsl-side-right,
    #TD-Zoom {
        display: none !important;
    }

    /* Hide TLDraw helper buttons (e.g. Center/Focus) */
    .c-chTrj {
        display: none !important;
    }

    /* =======================================================
       9. CENTER IMAGES
       (Centers images and image containers instead of left-aligning)
       ======================================================= */

    /* Make all images block-level and auto-margin centered.
       display:block + margin:auto centers a block element within its
       parent regardless of the parent's text-align. */
    .tc-tiddler-body img,
    .markdown img {
        display: block !important;
        margin-left: auto !important;
        margin-right: auto !important;
    }

    /* Center only dedicated image wrapper elements, not all paragraphs */
    .tc-tiddler-body .tc-image-wrapper,
    .tc-tiddler-body [class*="image-container"] {
        text-align: center !important;
    }

    /* =======================================================
       10. AUTOTABLE HIDE CONTROLS
       (Hides the drag handle column and the 'Add Row' final row)
       ======================================================= */

    table:has(.lithic-row-droppable) th:last-child,
    table:has(.lithic-row-droppable) td:last-child,
    table:has(.lithic-row-droppable) tbody tr:last-child {
        display: none !important;
    }

    /* =======================================================
       11. PRINT SCALING
       ======================================================= */

    /* Bake in 75% zoom scaling for Chrome */
    html {
        zoom: 75% !important;
    }

    /* Leverage browser's native margin boxes for page numbering */
    @page {
        margin-bottom: 2.2cm; /* Moved up */
        margin-right: 2.2cm;  /* Moved left */
        @bottom-right {
            content: counter(page);
        }
    }
}