title: $:/lithic/ui/SideBar/Pyramid
tags: $:/tags/SideBar $:/tags/Macro
caption: Pyramid
description: Displays a hierarchical pyramid of the active stream node

\define traverse(node, parentId, depth)
\whitespace trim
<$let dq='"' quot="#quot;" lcb="{" rcb="}" lp="(" rp=")" nbsp="&nbsp;&nbsp;">
<$list filter="[<__depth__>compare:number:gt[0]]" variable="ignore">
    <$list filter="[<__node__>get[stream-list]enlist-input[]]" variable="childNode" counter="nodeIndex">
        <$set name="currentId" value={{{ [<__parentId__>addsuffix[_]addsuffix<nodeIndex>] }}}>
        <$set name="nodeClass" value={{{ [<childNode>match<activeNode>then[activeStyle]else[childStyle]] }}}>
        <$set name="safeText" value={{{ [<childNode>get[text]else<childNode>splitregexp[\r?\n]first[]search-replace::regexp[^#{1,6} *],[]search-replace:g<dq>,<quot>search-replace:g<lcb>,<lp>search-replace:g<rcb>,<rp>addsuffix<nbsp>] }}}>
<$text text=<<nl>>/><<__parentId__>> <$text text="---" /> <<currentId>>["<<safeText>>"]:::<<nodeClass>>
            <$macrocall $name="traverse" node=<<childNode>> parentId=<<currentId>> depth={{{ [<__depth__>subtract[1]] }}} />
        </$set>
        </$set>
        </$set>
    </$list>
</$list>
</$let>
\end

\define build-pyramid-data(rootNode)
\whitespace trim
<$let nl={{{ [charcode[10]] }}} dq='"' quot="#quot;" lcb="{" rcb="}" lp="(" rp=")" nbsp="&nbsp;&nbsp;">
<$set name="parentClass" value={{{ [<__rootNode__>match<activeNode>then[activeStyle]else[parentStyle]] }}}>
<$set name="safeParentText" value={{{ [<__rootNode__>get[text]else<__rootNode__>splitregexp[\r?\n]first[]search-replace::regexp[^#{1,6} *],[]search-replace:g<dq>,<quot>search-replace:g<lcb>,<lp>search-replace:g<rcb>,<rp>addsuffix<nbsp>] }}}>
graph TD
<$text text=<<nl>>/><$text text=<<nl>>/>Parent["<<safeParentText>>"]:::<<parentClass>>
<$macrocall $name="traverse" node=<<__rootNode__>> parentId="Parent" depth="4" />
</$set>
</$set>
</$let>
\end

\define pyramid(tiddler)
<$set name="targetNode" value={{{ [<__tiddler__>!is[blank]else<currentTiddler>] }}}>
<$set name="activeNode" value={{{ [prefix[$:/state/sq/streams/current-edit-tiddler]get[text]first[]] }}}>
    <$list filter="[<targetNode>has[stream-list]]" emptyMessage="*No child streams to display for this node.*">
        <$wikify name="pyramidData" text="<$macrocall $name='build-pyramid-data' rootNode=<<targetNode>> />">
            <$let nl={{{ [charcode[10]] }}} fullChart={{{ [<pyramidData>addsuffix<nl>addsuffix[linkStyle default stroke:#d3d3d3,stroke-width:2px;]addsuffix<nl>addsuffix[classDef parentStyle fill:#444,stroke:#fff,stroke-width:2px,color:#fff,font-weight:normal;]addsuffix<nl>addsuffix[classDef childStyle fill:#666,stroke:#ccc,stroke-width:1px,color:#fff,font-weight:normal;]addsuffix<nl>addsuffix[classDef activeStyle fill:#aaa,stroke:#fff,stroke-width:2px,color:#111,font-weight:bold;]] }}}>
                <$mermaid text=<<fullChart>> />
                <div style="display:flex; justify-content:flex-end; margin-top:4px;">
                   <$button message="tm-copy-to-clipboard" param=<<pyramidData>> tooltip="Copy mermaid code" class="tc-btn-invisible tc-btn-mini tc-tiddlylink">
                      copy
                   </$button>
                </div>
            </$let>
        </$wikify>
    </$list>
</$set>
</$set>
\end

<$tiddler tiddler={{{ [list[$:/StoryList]first[]] }}}>
    <$macrocall $name="pyramid" tiddler=<<currentTiddler>> />
</$tiddler>