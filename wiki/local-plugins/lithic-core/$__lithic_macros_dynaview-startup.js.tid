/*\
title: $:/lithic/macros/dynaview-startup.js
type: application/javascript
module-type: macro

Macro to read Dynaview's saved scroll position tiddler from localStorage.
\*/
(function(){
"use strict";

exports.name = "dynaview-startup-tiddler";
exports.params = [];

exports.run = function() {
    if(typeof window !== "undefined" && window.localStorage) {
        try {
            var key = "tw5-dynaview-scroll-position#" + window.location.pathname;
            var data = window.localStorage.getItem(key);
            console.log("dynaview-startup-tiddler JS macro running! Key:", key, "Data:", data);
            if(data) {
                var json = JSON.parse(data);
                if(json && json.title) {
                    console.log("dynaview-startup-tiddler returning:", json.title);
                    return json.title;
                }
            }
        } catch(e) {
            console.error("dynaview-startup-tiddler error:", e);
        }
    } else {
        console.log("dynaview-startup-tiddler: window or localStorage not available");
    }
    return "";
};
})();
