/* Center the TiddlyWiki notifications at the top of the window */
/* TW's core notifier toggles .tc-notification-highlight to trigger fade in/out */
.tc-notification {
    right: 0 !important;
    left: 0 !important;
    margin: 0 auto !important;
    width: max-content !important;
    max-width: 60vw !important;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
}

.tc-notification.tc-notification-highlight {
    opacity: 1;
}