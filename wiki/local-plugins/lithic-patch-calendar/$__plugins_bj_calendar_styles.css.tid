title: $:/plugins/bj/calendar/styles.css
type: text/vnd.tiddlywiki
tags: $:/tags/Stylesheet

/* Fallback style for dates without journal entries */
.calendar-date-fallback a.tc-tiddlylink {
    color: <<colour foreground>>;
    font-weight: normal;
    font-style: normal;
    text-decoration: none;
}

.calendar-date-fallback a.tc-tiddlylink:hover {
    color: <<colour tiddler-link-foreground>>;
    text-decoration: underline;
}

/* Week column styles - hide gridlines */
.calendar-table tr > th:first-child,
.calendar-table tr > td:first-child {
    border: none !important;
    background: transparent !important;
    text-align: right;
    padding-right: 8px;
    font-weight: bold;
    color: <<colour muted-foreground>>;
}

/* Adjust heading specific styles */
.calendar-table tr:first-child th {
    /* Make sure the month title row doesn't have its borders removed if it is spanning across all columns */
    border: 1px solid <<colour table-border>> !important;
    background: <<colour table-header-background>> !important;
    text-align: center;
}

/* Weekview specific styles */
.lithic-weekview-today {
    border-color: <<colour primary>>;
    box-shadow: 0 0 5px <<colour primary>>;
}

.lithic-weekview-header {
    font-weight: bold;
    text-align: center;
    padding: 5px;
    border-bottom: 1px solid <<colour table-border>>;
    background: <<colour table-header-background>>;
}

.lithic-weekview-items {
    padding: 2px 4px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 0.7em;
    line-height: 1.3;
}

/* Remove default margins/padding from lists, paragraphs, and markdown divs to prevent excessive whitespace */
.lithic-weekview-items ul,
.lithic-weekview-items ol,
.lithic-weekview-items li,
.lithic-weekview-items p,
.lithic-weekview-items .markdown {
    margin: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
}

/* Hide empty paragraph elements that are sometimes auto-generated by the TW parser */
.lithic-weekview-items p:empty {
    display: none !important;
}

/* Ensure bullet points have a small inset but don't take up too much horizontal space */
.lithic-weekview-items ul,
.lithic-weekview-items ol {
    padding-left: 14px !important;
}

/* Override flexbox for checkboxes inside weekview so wrapped text flows under the checkbox instead of indenting */
.lithic-weekview-items .lithic-checkbox {
    display: block !important;
}
.lithic-weekview-items .lithic-checkbox > div {
    display: inline !important;
    margin-right: 3px !important;
}

/* Glow effect for the 'now' button in the navbar when active */
.lithic-calendar-now-active {
    color: <<colour code-foreground>> !important;
    font-weight: bold;
    text-shadow: 0 0 6px <<colour code-background>>;
}