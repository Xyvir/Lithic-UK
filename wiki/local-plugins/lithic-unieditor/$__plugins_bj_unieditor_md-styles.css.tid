tags: $:/tags/Stylesheet
type: text/css

/* =============================================
   Styled Markdown + Wikitext Highlighting
   for UniEditor canvas overlay.
   Colours come from the lithic contrast core
   (--lithic-c-*) so every role is WCAG-checked
   against the live palette -- no more muddy
   borrowed backgrounds on dark palettes.
   ============================================= */

/* --- Syntax markers (##, **, ~~, macros, etc.) --- */
.unieditor .md-marker {
	opacity: 0.35;
}

/* --- Headers --- */
/* Fake bold: -webkit-text-stroke thickens glyphs without changing their
   advance widths, so the canvas wraps exactly like the invisible textarea.
   Real font-weight: bold can use a wider bold face (e.g. proportional or
   fallback fonts) and shift wrap points, desyncing the caret from the
   visible text. */
.unieditor .md-h {
	-webkit-text-stroke: 0.5px currentColor;
}
.unieditor .md-h1,
.unieditor .md-h2 { color: var(--lithic-c-code-fg); }
.unieditor .md-h3,
.unieditor .md-h4,
.unieditor .md-h5,
.unieditor .md-h6 { color: var(--lithic-c-code-accent); }

/* --- Bold --- */
.unieditor .md-strong {
	-webkit-text-stroke: 0.5px currentColor;
	color: var(--lithic-c-code-fg);
}

/* --- Italic --- */
/* Note: kept as real italic -- italic faces of the monospace editor font keep
   the same advance widths as regular, so they do not shift wrap points. */
.unieditor .md-em {
	font-style: italic;
	color: var(--lithic-c-code-accent);
}

/* --- Strikethrough --- */
.unieditor .md-del {
	text-decoration: line-through;
	color: var(--lithic-c-code-warn);
}

/* --- Inline code --- */
.unieditor .md-code {
	background: rgba(var(--lithic-c-code-fg-rgb, 128, 128, 128), 0.15);
	border-radius: 2px;
	color: var(--lithic-c-code-ref);
}

/* --- Code fences & blocks --- */
.unieditor .md-code-fence {
	color: var(--lithic-c-code-ref);
}
.unieditor .md-code-block {
	background: rgba(var(--lithic-c-code-fg-rgb, 128, 128, 128), 0.08);
	color: var(--lithic-c-code-ref);
}

/* --- Markdown links --- */
.unieditor .md-link {
	text-decoration: underline;
	color: var(--lithic-c-code-ref);
}
.unieditor .md-url {
	opacity: 0.5;
}

/* --- Images --- */
.unieditor .md-image {
	color: var(--lithic-c-code-warn);
}

/* --- Blockquotes --- */
.unieditor .md-blockquote {
	color: var(--lithic-c-code-ref);
	font-style: italic;
}

/* --- List markers --- */
.unieditor .md-list-marker {
	color: var(--lithic-c-code-accent);
}

/* --- Horizontal rules --- */
.unieditor .md-hr {
	color: var(--lithic-c-code-ref);
	opacity: 0.6;
}

/* =============================================
   TiddlyWiki Wikitext Extensions
   ============================================= */

/* --- Wiki links [[...]] --- */
.unieditor .md-tw-link {
	text-decoration: underline;
	color: var(--lithic-c-code-accent);
}

/* --- #Hashtag links --- */
.unieditor .md-tw-hashtag {
	color: var(--lithic-c-code-accent);
}

/* --- Macro calls --- */
.unieditor .md-tw-macro {
	color: var(--lithic-c-code-warn);
}

/* --- Embeds and filtered transclusions --- */
.unieditor .md-tw-embed {
	color: var(--lithic-c-code-accent);
}

/* --- KaTeX $...$ and $$...$$ --- */
.unieditor .md-katex,
.unieditor .md-katex-fence,
.unieditor .md-katex-block {
	color: var(--lithic-c-code-accent);
}

/* --- Pragma lines (\define, \procedure, etc.) --- */
.unieditor .md-tw-pragma {
	color: var(--lithic-c-code-accent);
	-webkit-text-stroke: 0.5px currentColor;
}